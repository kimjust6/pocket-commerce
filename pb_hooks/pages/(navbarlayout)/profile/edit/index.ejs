<div class="min-h-screen bg-base-100 border-b-8 border-neutral relative overflow-hidden pb-20">
    <!-- Stark Grid Background -->
    <div class="absolute inset-0 pointer-events-none opacity-10"
        style="background-image: radial-gradient(currentColor 2px, transparent 2px); background-size: 30px 30px;">
    </div>

    <div class="container relative z-10 mx-auto px-4 py-12">
        <div class="bg-base-100 border-4 border-neutral shadow-[8px_8px_0_0_rgba(0,0,0,1)] max-w-2xl mx-auto p-6 md:p-8">
            <!-- Header -->
            <div class="flex items-center gap-4 mb-6">
                <div class="flex items-center justify-center w-12 h-12 bg-secondary border-4 border-neutral shadow-[3px_3px_0_0_rgba(0,0,0,1)] text-secondary-content transform -rotate-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20"
                        fill="currentColor">
                        <path
                            d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" />
                    </svg>
                </div>
                <div>
                    <h2 class="text-3xl font-black uppercase tracking-tight text-base-content bg-base-200 border-2 border-neutral px-3 py-0.5 inline-block">
                        Edit Profile
                    </h2>
                    <p class="text-base-content/60 text-sm font-bold mt-1">Update your personal information</p>
                </div>
            </div>

            <hr class="border-t-4 border-neutral mb-8">

            <form method="POST" enctype="multipart/form-data" class="space-y-6">
                <!-- Avatar Section -->
                <div class="form-control w-full">
                    <div class="flex flex-col items-center gap-4">
                        <div class="avatar placeholder cursor-pointer group relative"
                            onclick="document.getElementById('avatar-input').click()">
                            <div class="bg-base-200 border-4 border-neutral w-28 h-28 group-hover:opacity-80 transition-all duration-300 overflow-hidden relative shadow-[4px_4px_0_0_rgba(0,0,0,1)]">
                                <% if (data.profile.getString('avatar')) { %>
                                    <img id="avatar-preview"
                                        src="<%= '/api/files/' + data.profile.collection().id + '/' + data.profile.id + '/' + data.profile.getString('avatar') %>"
                                        alt="Avatar" class="w-full h-full object-cover" />
                                <% } else { %>
                                    <div id="avatar-placeholder"
                                        class="w-full h-full flex items-center justify-center bg-gradient-to-br from-primary via-secondary to-accent text-primary-content text-3xl font-black">
                                        <%= data.profile.email().slice(0, 1).toUpperCase() %>
                                    </div>
                                    <img id="avatar-preview" class="hidden w-full h-full object-cover" />
                                <% } %>

                                <!-- Hover Overlay -->
                                <div
                                    class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                                        class="w-8 h-8 text-white">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" />
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                            d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                        <span class="text-sm font-bold text-base-content/50">Click avatar to change</span>
                    </div>

                    <input id="avatar-input" type="file" name="avatar" class="hidden" accept="image/*"
                        onchange="previewAvatar(this)" />
                </div>

                <script src="/js/profile-edit.js"></script>

                <!-- Email (disabled) -->
                <div class="form-control w-full space-y-1.5">
                    <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Email Address</label>
                    <input type="text" value="<%= data.profile.email() %>"
                        class="input border-4 border-neutral w-full bg-base-200 cursor-not-allowed font-bold rounded-none" disabled />
                </div>

                <!-- Name -->
                <div class="form-control w-full space-y-1.5">
                    <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Display Name</label>
                    <input type="text" name="name" value="<%= data.profile.getString('name') || '' %>"
                        placeholder="Enter your display name"
                        class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm" />
                </div>

                <!-- Handle -->
                <div class="form-control w-full space-y-1.5">
                    <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Handle</label>
                    <input type="text" name="shortHand" value="<%= data.profile.getString('shortHand') || '' %>"
                        placeholder="e.g. productbuff"
                        class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm" />
                </div>

                <!-- Bio -->
                <div class="form-control w-full space-y-1.5">
                    <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Bio</label>
                    <textarea name="bio"
                        class="textarea border-4 border-neutral w-full h-24 bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm"
                        placeholder="Tell us about yourself..."><%= data.profile.getString('bio') || '' %></textarea>
                </div>

                <!-- Created Date (disabled) -->
                <div class="form-control w-full space-y-1.5">
                    <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Member Since</label>
                    <input type="text" value="<%= (() => {
                        const d = new Date(data.profile.getString('created'));
                        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                        return `${months[d.getMonth()]} ${d.getDate()}, ${d.getFullYear()}`;
                    })() %>" class="input border-4 border-neutral w-full bg-base-200 cursor-not-allowed font-bold rounded-none text-sm" disabled />
                </div>

                <!-- Actions -->
                <div class="flex gap-4 pt-6 border-t-2 border-neutral border-dashed mt-8">
                    <a href="/profile" class="btn bg-base-200 border-4 border-neutral shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[1px] hover:translate-x-[1px] hover:shadow-[3px_3px_0_0_rgba(0,0,0,1)] active:translate-y-[2px] active:translate-x-[2px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] rounded-none font-black text-sm uppercase py-3 h-auto text-neutral flex-1 text-center justify-center">Cancel</a>
                    <button type="submit"
                        class="btn btn-secondary border-4 border-neutral shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[1px] hover:translate-x-[1px] hover:shadow-[3px_3px_0_0_rgba(0,0,0,1)] active:translate-y-[2px] active:translate-x-[2px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] rounded-none font-black text-sm uppercase py-3 h-auto flex-1 justify-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20"
                            fill="currentColor">
                            <path fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd" />
                        </svg>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>