<div class="min-h-screen bg-base-100 py-12">
    <div class="container mx-auto px-4 md:px-8 max-w-4xl">
        <!-- Profile Card -->
        <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-8 shadow-sm flex flex-col md:flex-row gap-8 items-center md:items-start">
            <!-- Left Column: Avatar Frame -->
            <div class="flex-shrink-0">
                <div class="w-32 h-32 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-base-200 shadow-sm relative">
                    <% if (data.profile.getString('avatar')) { %>
                        <img src="<%= '/api/files/' + data.profile.collection().id + '/' + data.profile.id + '/' + data.profile.getString('avatar') %>"
                             alt="Avatar" class="w-full h-full object-cover" />
                    <% } else { %>
                        <div class="w-full h-full bg-primary text-primary-content flex items-center justify-center text-4xl font-extrabold">
                            <%= data.profile.email().slice(0, 1).toUpperCase() %>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Right Column: Info -->
            <div class="flex-grow space-y-4 text-center md:text-left">
                <div>
                    <div class="flex flex-col md:flex-row items-center md:items-baseline gap-3">
                        <h1 class="text-2xl md:text-3xl font-extrabold text-base-content tracking-tight">
                            <%= data.profile.getString('name') || data.profile.email().split('@')[0] %>
                        </h1>
                        <% if (data.profile.getString('shortHand')) { %>
                            <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-semibold text-xs">
                                @<%= data.profile.getString('shortHand') %>
                            </span>
                        <% } %>
                    </div>
                    <p class="text-sm text-base-content/60 font-medium mt-0.5">
                        <%= data.profile.email() %>
                    </p>
                </div>

                <% if (data.profile.getString('bio')) { %>
                    <div class="bg-base-200/50 rounded-2xl p-4 text-xs text-base-content/80 italic leading-relaxed">
                        "<%= data.profile.getString('bio') %>"
                    </div>
                <% } %>

                <div class="text-xs text-base-content/50 font-medium">
                    Member since <%= data.formatDateTime(data.profile.getString('created')) %>
                </div>

                <!-- Quick Actions -->
                <div class="flex flex-wrap gap-3 justify-center md:justify-start pt-2">
                    <a href="/profile/edit" class="btn btn-primary btn-sm rounded-xl font-semibold px-5">
                       Edit Profile
                    </a>
                    <a href="/account/addresses" class="btn btn-outline btn-sm rounded-xl font-semibold px-5 border-slate-300 dark:border-slate-700">
                       Saved Addresses
                    </a>
                    <a href="/shop" class="btn btn-ghost btn-sm rounded-xl font-semibold px-5 text-base-content/70">
                       Browse Catalog
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>