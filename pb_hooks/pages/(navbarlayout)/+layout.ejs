<!doctype html>
<%
    const initialCartItemsList = (locals.data && Array.isArray(locals.data.cartItems)) ? locals.data.cartItems : [];
    const initialCartCount = (locals.data && typeof locals.data.totalItems === 'number') ? locals.data.totalItems : 0;
    const initialCartTotal = (locals.data && typeof locals.data.totalPrice === 'number') ? locals.data.totalPrice : 0;
    let initialCartBase64 = '';
    try {
        initialCartBase64 = Buffer.from(JSON.stringify(initialCartItemsList)).toString('base64');
    } catch (_) {
        initialCartBase64 = '';
    }
%>
<html lang="en" data-theme="light" x-data="shell(<%= initialCartCount %>, <%= initialCartTotal %>, '<%= initialCartBase64 %>')">

<head>
    <%- include('head') %> <%- include('theme-init') %> <%- include('alpine-setup') %> <%- include('shell-init') %> <%-
                        include('custom-styles') %>
</head>

<body class="bg-transparent text-zinc-900 dark:text-zinc-100">
    <div class="relative min-h-screen flex flex-col">
        <div x-on:click.outside="navOpen = false">
            <%- include('header') %> <%- include('mobile-menu') %>
        </div>

        <main class="relative flex-grow"><%- slot %></main>

        <% if (!locals.data.list) { %>
            <%- include('footer') %>
                <% } %>
    </div>
    <%- include('side-cart') %>
    <%- include('../_private/link-fixer') %>
</body>

</html>