<!doctype html>
<%
    const initialCartItemsList = (locals.data && Array.isArray(locals.data.cartItems)) ? locals.data.cartItems : [];
    const initialCartItemsJson = JSON.stringify(initialCartItemsList);
%>
<html lang="en" data-theme="light" x-data="shell(<%= (locals.data && typeof locals.data.totalItems === 'number') ? locals.data.totalItems : 0 %>, <%= (locals.data && typeof locals.data.totalPrice === 'number') ? locals.data.totalPrice : 0 %>, <%- JSON.stringify(initialCartItemsJson) %>)">

<head>
    <%- include('head') %> <%- include('theme-init') %> <%- include('alpine-setup') %> <%- include('shell-init') %> <%-
                        include('custom-styles') %>
</head>

<body class="bg-transparent text-zinc-900 dark:text-zinc-100">
    <div class="relative min-h-screen flex flex-col">
        <div x-on:click.outside="navOpen = false">
            <%- include('header') %> <%- include('mobile-menu') %>
        </div>

        <main class="relative flex-grow transition-all duration-200"
            :style="{ 'padding-top': headerVisible ? '3.3rem' : '0' }"><%- slot %></main>

        <% if (!locals.data.list) { %>
            <%- include('footer') %>
                <% } %>
    </div>
    <%- include('side-cart') %>
    <%- include('../_private/link-fixer') %>
</body>

</html>