<!-- Hero Section Neo-Brutalist -->
<div class="min-h-screen border-b-8 border-neutral bg-base-200 relative overflow-hidden" id="home">
    <!-- Stark Grid Background -->
    <div class="absolute inset-0 pointer-events-none opacity-20"
        style="background-image: radial-gradient(currentColor 2px, transparent 2px); background-size: 30px 30px;">
    </div>

    <div class="container mx-auto px-4 py-20 lg:py-32 relative z-10">
        <div class="max-w-5xl mx-auto">
            <h1 class="text-6xl md:text-8xl lg:text-9xl font-black uppercase tracking-tighter leading-none mb-8">
                <span
                    class="inline-block bg-primary border-4 border-neutral px-4 py-2 mb-4 transform -rotate-2 text-primary-content">Discover</span>
                <br>
                <span
                    class="inline-block bg-base-100 border-4 border-neutral px-4 py-2 text-base-content">Hilarious</span>
                <br>
                <span
                    class="inline-block bg-secondary border-4 border-neutral px-4 py-2 transform rotate-1 text-secondary-content">Greetings.</span>
            </h1>

            <p
                class="text-xl md:text-3xl font-bold max-w-2xl bg-warning border-4 border-neutral p-6 mb-12 shadow-[8px_8px_0_0_rgba(0,0,0,1)] text-warning-content">
                Shop hilariously punny birthday cards and unique greetings for every occasion.
            </p>

            <div class="flex flex-wrap gap-6">
                <a href="/shop"
                    class="btn btn-primary btn-lg border-4 border-neutral shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] rounded-none text-xl font-bold h-auto py-4 px-8 text-primary-content">
                    Shop Now
                </a>
                <a href="#features"
                    class="btn bg-base-100 hover:bg-base-200 text-base-content btn-lg border-4 border-neutral shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] rounded-none text-xl font-bold h-auto py-4 px-8">
                    View Collections
                </a>
            </div>
        </div>
    </div>
</div>

<!-- New Arrivals Section -->
<section class="bg-accent border-b-8 border-neutral px-4 py-20 relative overflow-hidden">
    <!-- Polka dot pattern on accent -->
    <div class="absolute inset-0 pointer-events-none opacity-10"
        style="background-image: radial-gradient(currentColor 4px, transparent 4px); background-size: 40px 40px;">
    </div>
    <div class="container mx-auto max-w-6xl relative z-10">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-6">
            <h2
                class="text-5xl md:text-7xl font-black uppercase tracking-tighter bg-base-100 text-base-content inline-block border-4 border-neutral px-6 py-2 shadow-[8px_8px_0_0_rgba(0,0,0,1)] transform -rotate-1">
                New Arrivals
            </h2>
            <a href="/shop"
                class="btn bg-base-100 hover:bg-primary text-base-content hover:text-primary-content border-4 border-neutral shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[1px] hover:translate-x-[1px] hover:shadow-[3px_3px_0_0_rgba(0,0,0,1)] active:translate-y-[2px] active:translate-x-[2px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] rounded-none font-bold">
                View All Products →
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
            <% if (data.recentCards && data.recentCards.length> 0) { %>
                <% data.recentCards.forEach(card=> { %>
                    <a href="/shop/<%= card.slug %>/<%= card.id %>" class="block group h-full">
                        <div
                            class="bg-base-100 border-4 border-neutral shadow-[6px_6px_0_0_rgba(0,0,0,1)] transition-all duration-200 group-hover:translate-y-1 group-hover:translate-x-1 group-hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] h-full flex flex-col"
                            x-data="{ showSecond: false }"
                            @mouseenter="showSecond = true"
                            @mouseleave="showSecond = false">
                            <div class="aspect-[2/3] border-b-4 border-neutral bg-base-200 relative overflow-hidden">
                                <% if (card.images && card.images.length > 1) { %>
                                    <img src="<%= card.images[0] %>" alt="<%= card.title %>" 
                                         class="w-full h-full object-cover transition-opacity duration-300 absolute inset-0"
                                         :class="showSecond ? 'opacity-0' : 'opacity-100'">
                                    <img src="<%= card.images[1] %>" alt="<%= card.title %>" 
                                         class="w-full h-full object-cover transition-opacity duration-300 absolute inset-0 opacity-0"
                                         :class="showSecond ? 'opacity-100' : 'opacity-0'">
                                <% } else { %>
                                    <img src="<%= card.image %>" alt="<%= card.title %>" class="w-full h-full object-cover">
                                <% } %>
                            </div>
                            <div
                                class="p-3 flex-1 flex flex-col justify-between bg-primary group-hover:bg-warning transition-colors">
                                <h3 class="font-bold text-sm leading-tight mb-2 text-primary-content">
                                    <%= card.title %>
                                </h3>
                                <div
                                    class="bg-neutral text-neutral-content font-black px-2 py-1 inline-block self-start text-sm border-2 border-neutral">
                                    <%= card.price %>
                                </div>
                            </div>
                        </div>
                    </a>
                    <% }); %>
                        <% } else { %>
                            <div
                                class="col-span-full border-4 border-neutral bg-base-100 p-8 text-center text-xl font-bold shadow-[8px_8px_0_0_rgba(0,0,0,1)] text-base-content">
                                No products available yet.
                            </div>
                            <% } %>
        </div>
    </div>
</section>

<!-- Curated Collections & Trending Now Section -->
<section class="bg-base-200 border-b-8 border-neutral px-4 py-20">
    <div class="container mx-auto max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
            <!-- Collections -->
            <div>
                <h2
                    class="text-4xl md:text-5xl font-black uppercase mb-8 border-b-4 border-neutral pb-2 inline-block text-base-content">
                    Collections</h2>
                <div class="space-y-6">
                    <% if (data.topCollections && data.topCollections.length> 0) { %>
                        <% const colColors=['bg-primary text-primary-content', 'bg-secondary text-secondary-content'
                            , 'bg-warning text-warning-content' , 'bg-info text-info-content' ] %>
                            <% data.topCollections.forEach((collection, index)=> { %>
                                <a href="/collections/<%= collection.id %>" class="block group">
                                    <div
                                        class="<%= colColors[index % 4] %> border-4 border-neutral shadow-[8px_8px_0_0_rgba(0,0,0,1)] transition-all duration-200 group-hover:translate-y-2 group-hover:translate-x-2 group-hover:shadow-[0px_0px_0_0_rgba(0,0,0,1)] p-4 flex items-center gap-6">
                                        <div
                                            class="w-20 h-20 border-4 border-neutral bg-base-100 flex-shrink-0 overflow-hidden transform -rotate-3 group-hover:rotate-0 transition-transform">
                                            <% if (collection.images && collection.images.length> 0) { %>
                                                <img src="<%= collection.images[0] %>"
                                                    class="w-full h-full object-cover">
                                                <% } else { %>
                                                    <div class="w-full h-full bg-base-200"></div>
                                                    <% } %>
                                        </div>
                                        <div class="flex-1">
                                            <h3 class="text-2xl font-black uppercase mb-1">
                                                <%= collection.title %>
                                            </h3>
                                            <p class="font-medium mb-2 leading-snug">
                                                <%= collection.description %>
                                            </p>
                                            <span
                                                class="bg-neutral text-neutral-content px-2 py-1 text-xs font-bold uppercase border-2 border-neutral">
                                                <%= collection.count %> Items
                                            </span>
                                        </div>
                                    </div>
                                </a>
                                <% }); %>
                                    <% } else { %>
                                        <div
                                            class="border-4 border-neutral bg-base-100 p-8 text-center text-xl font-bold shadow-[8px_8px_0_0_rgba(0,0,0,1)] text-base-content">
                                            No collections yet.
                                        </div>
                                        <% } %>
                </div>
            </div>

            <!-- Reviews -->
            <div>
                <h2
                    class="text-4xl md:text-5xl font-black uppercase mb-8 border-b-4 border-neutral pb-2 inline-block text-base-content">
                    Happy Customers</h2>
                <div class="space-y-6">
                    <% if (data.recentReviews && data.recentReviews.length> 0) { %>
                        <% data.recentReviews.forEach((review, index)=> { %>
                            <div
                                class="bg-base-100 border-4 border-neutral shadow-[8px_8px_0_0_rgba(0,0,0,1)] p-6 relative">
                                <!-- Pin decoration -->
                                <div
                                    class="absolute -top-3 -left-3 w-6 h-6 rounded-none bg-accent border-4 border-neutral">
                                </div>

                                <div class="flex items-start gap-4 text-base-content">
                                    <div
                                        class="w-12 h-12 border-4 border-neutral bg-base-200 flex-shrink-0 flex items-center justify-center font-black text-xl text-base-content">
                                        <%= review.userInitials || 'U' %>
                                    </div>
                                    <div>
                                        <div class="font-black text-lg text-base-content uppercase">
                                            <%= review.userName %>
                                        </div>
                                        <div
                                            class="text-sm font-bold bg-warning inline-block px-2 py-1 border-2 border-neutral mb-3 text-warning-content">
                                            on <%= review.cardTitle %>
                                        </div>
                                        <% if (review.review) { %>
                                            <p
                                                class="text-base-content font-medium italic border-l-4 border-primary pl-3 bg-base-200 p-2">
                                                "<%= review.review %>"</p>
                                            <% } %>
                                                <% if (review.rating) { %>
                                                    <div class="flex gap-1 mt-3">
                                                        <% for(let i=0; i<Math.floor(review.rating); i++) { %>
                                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                                class="h-5 w-5 text-base-content fill-current"
                                                                viewBox="0 0 20 20">
                                                                <path
                                                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                            </svg>
                                                            <% } %>
                                                    </div>
                                                    <% } %>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                                <% } else { %>
                                    <div
                                        class="border-4 border-neutral bg-base-100 p-8 text-center text-xl font-bold shadow-[8px_8px_0_0_rgba(0,0,0,1)] text-base-content">
                                        No recent reviews yet.
                                    </div>
                                    <% } %>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section id="features" class="bg-secondary border-b-8 border-neutral px-4 py-24 relative">
    <div class="container mx-auto max-w-6xl relative z-10">
        <h2
            class="text-5xl md:text-7xl font-black uppercase text-center mb-16 bg-base-100 text-base-content inline-block border-4 border-neutral px-8 py-4 shadow-[10px_10px_0_0_rgba(0,0,0,1)] transform rotate-1 mx-auto flex justify-center w-max">
            Why Us?
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            <% const features=[ { title: 'Premium Packaging' ,
                desc: 'Every order is securely packaged to ensure your cards arrive in pristine condition.' ,
                color: 'bg-primary text-primary-content' }, { title: 'Fast Shipping' ,
                desc: 'Get your cards faster with our expedited worldwide shipping options.' ,
                color: 'bg-base-100 text-base-content' }, { title: 'Locally Printed' ,
                desc: 'All our cards are printed locally on high-quality, sustainable paper.' ,
                color: 'bg-warning text-warning-content' }, { title: 'Secure Checkout' ,
                desc: 'Your payment information is always encrypted and protected.' , color: 'bg-info text-info-content'
                }, { title: 'Rewards Program' , desc: 'Earn points with every purchase and unlock exclusive discounts.'
                , color: 'bg-success text-success-content' }, { title: 'Community Loved' ,
                desc: 'Join thousands of happy customers spreading joy with our cards.' ,
                color: 'bg-base-100 text-base-content' } ] %>

                <% features.forEach((f, idx)=> { %>
                    <div
                        class="<%= f.color %> border-4 border-neutral p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] transform <%= idx % 2 === 0 ? '-rotate-1' : 'rotate-2' %> hover:rotate-0 transition-transform flex flex-col h-full">
                        <h3
                            class="text-2xl font-black uppercase mb-4 border-b-4 border-neutral pb-2 inline-block self-start">
                            <%= f.title %>
                        </h3>
                        <p class="font-bold text-lg leading-snug">
                            <%= f.desc %>
                        </p>
                    </div>
                    <% }); %>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="bg-base-100 px-4 py-32 text-center relative overflow-hidden">
    <!-- Huge background text -->
    <div
        class="absolute inset-0 flex items-center justify-center opacity-5 pointer-events-none overflow-hidden text-base-content">
        <span class="text-[15rem] md:text-[20rem] font-black uppercase whitespace-nowrap leading-none">JOIN NOW JOIN
            NOW</span>
    </div>

    <div class="container mx-auto max-w-4xl relative z-10">
        <h2 class="text-5xl md:text-7xl font-black uppercase mb-12 text-base-content">Ready to Spread Joy?</h2>
        <p
            class="text-2xl font-bold max-w-2xl mx-auto mb-16 bg-primary text-primary-content border-4 border-neutral p-6 shadow-[10px_10px_0_0_rgba(0,0,0,1)] transform -rotate-1">
            Create an account to track your orders, save your favorites, and earn reward points.
        </p>
        <a href="/login"
            class="inline-block bg-neutral text-neutral-content text-3xl font-black uppercase px-12 py-6 border-4 border-neutral shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:bg-warning hover:text-warning-content hover:-translate-y-[2px] hover:-translate-x-[2px] hover:shadow-[6px_6px_0_0_rgba(0,0,0,1)] active:translate-y-[2px] active:translate-x-[2px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all">
            Sign Up Now!
        </a>
    </div>
</section>