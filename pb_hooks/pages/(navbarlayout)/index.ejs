<!-- Hero Banner Section -->
<div class="bg-base-200/50 py-16 md:py-24 border-b border-slate-200/70 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Hero Left Copy -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <span class="text-xs font-bold uppercase tracking-wider text-primary">
                    Handcrafted Stationery
                </span>
                
                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-base-content tracking-tight leading-tight">
                    Greeting Cards for Every Celebration
                </h1>
                
                <p class="text-base sm:text-lg text-base-content/70 max-w-xl mx-auto lg:mx-0 leading-relaxed font-medium">
                    Explore our collection of funny, thoughtful, and custom-illustrated cards printed locally on 100% recycled paper stock.
                </p>

                <div class="flex flex-wrap justify-center lg:justify-start gap-4 pt-2">
                    <a href="/shop" class="btn btn-primary btn-lg rounded-xl font-bold px-8 shadow-sm">
                        Shop All Cards
                    </a>
                    <a href="/shop?category=birthday" class="btn btn-outline btn-lg rounded-xl font-bold px-7">
                        Birthday Cards
                    </a>
                </div>
            </div>

            <!-- Hero Right Showcase Card -->
            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <div class="card w-full max-w-sm bg-base-100 border border-slate-200/80 dark:border-slate-800 shadow-md">
                    <figure class="px-4 pt-4">
                        <img src="/hero-greeting-card.png" alt="Featured Card" class="rounded-xl h-72 w-full object-cover" />
                    </figure>
                    <div class="card-body p-5 space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-primary uppercase tracking-wider">Featured Design</span>
                            <span class="text-xs font-bold text-amber-500">★ 5.0</span>
                        </div>
                        <h3 class="card-title text-base font-bold text-base-content leading-snug">
                            Hilarious Toast Greeting Card
                        </h3>
                        <div class="card-actions justify-between items-center pt-2 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-lg font-bold text-base-content">$4.99</span>
                            <a href="/shop" class="btn btn-primary btn-sm rounded-xl font-bold px-5">
                                View Item
                            </a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Best Sellers Catalog Section -->
<section class="py-16 bg-base-100">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-10 pb-4 border-b border-slate-100 dark:border-slate-800 gap-4">
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-base-content tracking-tight">
                    Best Sellers
                </h2>
                <p class="text-xs text-base-content/60 mt-1">Our most popular greeting cards</p>
            </div>
            <a href="/shop" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                View Catalog →
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% if (data.recentCards && data.recentCards.length > 0) { %>
                <% data.recentCards.slice(0, 4).forEach(card => { %>
                    <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-all duration-300 group" x-data="{ showSecond: false }" @mouseenter="showSecond = true" @mouseleave="showSecond = false">
                        <figure class="aspect-[4/5] bg-base-200 relative overflow-hidden">
                            <% if (card.images && card.images.length > 1) { %>
                                <img src="<%= card.images[0] %>" alt="<%= card.title %>" 
                                     class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 absolute inset-0"
                                     :class="showSecond ? 'opacity-0' : 'opacity-100'">
                                <img src="<%= card.images[1] %>" alt="<%= card.title %>" 
                                     class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 absolute inset-0 opacity-0"
                                     :class="showSecond ? 'opacity-100' : 'opacity-0'">
                            <% } else { %>
                                <img src="<%= card.image %>" alt="<%= card.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <% } %>
                        </figure>

                        <div class="card-body p-4 space-y-2">
                            <a href="/shop/card/<%= card.slug.replace(/\s+/g, '-') %>/<%= card.id %>" class="card-title text-sm font-bold text-base-content hover:text-primary transition-colors line-clamp-2 leading-snug">
                                <%= card.title %>
                            </a>

                            <div class="card-actions justify-between items-center pt-2 border-t border-slate-100 dark:border-slate-800">
                                <span class="text-base font-extrabold text-base-content"><%= card.price %></span>
                                <a href="/shop/card/<%= card.slug.replace(/\s+/g, '-') %>/<%= card.id %>" class="btn btn-outline btn-primary btn-xs rounded-lg font-bold">
                                    Details
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</section>

<!-- Shop by Category Section -->
<section class="py-16 bg-base-200/40 border-t border-slate-200/70 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="mb-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-base-content tracking-tight">Shop by Category</h2>
            <p class="text-xs text-base-content/60 mt-1">Browse cards tailored to your event</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% if (data.topCollections && data.topCollections.length > 0) { %>
                <% data.topCollections.forEach((col) => { %>
                    <a href="/shop?category=<%= col.slug %>" class="block group">
                        <div class="card card-side bg-base-100 border border-slate-200/80 dark:border-slate-800 shadow-xs hover:shadow-md transition-all duration-300 p-4">
                            <figure class="w-16 h-16 rounded-xl bg-base-200 overflow-hidden flex-shrink-0 my-auto">
                                <% if (col.images && col.images.length > 0) { %>
                                    <img src="<%= col.images[0] %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                <% } else { %>
                                    <div class="w-full h-full bg-base-300"></div>
                                <% } %>
                            </figure>
                            <div class="card-body p-3 min-w-0 justify-center">
                                <h3 class="card-title text-base font-bold text-base-content group-hover:text-primary transition-colors truncate">
                                    <%= col.title %>
                                </h3>
                                <p class="text-xs text-base-content/60 line-clamp-1">
                                    <%= col.description %>
                                </p>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } %>
        </div>
    </div>
</section>

<!-- Customer Reviews Section -->
<section class="py-16 bg-base-100 border-t border-slate-200/70 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="mb-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-base-content tracking-tight">Customer Reviews</h2>
            <p class="text-xs text-base-content/60 mt-1">Feedback from verified shoppers</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <% if (data.recentReviews && data.recentReviews.length > 0) { %>
                <% data.recentReviews.forEach((review) => { %>
                    <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 shadow-xs p-5 space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-xs text-base-content"><%= review.userName %></span>
                            <span class="text-xs text-amber-500 font-bold">★ <%= review.rating || 5 %>.0</span>
                        </div>
                        
                        <% if (review.review) { %>
                            <p class="text-xs text-base-content/75 leading-relaxed italic">
                                "<%= review.review %>"
                            </p>
                        <% } %>
                        
                        <div class="pt-2 border-t border-slate-100 dark:border-slate-800">
                            <span class="text-[11px] font-medium text-base-content/50">
                                Verified purchase on <%= review.cardTitle %>
                            </span>
                        </div>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</section>