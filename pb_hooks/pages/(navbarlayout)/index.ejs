<!-- Hero Section with Dark Gradient Background -->
<div class="min-h-screen" id="home">
    <!-- Hero -->
    <div class="hero relative min-h-[80vh] overflow-hidden bg-gradient-to-b from-base-200 via-base-100">
        <!-- Background Pattern -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <!-- Subtle Grid Pattern -->
            <div
                class="absolute inset-0 bg-[linear-gradient(to_right,#80808008_1px,transparent_1px),linear-gradient(to_bottom,#80808008_1px,transparent_1px)] bg-[size:40px_40px]">
            </div>
            <!-- Cinematic Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-base-100 via-transparent to-transparent"></div>
            <!-- Top Glow -->
            <div
                class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[600px] bg-primary/5 rounded-full blur-[150px]">
            </div>
        </div>

        <div class="hero-content relative z-10 py-20 text-left place-items-start">
            <div class="max-w-4xl">
                <!-- Main Headline -->
                <h1
                    class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-bold mb-6 tracking-tight leading-tight text-shadow-lg">
                    <span class="text-base-content ">
                        <span class="text-primary italic">Discover</span> unique cards.
                    </span>
                    <div class="text-base-content ">
                        Find the perfect <span class="text-primary italic">greeting.</span>
                    </div>
                </h1>

                <!-- Tagline -->
                <span
                    class="text-lg md:text-xl text-base-content/60 mb-10 leading-relaxed max-w-2xl mx-auto italic text-left items-start">
                    Shop hilariously punny birthday cards and unique greetings for every occasion.
                </span>

                <!-- CTA Buttons -->
                <div class="flex flex-col justify-start gap-4 sm:flex-row pt-8">
                    <a href="/shop"
                        class="btn btn-primary btn-lg gap-2 shadow-lg transition-all duration-300 hover:scale-105">
                        Shop Now
                    </a>
                    <a href="#features"
                        class="btn btn-ghost btn-lg gap-2 border border-base-content/20 transition-all duration-300 hover:border-base-content/40">
                        View Collections
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- New Arrivals Section -->
    <section class="bg-base-100 px-4 py-16">
        <div class="mx-auto max-w-6xl">
            <div class="flex justify-between items-center mb-8">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold">New Arrivals</h2>
                    <p class="text-base-content/60 mt-1">The latest additions to our store</p>
                </div>
                <a href="/shop" class="btn btn-ghost btn-sm gap-1">
                    View All Products
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                        stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                </a>
            </div>

            <!-- Products Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-4 md:gap-6">
                <% if (data.recentCards && data.recentCards.length > 0) { %>
                    <% data.recentCards.forEach(card => { %>
                        <a href="/shop/<%= card.id %>" class="group cursor-pointer block">
                            <div
                                class="aspect-[2/3] rounded-lg bg-base-200 overflow-hidden shadow-lg transition-all duration-300 group-hover:scale-105 group-hover:shadow-xl relative">
                                <img src="<%= card.image %>"
                                    alt="<%= card.title %>" class="w-full h-full object-cover">
                                <div
                                    class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-black/90 via-black/60 to-transparent opacity-100 transition-opacity flex flex-col justify-end">
                                    <p class="text-white text-sm font-medium truncate mb-1">
                                        <%= card.title %>
                                    </p>
                                    <p class="text-primary text-xs font-bold">
                                        <%= card.price %>
                                    </p>
                                </div>
                            </div>
                        </a>
                        <% }); %>
                            <% } else { %>
                                <div class="col-span-full text-center py-10 text-base-content/50">
                                    <p>No products available yet.</p>
                                </div>
                                <% } %>
            </div>
        </div>
    </section>

    <!-- Curated Collections & Trending Now Section -->
    <section class="bg-base-200/50 px-4 py-16">
        <div class="mx-auto max-w-6xl">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
                <!-- Curated Collections -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl md:text-2xl font-bold">Curated Collections</h2>
                        <a href="/collections" class="btn btn-ghost btn-sm gap-1">
                            View All Collections
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24"
                                stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 5l7 7-7 7" />
                            </svg>
                        </a>
                    </div>
                    <p class="text-base-content/60 mb-6 -mt-4">Hand-picked selections for every occasion</p>

                    <div class="space-y-4">
                        <% if (data.topCollections && data.topCollections.length > 0) { %>
                            <% data.topCollections.forEach(collection => { %>
                                <a href="/collections/<%= collection.id %>"
                                    class="card bg-base-100 shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer group">
                                    <div class="card-body p-4 flex-row items-center gap-4">
                                        <div class="flex -space-x-2">
                                            <% if (collection.images && collection.images.length > 0) { %>
                                                <% collection.images.forEach(img => { %>
                                                    <img src="<%= img %>"
                                                        class="w-10 h-14 rounded object-cover border-2 border-base-100">
                                                    <% }); %>
                                            <% } else { %>
                                                <div class="w-10 h-14 rounded bg-gradient-to-br from-primary/40 to-secondary/40"></div>
                                            <% } %>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <h3
                                                class="font-semibold group-hover:text-primary transition-colors truncate">
                                                <%= collection.title %>
                                            </h3>
                                            <p class="text-sm text-base-content/60">
                                                <%= collection.description %>
                                            </p>
                                            <p class="text-xs text-base-content/50 truncate mt-1">
                                                <%= collection.count %> items
                                            </p>
                                        </div>
                                        <svg xmlns="http://www.w3.org/2000/svg"
                                            class="h-5 w-5 text-base-content/30 group-hover:text-primary transition-colors"
                                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M9 5l7 7-7 7" />
                                        </svg>
                                    </div>
                                </a>
                                <% }); %>
                                    <% } else { %>
                                        <div class="text-center py-10 text-base-content/50">
                                            <p>No collections yet.</p>
                                        </div>
                                        <% } %>
                    </div>
                </div>

                <!-- Trending Reviews -->
                <div>
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-xl md:text-2xl font-bold">Customer Reviews</h2>
                    </div>

                    <div class="space-y-4">
                        <% if (data.recentReviews && data.recentReviews.length > 0) { %>
                            <% const colors=['primary', 'secondary' , 'accent' , 'info' ]; %>
                                <% data.recentReviews.forEach((review, index) => { %>
                                    <div class="card bg-base-100 shadow-md">
                                        <div class="card-body p-4">
                                            <div class="flex items-start gap-3">
                                                <div class="avatar placeholder">
                                                    <div
                                                        class="bg-<%= colors[index % 4] %> text-<%= colors[index % 4] %>-content rounded-full w-10">
                                                        <span class="text-sm font-bold">
                                                            <%= review.userInitials || 'U' %>
                                                        </span>
                                                    </div>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <p class="text-sm">
                                                        <span class="font-semibold">
                                                            <%= review.userName %>
                                                        </span>
                                                        <span class="text-base-content/60">
                                                            <%= review.type === 'review' ? 'reviewed' : 'rated' %>
                                                        </span>
                                                        <a href="#"
                                                            class="font-semibold text-primary hover:underline">
                                                            <%= review.cardTitle %>
                                                        </a>
                                                    </p>
                                                    <% if (review.review) { %>
                                                        <p class="text-sm text-base-content/60 mt-1 line-clamp-2">
                                                            "<%= review.review %>"
                                                        </p>
                                                        <% } %>
                                                            <% if (review.rating > 0) { %>
                                                                <div class="flex items-center gap-1 mt-2">
                                                                    <div class="rating rating-sm rating-half">
                                                                        <input type="radio" name="rating-<%= index %>"
                                                                            class="rating-hidden" />
                                                                        <% for (let i=1; i <=5; i++) { %>
                                                                            <input type="radio"
                                                                                name="rating-<%= index %>"
                                                                                class="mask mask-star-2 mask-half-1 bg-warning"
                                                                                disabled <%= review.rating === (i - 0.5) ? 'checked' : '' %> />
                                                                            <input type="radio"
                                                                                name="rating-<%= index %>"
                                                                                class="mask mask-star-2 mask-half-2 bg-warning"
                                                                                disabled <%= review.rating === i ? 'checked' : '' %> />
                                                                            <% } %>
                                                                    </div>
                                                                </div>
                                                                <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                        <% } else { %>
                                            <div class="text-center py-10 text-base-content/50">
                                                <p>No recent reviews yet.</p>
                                            </div>
                                            <% } %>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="bg-base-100 px-4 py-20">
        <div class="mx-auto max-w-6xl">
            <div class="text-center mb-12">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">
                    Everything you need to send a smile
                </h2>
                <p class="text-lg text-base-content/60 max-w-2xl mx-auto">
                    More than just a store. We provide the highest quality cards for your loved ones.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Feature Card 1 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Premium Packaging</h3>
                        <p class="text-base-content/60">
                            Every order is securely packaged to ensure your cards arrive in pristine condition.
                        </p>
                    </div>
                </div>

                <!-- Feature Card 2 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-secondary/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Fast Shipping</h3>
                        <p class="text-base-content/60">
                            Get your cards faster with our expedited worldwide shipping options.
                        </p>
                    </div>
                </div>

                <!-- Feature Card 3 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Locally Printed</h3>
                        <p class="text-base-content/60">
                            All our cards are printed locally on high-quality, sustainable paper.
                        </p>
                    </div>
                </div>

                <!-- Feature Card 4 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-info/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-info" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Secure Checkout</h3>
                        <p class="text-base-content/60">
                            Your payment information is always encrypted and protected.
                        </p>
                    </div>
                </div>

                <!-- Feature Card 5 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-success/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-success" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Rewards Program</h3>
                        <p class="text-base-content/60">
                            Earn points with every purchase and unlock exclusive discounts and early access.
                        </p>
                    </div>
                </div>

                <!-- Feature Card 6 -->
                <div class="card bg-base-200/50 hover:bg-base-200 transition-all duration-300">
                    <div class="card-body">
                        <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-warning/10">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-warning" fill="none"
                                viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round"
                                    d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" />
                            </svg>
                        </div>
                        <h3 class="card-title text-lg">Community Loved</h3>
                        <p class="text-base-content/60">
                            Join thousands of happy customers spreading joy with our unique cards.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <section class="bg-gradient-to-br from-primary/10 via-base-200 to-secondary/10 px-4 py-20">
        <div class="mx-auto max-w-3xl text-center">
            <h2 class="mb-4 text-3xl md:text-4xl font-bold">Start spreading joy today</h2>
            <p class="mb-8 text-lg text-base-content/60">
                Create an account to track your orders, save your favorite cards, and earn reward points.
            </p>
            <a href="/login"
                class="btn btn-primary btn-lg gap-2 shadow-lg transition-all duration-300 hover:scale-105 hover:shadow-primary/25">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round"
                        d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
                Sign Up Now
            </a>
        </div>
    </section>
</div>