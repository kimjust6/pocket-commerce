<!-- E-Commerce Store Banner -->
<div class="bg-slate-900 text-white py-12 md:py-20 relative overflow-hidden">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
            <div class="space-y-4">
                <span class="inline-block px-3 py-1 rounded-full bg-primary/20 text-primary-light text-xs font-semibold tracking-wider uppercase">
                    Greeting Cards & Stationery
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white leading-tight">
                    Shop Handcrafted Greeting Cards for Every Occasion
                </h1>
                <p class="text-base md:text-lg text-slate-300 max-w-lg leading-relaxed">
                    Explore our collection of funny, heartfelt, and uniquely illustrated cards. Printed on premium sustainable paper stock.
                </p>
                <div class="pt-2 flex flex-wrap gap-3">
                    <a href="/shop" class="btn btn-primary btn-md rounded-xl font-bold px-6 shadow-md">
                        Shop All Products
                    </a>
                    <a href="/shop?category=birthday" class="btn btn-outline btn-md rounded-xl text-white border-slate-700 hover:bg-slate-800 font-semibold px-6">
                        Birthday Cards
                    </a>
                </div>
            </div>

            <!-- Featured Product Spot -->
            <div class="hidden md:flex justify-end">
                <div class="bg-slate-800/80 border border-slate-700 rounded-3xl p-5 max-w-sm flex items-center gap-4 shadow-xl">
                    <img src="/hero-greeting-card.png" alt="Featured Card" class="w-24 h-28 object-cover rounded-xl bg-slate-900 flex-shrink-0">
                    <div class="space-y-1">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400">Featured Item</span>
                        <h3 class="text-base font-bold text-white leading-snug">Hilarious Toast Greeting</h3>
                        <p class="text-xs text-slate-300 font-semibold">$4.99</p>
                        <a href="/shop" class="text-xs font-bold text-primary hover:underline block pt-1">
                            Buy Now →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Category Navigation Bar -->
<div class="border-b border-slate-200 dark:border-slate-800 bg-base-100 sticky top-16 z-30 shadow-sm">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex items-center gap-2 overflow-x-auto py-3 scrollbar-hide text-xs font-semibold">
            <span class="text-base-content/50 pr-2 font-bold uppercase tracking-wider hidden sm:inline">Categories:</span>
            <a href="/shop" class="px-4 py-2 rounded-full bg-primary text-primary-content font-bold whitespace-nowrap shadow-xs">
                All Products
            </a>
            <% if (data.topCollections && data.topCollections.length > 0) { %>
                <% data.topCollections.forEach(col => { %>
                    <a href="/shop?category=<%= col.slug %>" class="px-4 py-2 rounded-full bg-base-200 text-base-content/80 hover:bg-base-300 hover:text-base-content whitespace-nowrap transition-colors">
                        <%= col.title %>
                    </a>
                <% }); %>
            <% } %>
            <a href="/shop?on_sale=1" class="px-4 py-2 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold whitespace-nowrap hover:bg-amber-500/20 transition-colors">
                🔥 Special Deals
            </a>
        </div>
    </div>
</div>

<!-- Store Products Grid Section -->
<section class="py-12 md:py-16 bg-base-100">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100 dark:border-slate-800">
            <div>
                <h2 class="text-2xl font-bold text-base-content tracking-tight">Best Selling Cards</h2>
                <p class="text-xs text-base-content/60 mt-0.5">Top rated greetings loved by our customers</p>
            </div>
            <a href="/shop" class="text-xs font-semibold text-primary hover:underline flex items-center gap-1">
                Browse Full Catalog →
            </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-5">
            <% if (data.recentCards && data.recentCards.length > 0) { %>
                <% data.recentCards.forEach(card => { %>
                    <div class="store-card h-full flex flex-col justify-between" x-data="{ showSecond: false }" @mouseenter="showSecond = true" @mouseleave="showSecond = false">
                        <a href="/shop/card/<%= card.slug.replace(/\s+/g, '-') %>/<%= card.id %>" class="block aspect-[4/5] bg-base-200 relative overflow-hidden">
                            <% if (card.images && card.images.length > 1) { %>
                                <img src="<%= card.images[0] %>" alt="<%= card.title %>" 
                                     class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 absolute inset-0"
                                     :class="showSecond ? 'opacity-0' : 'opacity-100'">
                                <img src="<%= card.images[1] %>" alt="<%= card.title %>" 
                                     class="w-full h-full object-cover transition-all duration-300 group-hover:scale-105 absolute inset-0 opacity-0"
                                     :class="showSecond ? 'opacity-100' : 'opacity-0'">
                            <% } else { %>
                                <img src="<%= card.image %>" alt="<%= card.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                            <% } %>
                            <span class="absolute top-2 left-2 bg-slate-900/80 backdrop-blur-sm text-white text-[10px] font-bold px-2 py-0.5 rounded-full">Card</span>
                        </a>

                        <div class="p-3 space-y-2 flex-1 flex flex-col justify-between">
                            <div>
                                <a href="/shop/card/<%= card.slug.replace(/\s+/g, '-') %>/<%= card.id %>" class="font-bold text-xs text-base-content hover:text-primary transition-colors line-clamp-2 leading-snug">
                                    <%= card.title %>
                                </a>
                            </div>

                            <div class="space-y-2 pt-1 border-t border-slate-100 dark:border-slate-800">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-extrabold text-base-content"><%= card.price %></span>
                                    <span class="text-[10px] text-amber-500 font-bold flex items-center gap-0.5">★ 4.9</span>
                                </div>

                                <a href="/shop/card/<%= card.slug.replace(/\s+/g, '-') %>/<%= card.id %>" class="btn btn-primary btn-xs w-full rounded-lg font-semibold text-[11px]">
                                    View Item
                                </a>
                            </div>
                        </div>
                    </div>
                <% }); %>
            <% } else { %>
                <div class="col-span-full border border-slate-200 dark:border-slate-800 bg-base-200/50 rounded-2xl p-8 text-center text-sm font-medium text-base-content/60">
                    No products currently listed.
                </div>
            <% } %>
        </div>
    </div>
</section>

<!-- Shop Categories Section -->
<section class="py-12 bg-base-200/40 border-t border-slate-200 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-base-content tracking-tight">Shop by Category</h2>
            <p class="text-xs text-base-content/60 mt-0.5">Find greetings tailored to your exact event or topic</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
            <% if (data.topCollections && data.topCollections.length > 0) { %>
                <% data.topCollections.forEach((col) => { %>
                    <a href="/shop?category=<%= col.slug %>" class="block group">
                        <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 flex items-center gap-4 shadow-sm hover:shadow-md transition-all">
                            <div class="w-16 h-16 rounded-xl bg-base-200 overflow-hidden flex-shrink-0">
                                <% if (col.images && col.images.length > 0) { %>
                                    <img src="<%= col.images[0] %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
                                <% } else { %>
                                    <div class="w-full h-full bg-base-300"></div>
                                <% } %>
                            </div>
                            <div class="flex-1 min-w-0">
                                <h3 class="text-base font-bold text-base-content group-hover:text-primary transition-colors truncate">
                                    <%= col.title %>
                                </h3>
                                <p class="text-xs text-base-content/60 line-clamp-1 mt-0.5">
                                    <%= col.description %>
                                </p>
                                <span class="inline-block mt-1 text-[11px] font-semibold text-primary">
                                    Shop Collection →
                                </span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } %>
        </div>
    </div>
</section>

<!-- Customer Reviews Bar -->
<section class="py-12 bg-base-100 border-t border-slate-200 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-base-content tracking-tight">Recent Customer Feedback</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
            <% if (data.recentReviews && data.recentReviews.length > 0) { %>
                <% data.recentReviews.forEach((review) => { %>
                    <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-xs text-base-content"><%= review.userName %></span>
                            <div class="flex text-amber-400 text-xs">
                                <% for(let i=0; i<Math.floor(review.rating || 5); i++) { %>
                                    ★
                                <% } %>
                            </div>
                        </div>
                        <% if (review.review) { %>
                            <p class="text-xs text-base-content/80 leading-relaxed italic">
                                "<%= review.review %>"
                            </p>
                        <% } %>
                        <p class="text-[10px] text-base-content/50 pt-1 border-t border-slate-100 dark:border-slate-800">
                            On <%= review.cardTitle %>
                        </p>
                    </div>
                <% }); %>
            <% } %>
        </div>
    </div>
</section>