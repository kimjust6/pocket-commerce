<!-- 1. Editorial Hero Section -->
<section class="bg-base-100 py-12 md:py-20 border-b border-base-200 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

            <!-- Hero Left Copy -->
            <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-primary/10 text-primary border border-primary/20 text-xs font-black uppercase tracking-widest shadow-2xs">
                    <span class="w-2 h-2 rounded-full bg-accent animate-ping"></span>
                    Handcrafted Drops 2026
                </div>

                <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-base-content tracking-tight leading-[1.1]">
                    Thoughtful Greeting Cards <br class="hidden sm:inline" />
                    <span class="text-primary">For Every Celebration</span>
                </h1>

                <p
                    class="text-base sm:text-lg text-base-content/70 max-w-xl mx-auto lg:mx-0 leading-relaxed font-normal">
                    Handcrafted greeting cards and stationery printed locally on 100% recycled cotton cardstock.
                    Artisanal, meaningful, and made to bring smiles.
                </p>

                <div class="flex flex-wrap justify-center lg:justify-start gap-3.5 pt-2">
                    <a href="/shop" class="btn btn-primary btn-md sm:btn-lg rounded-full font-bold px-8 shadow-xs hover:shadow-md transition-all">
                        Shop All Cards
                    </a>
                    <a href="/shop?category=birthday"
                        class="btn btn-outline btn-primary btn-md sm:btn-lg rounded-full font-bold px-7">
                        Birthday Cards
                    </a>
                    <a href="/shop?on_sale=1"
                        class="btn btn-ghost btn-md sm:btn-lg text-accent font-bold px-5 hover:bg-accent/10 rounded-full">
                        Limited Offers →
                    </a>
                </div>

                <div
                    class="flex items-center justify-center lg:justify-start gap-6 pt-4 text-xs font-medium text-base-content/60 border-t border-base-200 dark:border-slate-800">
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>100% Recycled Cotton</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Plastic-Free Dispatch</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd"
                                d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Free Shipping $30+</span>
                    </div>
                </div>
            </div>

            <!-- Hero Right Showcase Card -->
            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <% const heroItem=data.featuredHero || (data.recentCards && data.recentCards[0]); %>
                    <% if (heroItem) { %>
                        <div
                            class="card w-full max-w-sm bg-base-100 border border-base-200/90 dark:border-slate-800 shadow-xl group hover:shadow-2xl transition-all duration-300 rounded-3xl overflow-hidden">
                            <figure class="px-5 pt-5 relative">
                                <img src="<%= heroItem.image %>" alt="<%= heroItem.title %>"
                                    class="rounded-2xl h-80 w-full object-cover group-hover:scale-102 transition-transform duration-500" />
                                <span
                                    class="absolute top-8 left-8 bg-accent text-white text-[10px] font-black uppercase tracking-wider px-3 py-1 rounded-full shadow-xs">
                                    FEATURED DESIGN
                                </span>
                            </figure>
                            <div class="card-body p-6 space-y-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-bold text-primary uppercase tracking-wider">
                                        <%= heroItem.category || 'Artisan Series' %>
                                    </span>
                                    <span class="text-xs font-bold text-amber-500 flex items-center gap-1">
                                        ★ 5.0 <span class="text-base-content/50 font-normal">(128)</span>
                                    </span>
                                </div>
                                <h3 class="card-title text-lg font-extrabold text-base-content leading-snug">
                                    <%= heroItem.title %>
                                </h3>
                                <p class="text-xs text-base-content/70 line-clamp-2">
                                    <%= heroItem.description %>
                                </p>
                                <div
                                    class="card-actions justify-between items-center pt-3 border-t border-base-200 dark:border-slate-800">
                                    <div>
                                        <span class="text-xl font-black text-base-content">
                                            <%= heroItem.price %>
                                        </span>
                                        <span class="text-[11px] text-base-content/50 block">Includes envelope</span>
                                    </div>
                                    <a href="/shop/card/<%= heroItem.slug %>/<%= heroItem.id %>"
                                        class="btn btn-primary btn-sm rounded-full font-bold px-5 shadow-xs hover:shadow-sm">
                                        Quick View
                                    </a>
                                </div>
                            </div>
                        </div>
                        <% } %>
            </div>

        </div>
    </div>
</section>

<!-- 3. Visual "Shop by Category" Quick-Jump Strip -->
<section class="py-12 bg-base-100 border-b border-base-200/80 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="flex items-center justify-between mb-8 pb-3 border-b border-base-200 dark:border-slate-800">
            <div>
                <h2 class="text-xl sm:text-2xl font-black text-base-content tracking-tight">Shop by Category</h2>
                <p class="text-xs text-base-content/60 mt-0.5">Explore our handcrafted themes & occasions</p>
            </div>
            <a href="/shop" class="text-xs font-bold text-primary hover:underline">
                View All Categories →
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
            <% if (data.topCollections && data.topCollections.length> 0) { %>
                <% data.topCollections.slice(0, 5).forEach((col)=> { %>
                    <a href="/shop?category=<%= col.slug %>" class="group block text-center space-y-3">
                        <div
                            class="aspect-square rounded-3xl bg-base-200/60 overflow-hidden border border-base-200/90 dark:border-slate-800 shadow-xs group-hover:shadow-lg transition-all duration-300 group-hover:-translate-y-1.5 relative">
                            <% if (col.images && col.images.length> 0) { %>
                                <img src="<%= col.images[0] %>" alt="<%= col.title %>"
                                    class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500">
                                <% } else { %>
                                    <div class="w-full h-full bg-base-300"></div>
                                    <% } %>
                                        <span
                                            class="badge badge-sm bg-base-100/95 text-base-content/90 absolute bottom-3 right-3 text-[10px] font-bold px-2.5 py-0.5 rounded-full shadow-xs border border-base-200 dark:border-slate-700">
                                            <%= col.count %>
                                                <%= col.count===1 ? 'card' : 'cards' %>
                                        </span>
                        </div>
                        <div>
                            <h3
                                class="font-extrabold text-sm text-base-content group-hover:text-primary transition-colors">
                                <%= col.title %>
                            </h3>
                            <p class="text-[11px] text-base-content/60 line-clamp-1 mt-0.5">
                                <%= col.description %>
                            </p>
                        </div>
                    </a>
                    <% }); %>
                        <% } %>
        </div>
    </div>
</section>

<!-- 4. Multi-Buy Promotional Banner -->
<section class="py-10 bg-slate-900 text-slate-100">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-6 p-6 sm:p-8 rounded-3xl bg-neutral text-neutral-content border border-slate-800 shadow-xl">
            <div class="space-y-2 text-center md:text-left">
                <div
                    class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent text-white text-[11px] font-black uppercase tracking-widest">
                    Limited Time Offer
                </div>
                <h3 class="text-2xl sm:text-3xl font-black tracking-tight text-white">
                    Buy 3 Cards, Get 1 Free
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 max-w-xl">
                    Mix and match any birthday, holiday, and celebration cards. Stock up on thoughtful greetings and
                    save automatically at checkout.
                </p>
            </div>
            <div class="flex items-center gap-3">
                <a href="/shop"
                    class="btn bg-white text-slate-900 hover:bg-slate-100 font-extrabold text-sm px-7 rounded-full border-none shadow-md">
                    Shop The Offer
                </a>
                <a href="/shop?on_sale=1"
                    class="btn btn-outline border-slate-700 text-slate-200 hover:bg-slate-800 font-bold text-sm px-6 rounded-full">
                    View Sale
                </a>
            </div>
        </div>
    </div>
</section>

<!-- 5. Best Sellers & Trending Now Grid -->
<section class="py-16 bg-base-100">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div
            class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-10 pb-4 border-b border-base-200 dark:border-slate-800 gap-4">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-primary">Curated Catalog</span>
                <h2 class="text-2xl sm:text-3xl font-black text-base-content tracking-tight mt-1">
                    Trending Best Sellers
                </h2>
                <p class="text-xs text-base-content/60 mt-0.5">Top-rated greeting cards loved by our community</p>
            </div>
            <a href="/shop" class="text-xs font-bold text-primary hover:underline flex items-center gap-1">
                View Full Catalog (<%= (data.recentCards && data.recentCards.length) || 0 %> items) →
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 sm:gap-6">
            <% if (data.bestSellers && data.bestSellers.length> 0) { %>
                <% data.bestSellers.forEach(card=> { %>
                    <%- include('../_private/product-card.ejs', { card: card }) %>
                        <% }); %>
                            <% } else if (data.recentCards && data.recentCards.length> 0) { %>
                                <% data.recentCards.slice(0, 8).forEach(card=> { %>
                                    <%- include('../_private/product-card.ejs', { card: card }) %>
                                        <% }); %>
                                            <% } %>
        </div>
    </div>
</section>

<!-- 6. The Pocket Craft Pillars -->
<section class="py-16 bg-base-200/40 border-t border-base-200/80 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
            <span class="text-xs font-black uppercase tracking-widest text-primary">Our Philosophy</span>
            <h2 class="text-2xl sm:text-4xl font-black text-base-content tracking-tight">
                Simple, Sweet & Sustainable
            </h2>
            <p class="text-xs sm:text-sm text-base-content/70">
                We believe that greeting cards should be thoughtful, durable, and kind to the planet.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            <% if (data.brandPillars && data.brandPillars.length> 0) { %>
                <% data.brandPillars.forEach(pillar=> { %>
                    <div
                        class="bg-base-100 border border-base-200/90 dark:border-slate-800 p-6 rounded-3xl shadow-xs space-y-3 hover:shadow-md transition-all duration-300">
                        <div
                            class="w-11 h-11 rounded-2xl flex items-center justify-center font-bold <%= pillar.icon === 'leaf' ? 'bg-emerald-500/10 text-emerald-600' : (pillar.icon === 'sparkles' ? 'bg-primary/10 text-primary' : (pillar.icon === 'truck' ? 'bg-sky-500/10 text-sky-600' : 'bg-accent/10 text-accent')) %>">
                            <% if (pillar.icon==='leaf' ) { %>
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z">
                                    </path>
                                </svg>
                                <% } else if (pillar.icon==='sparkles' ) { %>
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                        </path>
                                    </svg>
                                    <% } else if (pillar.icon==='truck' ) { %>
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0">
                                            </path>
                                        </svg>
                                        <% } else { %>
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                                                </path>
                                            </svg>
                                            <% } %>
                        </div>
                        <div class="space-y-1">
                            <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/50">
                                <%= pillar.subtitle %>
                            </span>
                            <h3 class="text-base font-extrabold text-base-content">
                                <%= pillar.title %>
                            </h3>
                        </div>
                        <p class="text-xs text-base-content/70 leading-relaxed">
                            <%= pillar.description %>
                        </p>
                    </div>
                    <% }); %>
                        <% } %>
        </div>
    </div>
</section>

<!-- 7. Customer Reviews & Community Feedback -->
<section class="py-16 bg-base-100 border-t border-base-200/80 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div
            class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-10 pb-4 border-b border-base-200 dark:border-slate-800 gap-4">
            <div>
                <span class="text-xs font-bold uppercase tracking-wider text-primary">Customer Reviews</span>
                <h2 class="text-2xl sm:text-3xl font-black text-base-content tracking-tight mt-1">
                    Loved by Thousands
                </h2>
                <p class="text-xs text-base-content/60 mt-0.5">Real feedback from greeting card givers</p>
            </div>
            <div class="flex items-center gap-1.5 text-xs font-bold text-amber-500 bg-amber-500/10 px-3 py-1 rounded-full">
                <span>★ 4.98 Overall Customer Rating</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <% if (data.recentReviews && data.recentReviews.length> 0) { %>
                <% data.recentReviews.forEach((review)=> { %>
                    <%- include('../_private/review-card.ejs', { review: review }) %>
                        <% }); %>
                            <% } %>
        </div>
    </div>
</section>

<!-- 8. Member Perks & Newsletter Banner -->
<section class="py-12 bg-base-200/50 border-t border-base-200/80 dark:border-slate-800">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="bg-base-100 border border-base-200/90 dark:border-slate-800 rounded-3xl p-8 sm:p-12 shadow-sm flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left"
            x-data="{ email: '', subscribed: false }">
            <div class="space-y-2 max-w-lg">
                <span
                    class="inline-block text-[11px] font-black uppercase tracking-widest px-3 py-1 rounded-full bg-primary/10 text-primary border border-primary/20">
                    Pocket Member Club
                </span>
                <h3 class="text-2xl sm:text-3xl font-black text-base-content tracking-tight">
                    Get $5 Off Your First Order
                </h3>
                <p class="text-xs sm:text-sm text-base-content/70">
                    Sign up to receive member-only discounts, early access to limited drops, and seasonal promotion coupons.
                </p>
            </div>

            <div class="w-full max-w-md">
                <template x-if="!subscribed">
                    <form @submit.prevent="if(email) { subscribed = true; }" class="flex flex-col sm:flex-row gap-2.5">
                        <input type="email" x-model="email" required placeholder="Enter your email address..."
                            class="input input-bordered w-full rounded-full text-xs sm:text-sm bg-base-200/50 border-base-300 dark:border-slate-700 focus:bg-base-100" />
                        <button type="submit" class="btn btn-primary rounded-full font-bold px-7 shrink-0 shadow-xs hover:shadow-sm">
                            Subscribe
                        </button>
                    </form>
                </template>
                <template x-if="subscribed">
                    <div
                        class="alert alert-success rounded-3xl text-xs sm:text-sm font-bold flex items-center justify-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7">
                            </path>
                        </svg>
                        <span>Welcome to the club! Check your inbox for your $5 promo code.</span>
                    </div>
                </template>
            </div>
        </div>
    </div>
</section>