<script server>
    // Store variables to pass to the view
    let error = null;
    let success = null;
    let seed = "";
    let seedIndex = 0;
    
    let account = "";
    let balance = "0";
    let pending = "0";

const isPost = request.method === 'POST';

try {
    const runSync = (method, args) => {
        const scriptPath = $filepath.join(__hooks, '..', 'scripts', 'banano-runner.js');
        let resJson;
        try {
            resJson = $os.cmd("node", scriptPath, method, JSON.stringify(args || [])).output();
        } catch(osErr) {
            throw new Error("OS Command failed: " + (osErr.message || String(osErr)));
        }
        
        // Goja returns []byte from OS cmd output, which maps to a JS Array of bytes.
        let jsonStr = "";
        try {
            if (Array.isArray(resJson) || (typeof resJson === 'object' && resJson.length !== undefined)) {
                for (let i = 0; i < resJson.length; i++) {
                    jsonStr += String.fromCharCode(resJson[i]);
                }
            } else {
                jsonStr = String(resJson);
            }
        } catch(castErr) {
            throw new Error("Failed to convert byte array to string: " + castErr.message);
        }

        if (!jsonStr || jsonStr === "<nil>" || jsonStr === "") {
            throw new Error("Empty response from banano-runner. No output. Is Node installed?");
        }
        
        try {
            const parsed = JSON.parse(jsonStr);
            if (!parsed.success) {
                throw new Error(parsed.error);
            }
            return parsed.result;
        } catch (parseErr) {
            throw new Error("Failed to parse node output: " + String(resJson) + ". Error: " + parseErr.message);
        }
    };

    const banano = {
        getAccountInfo: (account) => runSync("getAccountInfo", [account]),
        getBananoAccount: (seed, seedIndex = 0) => runSync("getBananoAccount", [seed, seedIndex]),
        receiveBananos: (seed, seedIndex = 0) => runSync("receiveBananos", [seed, seedIndex, 'ban_1ka1ium4pfue3uxtntqsboa8egcw864xqdbc85vc5z33x5ne52pfcqigp5cb']),
        sendBanano: (seed, seedIndex = 0, destAccount, amountRaw) => runSync("sendBanano", [seed, seedIndex, destAccount, amountRaw]),
        getRawFromDecimal: (decimalAmount) => runSync("getRawFromDecimal", [decimalAmount]),
        getDecimalFromRaw: (rawAmount) => runSync("getDecimalFromRaw", [rawAmount])
    };

    if (isPost) {
        const _body = body();
        const action = _body.action;

        account = _body.account || "";
        seed = _body.seed || "";
        seedIndex = parseInt(_body.seedIndex) || 0;

        if (action === 'check') {
            if (account.startsWith('ban_')) {
                const info = banano.getAccountInfo(account);
                if (!info.error) {
                    balance = banano.getDecimalFromRaw(info.balance || "0");
                    pending = banano.getDecimalFromRaw(info.pending || "0");
                    success = "Balance checked successfully.";
                } else {
                    if (info.error === 'Account not found') {
                        success = "Account is unopened.";
                    } else {
                        error = info.error;
                    }
                }
            } else {
                error = "Invalid wallet address. Must start with ban_";
            }
        } 
        else if (action === 'receive' || action === 'send') {
            if (seed.length === 64) {
                // Determine account from the provided seed
                account = banano.getBananoAccount(seed, seedIndex);

                if (action === 'receive') {
                    banano.receiveBananos(seed, seedIndex);
                    const info = banano.getAccountInfo(account);
                    if (!info.error) {
                        balance = banano.getDecimalFromRaw(info.balance || "0");
                        pending = banano.getDecimalFromRaw(info.pending || "0");
                    }
                    success = "Receive attempt complete. Checked balance.";
                } 
                else if (action === 'send') {
                    const destination = _body.destination;
                    const amountRaw = banano.getRawFromDecimal(_body.amount || "0");
                    
                    if (!destination) throw new Error("Destination address required.");
                    if (amountRaw === "0") throw new Error("Positive amount required.");

                    const sendResult = banano.sendBanano(seed, seedIndex, destination, amountRaw);
                    if (sendResult) {
                       success = `Sent successfully! Block Hash: ${sendResult}`;
                    } else {
                       throw new Error("Failed to send transaction.");
                    }

                    const info = banano.getAccountInfo(account);
                    if (!info.error) {
                        balance = banano.getDecimalFromRaw(info.balance || "0");
                        pending = banano.getDecimalFromRaw(info.pending || "0");
                    }
                }
            } else {
                error = "Invalid seed length. It must be a 64-character hex string.";
            }
        }
    }
} catch (e) {
    error = "Script Error: " + (e.message || String(e));
}

</script>

<div class="min-h-screen border-b-8 border-neutral bg-base-200 py-12 lg:py-24">
    <div class="container mx-auto max-w-5xl px-4">
        <!-- Stark Header -->
        <div class="mb-12">
            <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter bg-base-100 text-base-content inline-block border-4 border-neutral px-6 py-2 shadow-[8px_8px_0_0_rgba(0,0,0,1)] transform -rotate-1">
                Banano Wallet
            </h1>
            <p class="text-xl font-bold text-base-content/70 mt-4 max-w-xl">
                Check available Banano balance, pending transactions, or transact directly.
            </p>
        </div>

        <hr class="border-t-8 border-neutral mb-12">

        <% if (error) { %>
            <div class="bg-error text-error-content border-4 border-neutral p-6 font-black text-lg uppercase shadow-[6px_6px_0_0_rgba(0,0,0,1)] mb-12 transform -rotate-1 max-w-3xl mx-auto flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="break-words w-full"><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="bg-success text-success-content border-4 border-neutral p-6 font-black text-lg uppercase shadow-[6px_6px_0_0_rgba(0,0,0,1)] mb-12 transform rotate-1 max-w-3xl mx-auto flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span class="break-words w-full"><%= success %></span>
            </div>
        <% } %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
            
            <!-- Left Column -->
            <div class="flex flex-col gap-8">
                <!-- Check Balance Card -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)]">
                    <h2 class="text-2xl font-black uppercase text-base-content border-b-4 border-neutral pb-3 mb-6">Check Balance</h2>
                    
                    <form method="POST" class="space-y-4">
                        <input type="hidden" name="action" value="check">
                        
                        <div class="form-control space-y-1.5">
                            <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Wallet Address</label>
                            <input type="text" name="account" placeholder="ban_..." value="<%= account %>" class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm font-mono" required/>
                        </div>
                        
                        <button class="w-full bg-primary text-primary-content border-4 border-neutral font-black text-lg uppercase py-3 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all">Lookup Balance</button>
                    </form>
                </div>

                <!-- Account Overview Card -->
                <% if (account) { %>
                    <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)]">
                        <h2 class="text-2xl font-black uppercase text-base-content border-b-4 border-neutral pb-3 mb-6">Account Overview</h2>
                        
                        <div class="grid grid-cols-2 border-4 border-neutral bg-base-200 shadow-[4px_4px_0_0_rgba(0,0,0,1)] divide-x-4 divide-neutral mb-6">
                            <div class="p-4 text-center">
                                <span class="block text-xs font-black uppercase text-neutral/50 mb-1">Balance</span>
                                <span class="text-2xl font-black text-primary font-mono"><%= balance %></span>
                                <span class="block text-[10px] font-black uppercase text-neutral/40 mt-1">BAN</span>
                            </div>
                            <div class="p-4 text-center">
                                <span class="block text-xs font-black uppercase text-warning mb-1">Pending</span>
                                <span class="text-2xl font-black text-warning font-mono"><%= pending %></span>
                                <span class="block text-[10px] font-black uppercase text-neutral/40 mt-1">BAN</span>
                            </div>
                        </div>

                        <div class="bg-base-200 border-2 border-neutral p-4 shadow-[2px_2px_0_0_rgba(0,0,0,1)]">
                            <span class="text-xs font-black uppercase text-base-content/60 block mb-1">Address:</span>
                            <span class="font-mono text-xs break-all font-bold text-secondary select-all"><%= account %></span>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Right Column: Wallet Actions -->
            <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)]">
                <h2 class="text-2xl font-black uppercase text-base-content border-b-4 border-neutral pb-3 mb-6">Transact</h2>
                
                <div class="space-y-6">
                    <!-- Common Transact Inputs -->
                    <div class="form-control space-y-1.5">
                        <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Seed (64 hex characters)</label>
                        <input type="password" id="transactSeed" value="<%= seed %>" placeholder="e.g. 0A1B2C..." class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm font-mono" />
                    </div>
                    <div class="form-control space-y-1.5">
                        <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Seed Index</label>
                        <input type="number" id="transactIndex" value="<%= seedIndex %>" min="0" class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm" />
                    </div>

                    <!-- Receive Button Form -->
                    <form method="POST" class="w-full pt-4 border-t-2 border-neutral/10" onsubmit="this.seed.value = document.getElementById('transactSeed').value; this.seedIndex.value = document.getElementById('transactIndex').value;">
                        <input type="hidden" name="action" value="receive">
                        <input type="hidden" name="seed" value="">
                        <input type="hidden" name="seedIndex" value="">
                        
                        <button class="w-full bg-success text-success-content border-4 border-neutral font-black text-lg uppercase py-3 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M14.707 10.293a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 111.414-1.414L9 12.586V5a1 1 0 012 0v7.586l2.293-2.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                            Receive Pending
                        </button>
                        <p class="text-[10px] font-bold text-base-content/50 mt-1.5">Requires matching seed to sign the transaction.</p>
                    </form>

                    <!-- Send Form -->
                    <form method="POST" class="w-full space-y-4 pt-4 border-t-2 border-neutral/10" onsubmit="this.seed.value = document.getElementById('transactSeed').value; this.seedIndex.value = document.getElementById('transactIndex').value;">
                        <input type="hidden" name="action" value="send">
                        <input type="hidden" name="seed" value="">
                        <input type="hidden" name="seedIndex" value="">
                        
                        <div class="form-control space-y-1.5">
                            <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Recipient Address</label>
                            <input type="text" name="destination" placeholder="ban_..." class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm font-mono" required/>
                        </div>
                        <div class="form-control space-y-1.5">
                            <label class="block text-xs font-black uppercase tracking-wider text-base-content/70">Amount (BAN)</label>
                            <input type="number" step="0.000001" name="amount" placeholder="0.00" class="input border-4 border-neutral w-full bg-base-100 font-bold p-3 rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)] focus:translate-y-[1px] focus:shadow-[1px_1px_0_0_rgba(0,0,0,1)] transition-all text-sm font-mono" required/>
                        </div>

                        <button class="w-full bg-primary text-primary-content border-4 border-neutral font-black text-lg uppercase py-3 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 9.707a1 1 0 010-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 01-1.414 1.414L11 7.414V15a1 1 0 11-2 0V7.414L6.707 9.707a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                            </svg>
                            Send from Seed
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
