<!-- Main Container -->
<div class="min-h-screen bg-base-100 py-12">
    <!-- Alpine.js Page Context -->
    <div class="container mx-auto px-4 md:px-8 max-w-6xl" 
         x-data="{ 
            activeTab: 'all', 
            search: '', 
            showAddressId: null,
            supportModalOpen: false,
            supportOrderNum: '',
            toggleAddress(id) {
                this.showAddressId = this.showAddressId === id ? null : id;
            },
            openSupport(orderId) {
                this.supportOrderNum = orderId;
                this.supportModalOpen = true;
            },
            shouldShow(id, status, itemsText) {
                let tabMatch = false;
                if (this.activeTab === 'all') {
                    tabMatch = true;
                } else if (this.activeTab === 'progress') {
                    tabMatch = ['pending', 'paid', 'processing', 'shipped'].includes(status);
                } else if (this.activeTab === 'completed') {
                    tabMatch = (status === 'delivered');
                } else if (this.activeTab === 'cancelled') {
                    tabMatch = ['cancelled', 'refunded'].includes(status);
                }

                let searchMatch = true;
                if (this.search.trim() !== '') {
                    const q = this.search.toLowerCase();
                    searchMatch = id.toLowerCase().includes(q) || itemsText.toLowerCase().includes(q);
                }

                return tabMatch && searchMatch;
            }
         }">

        <!-- Breadcrumbs -->
        <div class="text-xs text-base-content/60 font-medium mb-6 flex items-center gap-2">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span>/</span>
            <span class="text-base-content/90 font-semibold">Your Account</span>
        </div>

        <!-- Page Hero Header -->
        <div class="mb-8 pb-6 border-b border-slate-200 dark:border-slate-800 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
                    Your Account
                </h1>
                <p class="text-sm text-base-content/60 mt-1">
                    Manage your orders, addresses, profile settings, and payment options.
                </p>
            </div>
            <a href="/shop" class="btn btn-primary btn-sm rounded-xl font-semibold px-5">
                Browse Shop Catalog →
            </a>
        </div>

        <!-- Profile Summary Card -->
        <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-sm mb-10 flex flex-col md:flex-row items-center md:items-start gap-6">
            <div class="flex-shrink-0">
                <div class="w-24 h-24 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden bg-base-200 relative">
                    <% if (data.profile.getString('avatar')) { %>
                        <img src="<%= '/api/files/' + data.profile.collection().id + '/' + data.profile.id + '/' + data.profile.getString('avatar') %>"
                             alt="Avatar" class="w-full h-full object-cover" />
                    <% } else { %>
                        <div class="w-full h-full bg-primary text-primary-content font-extrabold text-3xl flex items-center justify-center">
                            <%= data.profile.email().slice(0, 1).toUpperCase() %>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="flex-grow text-center md:text-left space-y-3">
                <div class="flex flex-col md:flex-row items-center md:items-baseline gap-3">
                    <h2 class="text-2xl font-bold text-base-content tracking-tight">
                        <%= data.profile.getString('name') || data.profile.email().split('@')[0] %>
                    </h2>
                    <% if (data.profile.getString('shortHand')) { %>
                        <span class="px-2.5 py-0.5 rounded-full bg-primary/10 text-primary font-semibold text-xs">
                            @<%= data.profile.getString('shortHand') %>
                        </span>
                    <% } %>
                </div>
                <p class="text-xs text-base-content/60 font-mono">
                    <%= data.profile.email() %>
                </p>

                <% if (data.profile.getString('bio')) { %>
                    <p class="text-xs text-base-content/80 italic max-w-xl">
                        "<%= data.profile.getString('bio') %>"
                    </p>
                <% } %>

                <div class="flex flex-wrap gap-3 items-center justify-center md:justify-start pt-1 text-xs">
                    <span class="text-base-content/50 font-medium">
                        Member since <%= data.formatDateTime(data.profile.getString('created')) %>
                    </span>
                    <a href="/profile/edit" class="btn btn-outline btn-xs rounded-lg font-semibold px-3 border-slate-300 dark:border-slate-700">
                        Edit Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- 2x2 Navigation Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-12">
            <!-- Card 1: Your Orders -->
            <a href="#order-history" class="group bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        📦
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-lg font-bold text-base-content group-hover:text-primary transition-colors">Your Orders</h3>
                        <p class="text-xs text-base-content/60 leading-relaxed">Track packages, review order history, and buy items again.</p>
                    </div>
                </div>
            </a>

            <!-- Card 2: Login & Security -->
            <a href="/profile/edit" class="group bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        🔒
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-lg font-bold text-base-content group-hover:text-primary transition-colors">Login & Security</h3>
                        <p class="text-xs text-base-content/60 leading-relaxed">Update password, email address, name, and security preferences.</p>
                    </div>
                </div>
            </a>

            <!-- Card 3: Address Book -->
            <a href="/account/addresses" class="group bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        📍
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-lg font-bold text-base-content group-hover:text-primary transition-colors">Address Book</h3>
                        <p class="text-xs text-base-content/60 leading-relaxed">Add, edit, or remove saved shipping and billing addresses.</p>
                    </div>
                </div>
            </a>

            <!-- Card 4: Payment Ledger -->
            <a href="/banano" class="group bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl flex-shrink-0 group-hover:scale-105 transition-transform">
                        🍌
                    </div>
                    <div class="space-y-1">
                        <h3 class="text-lg font-bold text-base-content group-hover:text-primary transition-colors">Payment Ledger</h3>
                        <p class="text-xs text-base-content/60 leading-relaxed">Check available Banano crypto balance and deposit history.</p>
                    </div>
                </div>
            </a>
        </div>

        <div class="divider my-8" id="order-history"></div>

        <!-- Order History Section -->
        <div class="space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="text-2xl font-bold text-base-content tracking-tight">Order History</h2>
                    <p class="text-xs text-base-content/60 mt-0.5">Review your past transactions and track current shipments</p>
                </div>

                <!-- Search Input -->
                <div class="w-full sm:w-72">
                    <div class="relative">
                        <input type="text" 
                               x-model="search"
                               placeholder="Search order ID or item..." 
                               class="input input-sm input-bordered w-full rounded-xl pl-9 bg-base-100 text-xs font-medium focus:ring-1 focus:ring-primary" />
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3 top-2.5 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Filter Tabs -->
            <div class="flex flex-wrap gap-2">
                <button x-on:click="activeTab = 'all'"
                        :class="activeTab === 'all' ? 'btn-primary' : 'btn-ghost text-base-content/70 hover:bg-base-200'"
                        class="btn btn-xs rounded-full font-semibold px-4 transition-all">
                    All Orders
                </button>
                <button x-on:click="activeTab = 'progress'"
                        :class="activeTab === 'progress' ? 'btn-primary' : 'btn-ghost text-base-content/70 hover:bg-base-200'"
                        class="btn btn-xs rounded-full font-semibold px-4 transition-all">
                    In Progress
                </button>
                <button x-on:click="activeTab = 'completed'"
                        :class="activeTab === 'completed' ? 'btn-primary' : 'btn-ghost text-base-content/70 hover:bg-base-200'"
                        class="btn btn-xs rounded-full font-semibold px-4 transition-all">
                    Completed
                </button>
                <button x-on:click="activeTab = 'cancelled'"
                        :class="activeTab === 'cancelled' ? 'btn-primary' : 'btn-ghost text-base-content/70 hover:bg-base-200'"
                        class="btn btn-xs rounded-full font-semibold px-4 transition-all">
                    Cancelled
                </button>
            </div>

            <!-- Orders Feed / Cards -->
            <div class="space-y-6">
                <% if (data.orders && data.orders.length > 0) { %>
                    <% data.orders.forEach(order => { 
                        const itemsText = order.items.map(i => i.product_name).join(', ');
                    %>
                        <!-- Single Order Card -->
                        <div x-show="shouldShow('<%= order.id %>', '<%= order.status %>', '<%= itemsText.replace(/'/g, "\\'") %>')" 
                             x-transition
                             class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl overflow-hidden shadow-sm">
                            
                            <!-- Card Header Info -->
                            <div class="bg-base-200/50 border-b border-slate-100 dark:border-slate-800 p-4 grid grid-cols-2 md:grid-cols-4 gap-4 text-xs">
                                <div>
                                    <span class="text-base-content/50 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Order Date</span>
                                    <span class="font-semibold text-base-content"><%= data.formatDateTime(order.created) %></span>
                                </div>
                                <div>
                                    <span class="text-base-content/50 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Total Amount</span>
                                    <span class="font-bold text-base-content">$<%= order.total.toFixed(2) %></span>
                                </div>
                                <div>
                                    <span class="text-base-content/50 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Shipping Address</span>
                                    <button x-on:click="toggleAddress('<%= order.id %>')" 
                                            class="text-primary hover:underline font-semibold flex items-center gap-1 cursor-pointer">
                                        <%= order.shipping_address?.name || data.profile.getString('name') || 'Recipient' %>
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                        </svg>
                                    </button>
                                </div>
                                <div class="text-right">
                                    <span class="text-base-content/50 block text-[10px] uppercase font-bold tracking-wider mb-0.5">Order ID</span>
                                    <span class="font-mono text-xs text-base-content/80 select-all"><%= order.id %></span>
                                </div>
                            </div>

                            <!-- Address Drawer -->
                            <div x-show="showAddressId === '<%= order.id %>'" 
                                 x-transition 
                                 class="p-4 bg-base-200/80 border-b border-slate-100 dark:border-slate-800 text-xs">
                                <h4 class="font-bold text-xs text-base-content mb-1">Shipping Details:</h4>
                                <% if (order.shipping_address) { %>
                                    <p class="text-base-content/80 font-medium leading-relaxed">
                                        <%= order.shipping_address.name || 'Recipient' %><br>
                                        <%= order.shipping_address.street || order.shipping_address.address || '' %><br>
                                        <%= order.shipping_address.city || '' %>, <%= order.shipping_address.state || '' %> <%= order.shipping_address.postal_code || order.shipping_address.zip || '' %><br>
                                        <%= order.shipping_address.country || 'Canada' %>
                                    </p>
                                <% } else { %>
                                    <p class="text-base-content/50 italic">No address on file.</p>
                                <% } %>
                            </div>

                            <!-- Card Body Grid -->
                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 p-5">
                                <!-- Order Line Items -->
                                <div class="lg:col-span-2 space-y-3">
                                    <% if (order.items && order.items.length > 0) { %>
                                        <% order.items.forEach(item => { %>
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3 bg-base-200/30 rounded-2xl gap-3">
                                                <div class="space-y-0.5">
                                                    <h4 class="font-bold text-sm text-base-content hover:text-primary transition-colors">
                                                        <%= item.product_name %>
                                                    </h4>
                                                    
                                                    <% if (item.variant_label) { %>
                                                        <span class="inline-block bg-primary/10 text-primary text-[10px] font-semibold px-2 py-0.5 rounded-full">
                                                            <%= item.variant_label %>
                                                        </span>
                                                    <% } %>

                                                    <p class="text-xs text-base-content/60 font-medium">
                                                        Qty: <strong class="text-base-content"><%= item.quantity %></strong> &bull; 
                                                        Unit: $<%= item.unit_price.toFixed(2) %>
                                                    </p>
                                                </div>

                                                <div class="flex sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-2">
                                                    <span class="font-bold text-sm text-base-content">
                                                        $<%= item.total_price.toFixed(2) %>
                                                    </span>
                                                    <a href="/shop" class="btn btn-outline btn-xs rounded-lg font-semibold text-[10px] border-slate-300 dark:border-slate-700">
                                                        Buy Again
                                                    </a>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-xs font-medium text-base-content/50 italic">No line items recorded for this order.</p>
                                    <% } %>
                                </div>

                                <!-- Financial Breakdown & Status -->
                                <div class="bg-base-200/50 rounded-2xl p-4 flex flex-col justify-between space-y-4">
                                    <div class="space-y-3">
                                        <!-- Status Badge -->
                                        <div>
                                            <span class="text-[10px] uppercase font-bold tracking-wider text-base-content/50 block mb-1">Status</span>
                                            <% 
                                                let badgeClass = 'badge-warning';
                                                if (order.status === 'delivered') badgeClass = 'badge-success';
                                                else if (['paid', 'processing'].includes(order.status)) badgeClass = 'badge-info';
                                                else if (order.status === 'shipped') badgeClass = 'badge-primary';
                                                else if (['cancelled', 'refunded'].includes(order.status)) badgeClass = 'badge-error';
                                            %>
                                            <span class="badge <%= badgeClass %> font-semibold uppercase text-[10px] px-3 py-2">
                                                <%= order.status %>
                                            </span>
                                        </div>

                                        <!-- Pricing Breakdown -->
                                        <div class="space-y-1 text-xs font-medium text-base-content/80 pt-2 border-t border-slate-200 dark:border-slate-700">
                                            <div class="flex justify-between">
                                                <span>Subtotal:</span>
                                                <span>$<%= order.subtotal.toFixed(2) %></span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span>Shipping:</span>
                                                <span>$<%= order.shipping_cost.toFixed(2) %></span>
                                            </div>
                                            <div class="flex justify-between text-sm font-bold text-base-content pt-1 border-t border-slate-200 dark:border-slate-700">
                                                <span>Total:</span>
                                                <span>$<%= order.total.toFixed(2) %></span>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Quick Actions -->
                                    <div class="space-y-2 pt-2">
                                        <button x-on:click="openSupport('<%= order.id %>')" class="btn btn-outline btn-xs w-full rounded-lg font-semibold text-xs border-slate-300 dark:border-slate-700">
                                            Support
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <!-- Empty Orders State -->
                    <div class="bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 text-center max-w-xl mx-auto shadow-sm space-y-4">
                        <div class="w-16 h-16 rounded-full bg-base-200 text-base-content/40 flex items-center justify-center mx-auto text-2xl">
                            📦
                        </div>
                        <h3 class="text-xl font-bold text-base-content">No Orders Placed Yet</h3>
                        <p class="text-xs text-base-content/60 max-w-sm mx-auto">
                            When you place an order in our store, your order status and receipts will appear here.
                        </p>
                        <a href="/shop" class="btn btn-primary btn-sm rounded-xl font-semibold px-6">
                            Start Shopping
                        </a>
                    </div>
                <% } %>
            </div>
        </div>

        <!-- Support Modal -->
        <div x-show="supportModalOpen" 
             x-transition
             class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
             x-cloak>
            <div x-on:click.outside="supportModalOpen = false"
                 class="bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-md w-full p-6 shadow-xl relative space-y-4">
                <button x-on:click="supportModalOpen = false" class="btn btn-sm btn-circle btn-ghost absolute top-4 right-4">
                    ✕
                </button>
                <h3 class="text-xl font-bold text-base-content">Customer Support</h3>
                <p class="text-xs text-base-content/60 font-mono">
                    Order Ref: <span x-text="supportOrderNum" class="text-base-content font-bold"></span>
                </p>
                <p class="text-sm text-base-content/80 leading-relaxed">
                    Have questions about your delivery or need to make changes to your order? Contact our support team directly.
                </p>
                <div class="flex gap-3 pt-2">
                    <a :href="'mailto:support@pocketcommerce.com?subject=Support Request for Order ' + supportOrderNum"
                       class="btn btn-primary btn-sm flex-1 rounded-xl font-semibold">
                        Email Support
                    </a>
                    <button x-on:click="supportModalOpen = false" class="btn btn-ghost btn-sm rounded-xl font-semibold">
                        Close
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>
