<!-- Main Container -->
<div class="min-h-screen bg-base-100 py-12"
     x-data="{
        modalOpen: false,
        deleteModalOpen: false,
        isEdit: false,
        formId: '',
        formStreet: '',
        formCity: '',
        formState: '',
        formZip: '',
        formCountry: 'Canada',
        formIsDefault: false,
        deleteId: '',

        openAddModal() {
            this.isEdit = false;
            this.formId = '';
            this.formStreet = '';
            this.formCity = '';
            this.formState = '';
            this.formZip = '';
            this.formCountry = 'Canada';
            this.formIsDefault = false;
            this.modalOpen = true;
        },

        openEditModal(addr) {
            this.isEdit = true;
            this.formId = addr.id;
            this.formStreet = addr.street;
            this.formCity = addr.city;
            this.formState = addr.state;
            this.formZip = addr.zip;
            this.formCountry = addr.country;
            this.formIsDefault = addr.is_default;
            this.modalOpen = true;
        },

        openDeleteModal(id) {
            this.deleteId = id;
            this.deleteModalOpen = true;
        }
     }">

    <div class="container mx-auto px-4 md:px-8 max-w-6xl">
        
        <!-- Breadcrumbs -->
        <div class="text-xs text-base-content/60 font-medium mb-6 flex items-center gap-2">
            <a href="/" class="hover:text-primary transition-colors">Home</a>
            <span>/</span>
            <a href="/account" class="hover:text-primary transition-colors">Your Account</a>
            <span>/</span>
            <span class="text-base-content/90 font-semibold">Addresses</span>
        </div>

        <!-- Header -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
                    Your Saved Addresses
                </h1>
                <p class="text-sm text-base-content/60 mt-1">
                    Manage your delivery addresses for quick checkouts.
                </p>
            </div>
            
            <a href="/account" class="btn btn-outline btn-sm rounded-xl font-semibold border-slate-300 dark:border-slate-700">
                ← Back to Account
            </a>
        </div>

        <!-- Addresses Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            
            <!-- Add Address Card (First) -->
            <div x-on:click="openAddModal()"
                 class="bg-base-100 border-2 border-dashed border-slate-300 dark:border-slate-700 rounded-3xl p-8 flex flex-col items-center justify-center text-center cursor-pointer hover:border-primary transition-all shadow-xs hover:shadow-md min-h-[260px]">
                <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-4">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                </div>
                <h3 class="text-lg font-bold text-base-content">Add New Address</h3>
                <p class="text-xs text-base-content/60 mt-1 max-w-[200px]">
                    Set up a new shipping or billing address for fast checkout.
                </p>
            </div>

            <!-- User Address Cards -->
            <% if (data.addresses && data.addresses.length > 0) { %>
                <% data.addresses.forEach(addr => { %>
                    <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 shadow-sm flex flex-col justify-between min-h-[260px] <%= addr.is_default ? 'ring-1 ring-primary/30 bg-primary/5' : '' %>">
                        
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold uppercase tracking-wider text-base-content/50">
                                    Shipping Destination
                                </span>
                                
                                <% if (addr.is_default) { %>
                                    <span class="badge badge-success text-success-content font-bold uppercase text-[10px] px-2.5 py-1">
                                        Default
                                    </span>
                                <% } %>
                            </div>

                            <div class="space-y-1 text-sm font-medium text-base-content">
                                <p class="font-bold text-base text-base-content"><%= addr.street %></p>
                                <p class="text-xs text-base-content/80"><%= addr.city %><% if (addr.state) { %>, <%= addr.state %><% } %> <%= addr.zip %></p>
                                <p class="text-xs text-base-content/60 font-semibold uppercase"><%= addr.country %></p>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="pt-4 border-t border-slate-100 dark:border-slate-800 space-y-2 mt-4">
                            <div class="flex gap-2">
                                <button x-on:click="openEditModal(<%= JSON.stringify(addr) %>)" class="btn btn-outline btn-xs flex-1 rounded-lg font-semibold border-slate-300 dark:border-slate-700">
                                    Edit
                                </button>
                                
                                <button x-on:click="openDeleteModal('<%= addr.id %>')" class="btn btn-ghost btn-xs text-error rounded-lg font-semibold hover:bg-error/10">
                                    Delete
                                </button>
                            </div>

                            <% if (!addr.is_default) { %>
                                <form action="/account/addresses" method="POST">
                                    <input type="hidden" name="action" value="set_default">
                                    <input type="hidden" name="id" value="<%= addr.id %>">
                                    <button type="submit" class="btn btn-primary btn-xs w-full rounded-lg font-semibold">
                                        Set as Default
                                    </button>
                                </form>
                            <% } %>
                        </div>
                        
                    </div>
                <% }) %>
            <% } %>

        </div>

    </div>

    <!-- Add / Edit Address Modal -->
    <div x-show="modalOpen" 
         x-transition
         class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
         x-cloak>
        
        <div x-on:click.outside="modalOpen = false"
             class="bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-xl relative max-h-[90vh] overflow-y-auto space-y-6">
            
            <button x-on:click="modalOpen = false" class="btn btn-sm btn-circle btn-ghost absolute top-4 right-4">
                ✕
            </button>

            <h3 class="text-xl font-bold text-base-content" x-text="isEdit ? 'Edit Address' : 'Add New Address'"></h3>

            <form action="/account/addresses" method="POST" class="space-y-4">
                <input type="hidden" name="action" :value="isEdit ? 'update' : 'add'">
                <input type="hidden" name="id" :value="formId">

                <div class="space-y-1">
                    <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">Street Address</label>
                    <input type="text" name="street" x-model="formStreet" required placeholder="123 Main St, Apt 4B" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">City</label>
                        <input type="text" name="city" x-model="formCity" required placeholder="Toronto" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">State / Province</label>
                        <input type="text" name="state" x-model="formState" placeholder="ON" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="space-y-1">
                        <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">ZIP / Postal Code</label>
                        <input type="text" name="zip" x-model="formZip" required placeholder="M5V 2T6" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                    </div>

                    <div class="space-y-1">
                        <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">Country</label>
                        <select name="country" x-model="formCountry" required class="select select-sm select-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary">
                            <option value="Canada">Canada</option>
                            <option value="United States">United States</option>
                            <option value="United Kingdom">United Kingdom</option>
                            <option value="Australia">Australia</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="flex items-center gap-2 pt-2">
                    <input type="checkbox" id="is_default_checkbox" name="is_default" x-model="formIsDefault" class="checkbox checkbox-xs checkbox-primary rounded" />
                    <label for="is_default_checkbox" class="text-xs font-semibold text-base-content/80 cursor-pointer">
                        Set as my default shipping address
                    </label>
                </div>

                <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-800">
                    <button type="submit" class="btn btn-primary btn-sm flex-1 rounded-xl font-semibold">
                        Save Address
                    </button>
                    <button type="button" x-on:click="modalOpen = false" class="btn btn-ghost btn-sm rounded-xl font-semibold">
                        Cancel
                    </button>
                </div>

            </form>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div x-show="deleteModalOpen" 
         x-transition
         class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4"
         x-cloak>
        
        <div x-on:click.outside="deleteModalOpen = false"
             class="bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl max-w-md w-full p-6 shadow-xl relative space-y-4">
            
            <h3 class="text-xl font-bold text-base-content">Delete Address?</h3>
            <p class="text-xs text-base-content/70 leading-relaxed">
                Are you sure you want to delete this address from your saved address book?
            </p>

            <form action="/account/addresses" method="POST" class="pt-2">
                <input type="hidden" name="action" value="delete">
                <input type="hidden" name="id" :value="deleteId">

                <div class="flex gap-3">
                    <button type="submit" class="btn btn-error btn-sm flex-1 rounded-xl font-semibold">
                        Delete
                    </button>
                    <button type="button" x-on:click="deleteModalOpen = false" class="btn btn-ghost btn-sm rounded-xl font-semibold">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
