<div class="min-h-screen bg-base-100 py-12">
    <div class="container mx-auto max-w-7xl px-4 md:px-8">
        
        <!-- DaisyUI Breadcrumbs -->
        <div class="breadcrumbs text-xs mb-4">
            <ul>
                <li><a href="/" class="hover:text-primary">Home</a></li>
                <li><a href="/shop" class="hover:text-primary">Shop</a></li>
                <li class="font-bold text-base-content">Cart</li>
            </ul>
        </div>

        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
                    Shopping Cart
                </h1>
                <p class="text-sm text-base-content/60 mt-1">
                    Review your items before proceeding to checkout.
                </p>
            </div>
            <% if (data.cartItems && data.cartItems.length > 0) { %>
                <form action="/cart" method="POST">
                    <input type="hidden" name="action" value="clear">
                    <button type="submit" class="btn btn-ghost btn-sm text-error font-semibold rounded-xl hover:bg-error/10">
                        Clear Cart
                    </button>
                </form>
            <% } %>
        </div>

        <% if (!data.cartItems || data.cartItems.length === 0) { %>
            <!-- DaisyUI Empty Cart Alert Card -->
            <div class="card bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 text-center max-w-xl mx-auto my-12 shadow-sm space-y-4">
                <div class="w-20 h-20 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-base-content">Your Shopping Cart is Empty</h2>
                <p class="text-xs text-base-content/60 max-w-md mx-auto">
                    Looks like you haven't added any cards or products yet. Explore our store collection!
                </p>
                <div class="card-actions justify-center pt-2">
                    <a href="/shop" class="btn btn-primary rounded-xl font-semibold px-8 shadow-sm">
                        Start Shopping →
                    </a>
                </div>
            </div>
        <% } else { %>
            <!-- Grid Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                
                <!-- Left: Cart Items List (2/3 width) -->
                <div class="lg:col-span-2 space-y-4">
                    <% data.cartItems.forEach(item => { %>
                        <div class="card card-side bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-2xl p-4 shadow-sm flex-col sm:flex-row gap-5 items-start sm:items-center">
                            <!-- Product Image -->
                            <figure class="w-24 h-24 rounded-xl border border-slate-200 dark:border-slate-800 bg-base-200 flex-shrink-0 overflow-hidden my-auto">
                                <img src="<%= item.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                            </figure>

                            <!-- Item Info -->
                            <div class="card-body p-0 flex-1 min-w-0 space-y-1">
                                <a href="/shop/card/<%= item.productSlug.replace(/\s+/g, '-') %>/<%= item.productId %>" class="card-title text-base font-bold text-base-content hover:text-primary transition-colors line-clamp-1">
                                    <%= item.productName %>
                                </a>
                                
                                <%
                                    let variantLabel = item.sku;
                                    if (item.attributes && typeof item.attributes === 'object') {
                                        const keys = Object.keys(item.attributes);
                                        if (keys.length > 0) {
                                            variantLabel = keys.map(k => `${k}: ${item.attributes[k]}`).join(', ');
                                        }
                                    }
                                %>
                                <div>
                                    <span class="badge badge-sm badge-outline badge-primary font-semibold text-[10px]">
                                        <%= variantLabel %>
                                    </span>
                                </div>
                                <p class="text-sm font-semibold text-base-content pt-1">
                                    $<%= item.price.toFixed(2) %> each
                                </p>
                            </div>

                            <!-- DaisyUI Join Quantity Modifier & Subtotal -->
                            <div class="flex items-center gap-6 w-full sm:w-auto justify-between sm:justify-end border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-100 dark:border-slate-800">
                                <form action="/cart" method="POST" class="join border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden">
                                    <input type="hidden" name="action" value="update">
                                    <input type="hidden" name="item_id" value="<%= item.id %>">
                                    
                                    <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="btn btn-xs btn-ghost join-item px-3" aria-label="Decrease quantity">-</button>
                                    <span class="join-item px-3 py-1 text-xs font-extrabold flex items-center bg-base-100"><%= item.quantity %></span>
                                    <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="btn btn-xs btn-ghost join-item px-3" aria-label="Increase quantity" <%= item.quantity >= item.stock ? 'disabled' : '' %>>+</button>
                                </form>

                                <div class="text-right">
                                    <span class="text-base font-extrabold text-base-content block">
                                        $<%= item.total.toFixed(2) %>
                                    </span>
                                </div>

                                <!-- Delete Form -->
                                <form action="/cart" method="POST">
                                    <input type="hidden" name="action" value="delete">
                                    <input type="hidden" name="item_id" value="<%= item.id %>">
                                    <button type="submit" class="btn btn-ghost btn-circle btn-xs text-error" aria-label="Delete item">
                                        ✕
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Right: Order Summary Sidebar -->
                <%
                    const FREE_SHIPPING_THRESHOLD = 30.00;
                    const shippingCost = data.totalPrice >= FREE_SHIPPING_THRESHOLD ? 0.00 : 4.99;
                    const finalTotal = data.totalPrice + shippingCost;
                    const progressToFree = Math.min((data.totalPrice / FREE_SHIPPING_THRESHOLD) * 100, 100);
                    const amountNeededForFree = FREE_SHIPPING_THRESHOLD - data.totalPrice;
                %>
                <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 shadow-sm sticky top-24 space-y-6">
                    <h3 class="card-title text-xl font-bold text-base-content pb-3 border-b border-slate-100 dark:border-slate-800">
                        Order Summary
                    </h3>

                    <!-- DaisyUI Progress Bar for Free Shipping -->
                    <div class="bg-base-200/50 rounded-2xl p-4 space-y-2">
                        <div class="flex justify-between items-center text-xs font-semibold">
                            <span>
                                <% if (shippingCost === 0) { %>
                                    Free Express Shipping Unlocked!
                                <% } else { %>
                                    Shipping Progress
                                <% } %>
                            </span>
                            <% if (shippingCost > 0) { %>
                                <span class="text-primary font-bold">$<%= amountNeededForFree.toFixed(2) %> away</span>
                            <% } %>
                        </div>
                        <progress class="progress progress-primary w-full h-2" value="<%= progressToFree %>" max="100"></progress>
                    </div>

                    <!-- Breakdown -->
                    <div class="space-y-3 text-sm font-medium">
                        <div class="flex justify-between text-base-content/80">
                            <span>Subtotal (<%= data.totalItems %> items)</span>
                            <span class="font-bold text-base-content">$<%= data.totalPrice.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between text-base-content/80">
                            <span>Estimated Shipping</span>
                            <span class="font-bold text-base-content"><%= shippingCost === 0 ? 'FREE' : '$' + shippingCost.toFixed(2) %></span>
                        </div>
                        <div class="divider my-1"></div>
                        <div class="flex justify-between text-base font-extrabold text-base-content">
                            <span>Total</span>
                            <span class="text-xl text-primary">$<%= finalTotal.toFixed(2) %></span>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="card-actions flex-col gap-2 pt-2">
                        <a href="/checkout" class="btn btn-primary btn-lg rounded-xl shadow-md w-full font-bold">
                            Proceed to Checkout →
                        </a>
                        <a href="/shop" class="btn btn-ghost btn-sm rounded-xl w-full text-xs font-semibold text-base-content/70">
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        <% } %>
    </div>
</div>
