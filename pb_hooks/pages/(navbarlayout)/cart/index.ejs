<div class="min-h-screen border-b-8 border-neutral bg-base-200 py-12 lg:py-24">
    <div class="container mx-auto max-w-7xl px-4">
        <!-- Title with custom Neo-Brutalist badge -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
            <div>
                <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-base-content">
                    Shopping Cart
                </h1>
                <p class="text-xl font-bold text-base-content/70 mt-2">
                    Manage your hilarious greeting card selections.
                </p>
            </div>
            <% if (data.cartItems && data.cartItems.length > 0) { %>
                <form action="/cart" method="POST">
                    <input type="hidden" name="action" value="clear">
                    <button type="submit" class="bg-warning text-warning-content border-4 border-neutral font-black text-lg uppercase px-6 py-3 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all">
                        Clear All Items
                    </button>
                </form>
            <% } %>
        </div>

        <% if (!data.cartItems || data.cartItems.length === 0) { %>
            <!-- Empty Cart State -->
            <div class="bg-base-100 border-4 border-neutral p-12 lg:p-24 text-center shadow-[8px_8px_0_0_rgba(0,0,0,1)] max-w-3xl mx-auto my-12">
                <div class="inline-block bg-primary text-primary-content border-4 border-neutral p-6 rounded-full shadow-[4px_4px_0_0_rgba(0,0,0,1)] mb-8 transform -rotate-6">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <h2 class="text-4xl md:text-5xl font-black uppercase text-base-content mb-6">Your Cart is Empty!</h2>
                <p class="text-xl font-medium text-base-content/60 mb-10 max-w-md mx-auto">
                    Looks like you haven't added any card puns to your cart yet. Let's fix that!
                </p>
                <a href="/shop" class="inline-block bg-accent text-accent-content border-4 border-neutral font-black text-2xl uppercase px-10 py-5 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all">
                    Start Shopping
                </a>
            </div>
        <% } else { %>
            <!-- Grid Layout -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
                
                <!-- Left: Cart Items List (2/3 width) -->
                <div class="lg:col-span-2 flex flex-col gap-6">
                    <% data.cartItems.forEach(item => { %>
                        <div class="flex flex-col md:flex-row gap-6 bg-base-100 border-4 border-neutral p-6 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:shadow-[8px_8px_0_0_rgba(0,0,0,1)] transition-all relative overflow-hidden">
                            <!-- Product Image -->
                            <div class="w-full md:w-32 h-36 border-4 border-neutral flex-shrink-0 bg-base-200 overflow-hidden">
                                <img src="<%= item.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                            </div>

                            <!-- Item Info and Controls -->
                            <div class="flex flex-col flex-grow justify-between gap-4">
                                <div class="flex justify-between items-start gap-4">
                                    <div>
                                        <a href="/shop/card/<%= item.productSlug.replace(/\s+/g, '-') %>/<%= item.productId %>" class="text-2xl md:text-3xl font-black uppercase text-base-content hover:text-primary transition-colors">
                                            <%= item.productName %>
                                        </a>
                                        
                                        <%
                                            let variantLabel = item.sku;
                                            if (item.attributes && typeof item.attributes === 'object') {
                                                const keys = Object.keys(item.attributes);
                                                if (keys.length > 0) {
                                                    variantLabel = keys.map(k => `${k}: ${item.attributes[k]}`).join(', ');
                                                }
                                            }
                                        %>
                                        <p class="text-sm font-bold text-neutral-content/60 bg-neutral/10 border border-neutral/20 px-2 py-0.5 inline-block rounded-md uppercase mt-1">
                                            Style: <%= variantLabel %>
                                        </p>
                                    </div>

                                    <!-- Delete Item -->
                                    <form action="/cart" method="POST">
                                        <input type="hidden" name="action" value="delete">
                                        <input type="hidden" name="item_id" value="<%= item.id %>">
                                        <button type="submit" class="bg-error text-error-content border-2 border-neutral p-2 hover:bg-error-focus active:translate-y-[2px] transition-all shadow-[2px_2px_0_0_rgba(0,0,0,1)]" aria-label="Delete item">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>

                                <div class="flex flex-row justify-between items-center mt-auto border-t-2 border-neutral/10 pt-4">
                                    <!-- Price info -->
                                    <div class="text-lg font-bold text-base-content/80">
                                        $<%= item.price.toFixed(2) %> each
                                    </div>

                                    <!-- Quantity Adjustment Form -->
                                    <div class="flex items-center gap-4">
                                        <span class="text-sm font-black uppercase text-base-content/60">Qty</span>
                                        <form action="/cart" method="POST" class="inline-flex items-center border-4 border-neutral bg-base-100 shadow-[2px_2px_0_0_rgba(0,0,0,1)]">
                                            <input type="hidden" name="action" value="update">
                                            <input type="hidden" name="item_id" value="<%= item.id %>">
                                            
                                            <button type="submit" name="quantity" value="<%= item.quantity - 1 %>" class="btn btn-ghost rounded-none border-0 px-3 py-1 font-bold text-xl hover:bg-neutral/10" aria-label="Decrease quantity">-</button>
                                            <span class="w-8 text-center font-black text-lg text-base-content"><%= item.quantity %></span>
                                            <button type="submit" name="quantity" value="<%= item.quantity + 1 %>" class="btn btn-ghost rounded-none border-0 px-3 py-1 font-bold text-xl hover:bg-neutral/10" aria-label="Increase quantity" <%= item.quantity >= item.stock ? 'disabled' : '' %>>+</button>
                                        </form>
                                    </div>

                                    <!-- Total Price for item -->
                                    <div class="text-2xl font-black text-base-content">
                                        $<%= item.total.toFixed(2) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Right: Order Summary Sidebar (1/3 width) -->
                <%
                    const FREE_SHIPPING_THRESHOLD = 35.00;
                    const shippingCost = data.totalPrice >= FREE_SHIPPING_THRESHOLD ? 0.00 : 4.99;
                    const finalTotal = data.totalPrice + shippingCost;
                    const progressToFree = Math.min((data.totalPrice / FREE_SHIPPING_THRESHOLD) * 100, 100);
                    const amountNeededForFree = FREE_SHIPPING_THRESHOLD - data.totalPrice;
                %>
                <div class="bg-base-100 border-4 border-neutral p-6 lg:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] sticky top-24 flex flex-col gap-6">
                    <h3 class="text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4">
                        Order Summary
                    </h3>

                    <!-- Free Shipping Tracker -->
                    <div class="border-2 border-neutral p-4 bg-secondary/10">
                        <div class="flex justify-between items-center mb-2">
                            <span class="font-bold text-sm uppercase">
                                <% if (shippingCost === 0) { %>
                                    🎉 Free Shipping Unlocked!
                                <% } else { %>
                                    🚚 Free Shipping Progress
                                <% } %>
                            </span>
                            <% if (shippingCost > 0) { %>
                                <span class="font-black text-xs">$<%= amountNeededForFree.toFixed(2) %> away</span>
                            <% } %>
                        </div>
                        <div class="w-full bg-neutral/10 h-4 border-2 border-neutral rounded-full overflow-hidden">
                            <div class="bg-primary h-full transition-all duration-300" style="width: <%= progressToFree %>%"></div>
                        </div>
                        <% if (shippingCost > 0) { %>
                            <p class="text-xs font-bold text-base-content/60 mt-2">
                                Add $<%= amountNeededForFree.toFixed(2) %> more to your cart to get FREE SHIPPING!
                            </p>
                        <% } else { %>
                            <p class="text-xs font-bold text-secondary mt-1">Your order qualifies for free shipping!</p>
                        <% } %>
                    </div>

                    <!-- Pricing breakdown -->
                    <div class="flex flex-col gap-4 text-lg font-bold text-base-content/80">
                        <div class="flex justify-between">
                            <span>Subtotal (<%= data.totalItems %> items)</span>
                            <span>$<%= data.totalPrice.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping</span>
                            <span><%= shippingCost === 0 ? 'FREE' : '$' + shippingCost.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between text-base-content border-t-2 border-neutral/10 pt-4">
                            <span>Estimated Tax</span>
                            <span>$0.00</span>
                        </div>
                    </div>

                    <!-- Highlighted Grand Total Card -->
                    <div class="bg-primary text-primary-content border-4 border-neutral p-6 shadow-[6px_6px_0_0_rgba(0,0,0,1)] transform -rotate-1 my-4 flex flex-col items-center">
                        <span class="text-sm font-black uppercase tracking-wider mb-1">Total Price</span>
                        <span class="text-5xl font-black">
                            $<%= finalTotal.toFixed(2) %>
                        </span>
                    </div>

                    <!-- Checkout Actions -->
                    <div class="flex flex-col gap-4">
                        <a href="/checkout" class="block w-full bg-accent text-accent-content border-4 border-neutral font-black text-2xl uppercase py-4 text-center shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all">
                            Proceed to Checkout
                        </a>
                        <a href="/shop" class="block w-full bg-base-100 text-base-content border-4 border-neutral font-black text-lg uppercase py-3 text-center hover:bg-neutral/5 transition-all">
                            Continue Shopping
                        </a>
                    </div>
                </div>

            </div>
        <% } %>
    </div>
</div>
