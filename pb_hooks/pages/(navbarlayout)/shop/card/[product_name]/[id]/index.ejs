<div class="min-h-screen bg-base-100 py-10">
    <% if (data.product) { %>
        <div class="container mx-auto max-w-7xl px-4 md:px-8">
            
            <!-- DaisyUI Breadcrumbs -->
            <div class="breadcrumbs text-xs mb-6">
                <ul>
                    <li><a href="/" class="hover:text-primary">Home</a></li>
                    <li><a href="/shop" class="hover:text-primary">Shop</a></li>
                    <% if (data.product.category) { %>
                        <li><a href="/shop?category=<%= data.product.category.slug %>" class="hover:text-primary"><%= data.product.category.name %></a></li>
                    <% } %>
                    <li class="font-bold text-base-content truncate"><%= data.product.name %></li>
                </ul>
            </div>

            <!-- Main Product Card -->
            <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 lg:p-10 shadow-sm">
                <div class="flex flex-col lg:flex-row gap-12">
                    <!-- Image Gallery -->
                    <div class="w-full lg:w-1/2" x-data="{ activeImage: '<%= data.product.images[0] %>' }">
                        <figure class="border border-slate-200 dark:border-slate-800 bg-base-200/50 aspect-[4/5] rounded-2xl relative overflow-hidden shadow-sm">
                            <img :src="activeImage" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                        </figure>
                        <% if (data.product.images && data.product.images.length > 1) { %>
                            <div class="flex gap-3 mt-4 overflow-x-auto pb-2">
                                <% data.product.images.forEach(img => { %>
                                    <button type="button" 
                                            class="w-20 h-20 rounded-xl overflow-hidden border-2 transition-all flex-shrink-0"
                                            :class="activeImage === '<%= img %>' ? 'border-primary ring-2 ring-primary/20 scale-95' : 'border-transparent opacity-70 hover:opacity-100'"
                                            @click="activeImage = '<%= img %>'">
                                        <img src="<%= img %>" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                                    </button>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Product Info Column -->
                    <div class="w-full lg:w-1/2 flex flex-col justify-between">
                        <div>
                            <% if (data.product.category) { %>
                                <a href="/shop?category=<%= data.product.category.slug %>" class="badge badge-primary font-bold text-xs uppercase tracking-wider mb-4 p-3 shadow-xs">
                                    <%= data.product.category.name %>
                                </a>
                            <% } %>
                            
                            <h1 class="text-3xl sm:text-4xl font-extrabold text-base-content tracking-tight mb-3">
                                <%= data.product.name %>
                            </h1>

                            <!-- DaisyUI Rating Summary -->
                            <div class="flex items-center gap-3 mb-6">
                                <div class="rating rating-sm">
                                    <% if (data.reviews && data.reviews.length > 0) { %>
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <input type="radio" class="mask mask-star-2 bg-amber-400" <%= i <= Math.round(data.averageRating || 0) ? 'checked' : '' %> disabled />
                                        <% } %>
                                    <% } else { %>
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <input type="radio" class="mask mask-star-2 bg-amber-400 opacity-20" disabled />
                                        <% } %>
                                    <% } %>
                                </div>
                                <span class="text-xs font-bold text-base-content/70">
                                    <% if (data.reviews && data.reviews.length > 0) { %>
                                        <%= data.averageRating %> (<%= data.reviews.length %> <%= data.reviews.length === 1 ? 'review' : 'reviews' %>)
                                    <% } else { %>
                                        - (0 reviews)
                                    <% } %>
                                </span>
                            </div>

                            <% 
                                let displayPrice = "Sold Out";
                                const availableVariants = (data.variants || []).filter(v => v.stock > 0);
                                if (availableVariants.length > 0) {
                                    const minPrice = Math.min(...availableVariants.map(v => v.price));
                                    displayPrice = "$" + minPrice.toFixed(2);
                                }
                            %>
                            <div class="flex items-baseline gap-4 mb-6">
                                <span class="text-3xl font-extrabold text-base-content"><%= displayPrice %></span>
                                <% if (availableVariants.length > 0) { %>
                                    <span class="badge badge-success text-success-content font-bold text-xs">In Stock</span>
                                <% } %>
                            </div>

                            <div class="divider my-4"></div>

                            <% if (data.product.description) { %>
                                <div class="prose prose-sm prose-slate max-w-none text-base-content/80 font-normal mb-8 leading-relaxed">
                                    <%- data.product.description %>
                                </div>
                            <% } else { %>
                                <p class="text-sm italic text-base-content/50 mb-8">
                                    A premium quality greeting card printed on sustainable, heavy paper stock. Perfect for making any celebration memorable.
                                </p>
                            <% } %>
                        </div>

                        <%
                            const variantsPayload = availableVariants.map(v => {
                                let label = v.sku || 'Standard';
                                if (v.attributes && typeof v.attributes === 'object') {
                                    const keys = Object.keys(v.attributes);
                                    if (keys.length > 0) {
                                        label = keys.map(k => `${k}: ${v.attributes[k]}`).join(', ');
                                    }
                                }
                                return {
                                    id: v.id,
                                    sku: v.sku,
                                    label: label,
                                    price: v.price
                                };
                            });
                        %>

                        <script>
                            function productCartHandler(variants, productTitle, productImg) {
                                return {
                                    adding: false,
                                    added: false,
                                    errorMessage: '',
                                    variants: variants || [],
                                    productTitle: productTitle || '',
                                    productImg: productImg || '',
                                    async submitCart(e) {
                                        if (this.adding) return;
                                        this.adding = true;
                                        this.errorMessage = '';
                                        const form = e.target;
                                        const formData = new FormData(form);
                                        formData.append('json', '1');

                                        const variantId = formData.get('variant_id');
                                        const quantity = parseInt(formData.get('quantity') || '1', 10);
                                        let selectedVariant = null;
                                        if (this.variants && this.variants.length > 0) {
                                            selectedVariant = this.variants.find(function(v) { return v.id === variantId; }) || this.variants[0];
                                        }

                                        try {
                                            const res = await fetch('/cart?json=1', {
                                                method: 'POST',
                                                headers: {
                                                    'Accept': 'application/json',
                                                    'X-Requested-With': 'XMLHttpRequest'
                                                },
                                                body: formData
                                            });

                                            let result = null;
                                            const rawText = await res.text();
                                            try {
                                                result = JSON.parse(rawText);
                                            } catch (_) {
                                                result = {
                                                    success: res.ok,
                                                    message: res.ok ? 'Added to cart' : 'Failed to add item to cart'
                                                };
                                            }

                                            if (result && result.success) {
                                                this.added = true;
                                                window.dispatchEvent(new CustomEvent('cart-updated', {
                                                    detail: {
                                                        totalItems: result.totalItems,
                                                        totalPrice: result.totalPrice,
                                                        items: result.items,
                                                        openSideCart: true,
                                                        item: {
                                                            name: this.productTitle,
                                                            image: this.productImg,
                                                            quantity: quantity,
                                                            variantId: variantId,
                                                            variantLabel: selectedVariant ? selectedVariant.label : '',
                                                            price: selectedVariant ? selectedVariant.price : 0
                                                        }
                                                    }
                                                }));
                                                setTimeout(() => {
                                                    this.added = false;
                                                }, 2500);
                                            } else {
                                                this.errorMessage = (result && result.message) || 'Failed to add item to cart.';
                                            }
                                        } catch (err) {
                                            console.error('Error adding to cart:', err);
                                            this.errorMessage = (err && err.message) ? err.message : 'Error adding item to cart. Please try again.';
                                        } finally {
                                            this.adding = false;
                                        }
                                    }
                                };
                            }
                        </script>

                        <!-- Add to Cart Form Container -->
                        <div x-data="productCartHandler(<%- JSON.stringify(variantsPayload).replace(/"/g, '&quot;') %>, <%- JSON.stringify(data.product.name).replace(/"/g, '&quot;') %>, <%- JSON.stringify((data.product.images && data.product.images.length > 0) ? data.product.images[0] : '/hero-greeting-card.webp').replace(/"/g, '&quot;') %>)">
                            <form action="/cart" method="POST" @submit.prevent="submitCart($event)" class="space-y-6 pt-4 border-t border-slate-100 dark:border-slate-800">
                                <input type="hidden" name="action" value="add">
                                
                                <% if (availableVariants.length > 0) { %>
                                    <% if (availableVariants.length === 1) { %>
                                        <input type="hidden" name="variant_id" value="<%= availableVariants[0].id %>">
                                    <% } else { %>
                                        <div class="space-y-2">
                                            <label for="variant_id" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Select Option / Variant</label>
                                            <select name="variant_id" id="variant_id" class="select select-bordered w-full rounded-xl text-sm font-semibold bg-base-100 focus:ring-1 focus:ring-primary">
                                                <% availableVariants.forEach(variant => { %>
                                                    <%
                                                        let attrLabel = variant.sku;
                                                        if (variant.attributes && typeof variant.attributes === 'object') {
                                                            const keys = Object.keys(variant.attributes);
                                                            if (keys.length > 0) {
                                                                attrLabel = keys.map(k => `${k}: ${variant.attributes[k]}`).join(', ');
                                                            }
                                                        }
                                                    %>
                                                    <option value="<%= variant.id %>">
                                                        <%= attrLabel %> ($<%= variant.price.toFixed(2) %>)
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>
                                    <% } %>

                                    <div class="flex flex-col sm:flex-row gap-4 items-end">
                                        <!-- DaisyUI Join Quantity Modifier -->
                                        <div class="space-y-2 w-full sm:w-36">
                                            <label for="quantity" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Quantity</label>
                                            <div class="join border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden w-full">
                                                <button type="button" onclick="if(parseInt(this.nextElementSibling.value) > 1) this.nextElementSibling.value = parseInt(this.nextElementSibling.value) - 1" class="btn btn-sm btn-ghost join-item font-bold px-3">-</button>
                                                <input type="number" name="quantity" id="quantity" value="1" min="1" class="join-item w-full text-center font-bold text-sm bg-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none py-1">
                                                <button type="button" onclick="this.previousElementSibling.value = parseInt(this.previousElementSibling.value) + 1" class="btn btn-sm btn-ghost join-item font-bold px-3">+</button>
                                            </div>
                                        </div>

                                        <!-- Add to Cart Button -->
                                        <button type="submit" :disabled="adding" class="btn btn-primary btn-lg rounded-xl shadow-md hover:shadow-lg font-bold flex-1 text-center w-full transition-all duration-300 active:scale-[0.98]" :class="{ 'bg-emerald-500 hover:bg-emerald-600 border-emerald-500 text-white scale-[1.02] shadow-emerald-500/20': added }">
                                            <span x-show="!adding && !added" class="flex items-center justify-center gap-2">
                                                Add to Shopping Cart
                                            </span>
                                            <span x-show="adding" class="flex items-center justify-center gap-2" style="display: none;" x-cloak>
                                                <span class="loading loading-spinner loading-sm"></span>
                                                Adding...
                                            </span>
                                            <span x-show="added" class="flex items-center justify-center gap-2" style="display: none;" x-cloak>
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                                                </svg>
                                                Added to Cart!
                                            </span>
                                        </button>
                                    </div>

                                    <div x-show="errorMessage" x-text="errorMessage" class="alert alert-error text-xs font-semibold py-2 rounded-xl mt-2" x-cloak></div>
                                <% } else { %>
                                    <div class="alert alert-error text-sm font-bold">Currently Out of Stock</div>
                                <% } %>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="mt-16 border-t border-slate-200 dark:border-slate-800 pt-12" x-data="{ editMode: false }">
                    <h2 class="text-2xl font-bold text-base-content mb-8">Customer Ratings & Reviews</h2>
                    
                    <div class="flex flex-col lg:flex-row gap-10">
                        <!-- Reviews Stats Summary -->
                        <div class="w-full lg:w-1/3 space-y-6">
                            <div class="bg-base-200/50 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 text-center">
                                <div class="text-5xl font-extrabold text-base-content mb-2">
                                    <%= (data.reviews && data.reviews.length > 0) ? data.averageRating : '-' %>
                                </div>
                                <div class="rating rating-md justify-center mb-2">
                                    <% if (data.reviews && data.reviews.length > 0) { %>
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <input type="radio" class="mask mask-star-2 bg-amber-400" <%= i <= Math.round(data.averageRating || 0) ? 'checked' : '' %> disabled />
                                        <% } %>
                                    <% } else { %>
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <input type="radio" class="mask mask-star-2 bg-amber-400 opacity-20" disabled />
                                        <% } %>
                                    <% } %>
                                </div>
                                <div class="text-xs font-semibold text-base-content/60">
                                    Based on <%= (data.reviews ? data.reviews.length : 0) %> review<%= (data.reviews && data.reviews.length === 1) ? '' : 's' %>
                                </div>
                            </div>
                            
                            <!-- DaisyUI Progress Star Breakdown -->
                            <div class="space-y-2">
                                <% for (let ratingVal = 5; ratingVal >= 1; ratingVal--) { %>
                                    <% 
                                        const ratingCount = data.reviews.filter(r => r.rating === ratingVal).length;
                                        const ratingPct = data.reviews.length > 0 ? Math.round((ratingCount / data.reviews.length) * 100) : 0;
                                    %>
                                    <div class="flex items-center gap-3 text-xs font-medium">
                                        <span class="w-10 text-right"><%= ratingVal %> star</span>
                                        <progress class="progress progress-warning flex-1 h-2" value="<%= ratingPct %>" max="100"></progress>
                                        <span class="w-8 text-left text-base-content/50"><%= ratingPct %>%</span>
                                    </div>
                                <% } %>
                            </div>
                            
                            <% if (!data.user) { %>
                                <div class="card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 text-center bg-base-200/30 space-y-3">
                                    <p class="font-semibold text-sm text-base-content">Purchased this item?</p>
                                    <a href="/login" class="btn btn-outline btn-primary btn-sm rounded-xl font-semibold w-full">
                                        Sign in to write a review
                                    </a>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Reviews List or Write Review Form -->
                        <div class="w-full lg:w-2/3 space-y-6">
                            <% if (data.user) { %>
                                <% if (data.userReview) { %>
                                    <div x-show="!editMode" class="border border-slate-200 dark:border-slate-800 rounded-2xl p-6 bg-base-200/30 space-y-3">
                                        <h3 class="text-lg font-bold text-base-content">Your Review</h3>
                                        <p class="text-xs text-base-content/60">You have already submitted a review for this card.</p>
                                        
                                        <div class="flex gap-3 pt-1">
                                            <button @click="editMode = true" class="btn btn-primary btn-sm rounded-xl font-semibold">
                                                Edit Review
                                            </button>
                                            
                                            <form action="" method="POST" onsubmit="return confirm('Are you sure you want to delete your review?')">
                                                <input type="hidden" name="action" value="delete_review">
                                                <button type="submit" class="btn btn-ghost btn-sm text-error rounded-xl font-semibold">
                                                    Delete Review
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Form to submit/edit a review -->
                                <div x-show="!<%= !!data.userReview %> || editMode" id="review_form_container" class="card border border-slate-200 dark:border-slate-800 rounded-2xl p-6 bg-base-200/40 space-y-4">
                                    <h3 class="card-title text-lg font-bold text-base-content">
                                        <%= data.userReview ? 'Edit Your Review' : 'Write a Review' %>
                                    </h3>
                                    
                                    <% if (data.reviewError) { %>
                                        <div class="alert alert-error text-xs rounded-xl font-semibold">
                                            <%= data.reviewError %>
                                        </div>
                                    <% } %>
                                    <% if (data.reviewSuccess) { %>
                                        <div class="alert alert-success text-xs rounded-xl font-semibold">
                                            <%= data.reviewSuccess %>
                                        </div>
                                    <% } %>
                                    
                                    <form action="" method="POST" class="space-y-4">
                                        <input type="hidden" name="action" value="submit_review">
                                        
                                        <div class="space-y-1">
                                            <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">Rating</label>
                                            <div class="rating rating-md" x-data="{ selectedRating: <%= data.userReview ? data.userReview.rating : 5 %> }">
                                                <input type="hidden" name="rating" :value="selectedRating">
                                                <template x-for="star in 5">
                                                    <input type="radio" name="rating_stars" class="mask mask-star-2 bg-amber-400 cursor-pointer" @click="selectedRating = star" :checked="star === selectedRating" />
                                                </template>
                                            </div>
                                        </div>
                                        
                                        <div class="space-y-1">
                                            <label for="review_title" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Title / Headline</label>
                                            <input type="text" id="review_title" name="title" required value="<%= data.userReview ? data.userReview.title : '' %>" placeholder="Summary headline of your review" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary">
                                        </div>
                                        
                                        <div class="space-y-1">
                                            <label for="review_body" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Review Description</label>
                                            <textarea id="review_body" name="body" required rows="3" placeholder="What did you like or dislike about this product?" class="textarea textarea-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"><%= data.userReview ? data.userReview.body : '' %></textarea>
                                        </div>
                                        
                                        <div class="card-actions pt-2">
                                            <button type="submit" class="btn btn-primary btn-sm rounded-xl font-semibold px-6">
                                                <%= data.userReview ? 'Update Review' : 'Submit Review' %>
                                            </button>
                                            <% if (data.userReview) { %>
                                                <button type="button" @click="editMode = false" class="btn btn-ghost btn-sm rounded-xl font-semibold">
                                                    Cancel
                                                </button>
                                            <% } %>
                                        </div>
                                    </form>
                                </div>
                            <% } %>

                            <!-- Review List -->
                            <div class="space-y-4">
                                <% if (data.reviews && data.reviews.length > 0) { %>
                                    <% data.reviews.forEach(review => { %>
                                        <div class="card border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 bg-base-100 shadow-sm space-y-2">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2">
                                                    <div class="rating rating-xs">
                                                        <% for (let i = 1; i <= 5; i++) { %>
                                                            <input type="radio" class="mask mask-star-2 bg-amber-400" <%= i <= review.rating ? 'checked' : '' %> disabled />
                                                        <% } %>
                                                    </div>
                                                    <h4 class="font-bold text-sm text-base-content"><%= review.title %></h4>
                                                </div>
                                                <span class="text-[11px] text-base-content/50"><%= review.created %></span>
                                            </div>
                                            
                                            <p class="text-sm text-base-content/80 leading-relaxed">
                                                <%= review.body %>
                                            </p>
                                            
                                            <div class="card-actions items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                                                <span class="text-xs font-medium text-base-content/60">By <strong class="text-base-content"><%= review.userName %></strong></span>
                                                <% if (review.isVerified) { %>
                                                    <span class="badge badge-success text-success-content font-bold text-[10px]">Verified Purchase</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="alert alert-info rounded-2xl p-8 text-center text-sm font-medium">
                                        No reviews yet. Be the first to share your thoughts!
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="container mx-auto max-w-xl px-4 py-24 text-center">
            <div class="card bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 shadow-sm space-y-4">
                <h1 class="text-3xl font-bold text-base-content">Product Not Found</h1>
                <p class="text-sm text-base-content/60">The product you requested doesn't exist or has been removed.</p>
                <div class="card-actions justify-center">
                    <a href="/shop" class="btn btn-primary rounded-xl font-semibold px-6">Return to Shop Catalog</a>
                </div>
            </div>
        </div>
    <% } %>
</div>
