<div class="min-h-screen bg-base-100 py-10">
    <% if (data.product) { %>
        <div class="container mx-auto max-w-7xl px-4 md:px-8">
            <!-- Breadcrumbs -->
            <div class="text-xs text-base-content/60 font-medium mb-6 flex items-center gap-2">
                <a href="/" class="hover:text-primary transition-colors">Home</a>
                <span>/</span>
                <a href="/shop" class="hover:text-primary transition-colors">Shop</a>
                <% if (data.product.category) { %>
                    <span>/</span>
                    <a href="/shop?category=<%= data.product.category.slug %>" class="hover:text-primary transition-colors"><%= data.product.category.name %></a>
                <% } %>
                <span>/</span>
                <span class="text-base-content/90 font-semibold truncate"><%= data.product.name %></span>
            </div>

            <!-- Main Product Card -->
            <div class="bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 lg:p-10 shadow-sm">
                <div class="flex flex-col lg:flex-row gap-12">
                    <!-- Image Gallery -->
                    <div class="w-full lg:w-1/2" x-data="{ activeImage: '<%= data.product.images[0] %>' }">
                        <div class="border border-slate-200 dark:border-slate-800 bg-base-200/50 aspect-[4/5] rounded-2xl relative overflow-hidden shadow-sm">
                            <img :src="activeImage" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                        </div>
                        <% if (data.product.images && data.product.images.length > 1) { %>
                            <div class="flex gap-3 mt-4 overflow-x-auto pb-2">
                                <% data.product.images.forEach(img => { %>
                                    <button type="button" 
                                            class="w-20 h-20 rounded-xl overflow-hidden border-2 transition-all flex-shrink-0"
                                            :class="activeImage === '<%= img %>' ? 'border-primary ring-2 ring-primary/20 scale-95' : 'border-transparent opacity-70 hover:opacity-100'"
                                            @click="activeImage = '<%= img %>'">
                                        <img src="<%= img %>" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                                    </button>
                                <% }); %>
                            </div>
                        <% } %>
                    </div>

                    <!-- Product Info Column -->
                    <div class="w-full lg:w-1/2 flex flex-col justify-between">
                        <div>
                            <% if (data.product.category) { %>
                                <a href="/shop?category=<%= data.product.category.slug %>" class="inline-block px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-semibold uppercase tracking-wider mb-4 hover:bg-primary/20 transition-colors">
                                    <%= data.product.category.name %>
                                </a>
                            <% } %>
                            
                            <h1 class="text-3xl sm:text-4xl font-extrabold text-base-content tracking-tight mb-3">
                                <%= data.product.name %>
                            </h1>

                            <!-- Rating Summary Pill -->
                            <div class="flex items-center gap-3 mb-6">
                                <div class="flex text-amber-400 text-sm">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <%= i <= Math.round(data.averageRating || 5) ? '★' : '☆' %>
                                    <% } %>
                                </div>
                                <span class="text-xs font-semibold text-base-content/70">
                                    <%= data.averageRating || '5.0' %> (<%= data.reviews ? data.reviews.length : 0 %> reviews)
                                </span>
                            </div>

                            <% 
                                let displayPrice = "Sold Out";
                                const availableVariants = (data.variants || []).filter(v => v.stock > 0);
                                if (availableVariants.length > 0) {
                                    const minPrice = Math.min(...availableVariants.map(v => v.price));
                                    displayPrice = "$" + minPrice.toFixed(2);
                                }
                            %>
                            <div class="flex items-baseline gap-4 mb-6">
                                <span class="text-3xl font-extrabold text-base-content"><%= displayPrice %></span>
                                <% if (availableVariants.length > 0) { %>
                                    <span class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/60 px-2.5 py-1 rounded-full">In Stock</span>
                                <% } %>
                            </div>

                            <div class="divider my-4"></div>

                            <% if (data.product.description) { %>
                                <div class="prose prose-sm prose-slate max-w-none text-base-content/80 font-normal mb-8 leading-relaxed">
                                    <%- data.product.description %>
                                </div>
                            <% } else { %>
                                <p class="text-sm italic text-base-content/50 mb-8">
                                    A premium quality greeting card printed on sustainable, heavy paper stock. Perfect for making any celebration memorable.
                                </p>
                            <% } %>
                        </div>

                        <!-- Add to Cart / Actions Form -->
                        <form action="/cart" method="POST" class="space-y-6 pt-4 border-t border-slate-100 dark:border-slate-800">
                            <input type="hidden" name="action" value="add">
                            
                            <% if (availableVariants.length > 0) { %>
                                <% if (availableVariants.length === 1) { %>
                                    <input type="hidden" name="variant_id" value="<%= availableVariants[0].id %>">
                                <% } else { %>
                                    <div class="space-y-2">
                                        <label for="variant_id" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Select Option / Variant</label>
                                        <select name="variant_id" id="variant_id" class="select select-bordered w-full rounded-xl text-sm font-semibold bg-base-100 focus:ring-1 focus:ring-primary">
                                            <% availableVariants.forEach(variant => { %>
                                                <%
                                                    let attrLabel = variant.sku;
                                                    if (variant.attributes && typeof variant.attributes === 'object') {
                                                        const keys = Object.keys(variant.attributes);
                                                        if (keys.length > 0) {
                                                            attrLabel = keys.map(k => `${k}: ${variant.attributes[k]}`).join(', ');
                                                        }
                                                    }
                                                %>
                                                <option value="<%= variant.id %>">
                                                    <%= attrLabel %> ($<%= variant.price.toFixed(2) %>)
                                                </option>
                                            <% }); %>
                                        </select>
                                    </div>
                                <% } %>

                                <div class="flex flex-col sm:flex-row gap-4 items-end">
                                    <!-- Quantity Stepper -->
                                    <div class="space-y-2 w-full sm:w-36">
                                        <label for="quantity" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Quantity</label>
                                        <div class="flex items-center border border-slate-200 dark:border-slate-700 rounded-xl overflow-hidden bg-base-100">
                                            <button type="button" onclick="if(parseInt(this.nextElementSibling.value) > 1) this.nextElementSibling.value = parseInt(this.nextElementSibling.value) - 1" class="px-3 py-2 text-base-content/70 hover:bg-base-200 font-bold transition-colors">-</button>
                                            <input type="number" name="quantity" id="quantity" value="1" min="1" class="w-full text-center font-bold text-sm bg-transparent focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none py-2">
                                            <button type="button" onclick="this.previousElementSibling.value = parseInt(this.previousElementSibling.value) + 1" class="px-3 py-2 text-base-content/70 hover:bg-base-200 font-bold transition-colors">+</button>
                                        </div>
                                    </div>

                                    <!-- Add to Cart Button -->
                                    <button type="submit" class="btn btn-primary btn-lg rounded-xl shadow-md hover:shadow-lg font-bold flex-1 text-center w-full">
                                        🛒 Add to Shopping Cart
                                    </button>
                                </div>
                            <% } else { %>
                                <p class="text-lg font-bold text-error">Currently Out of Stock</p>
                            <% } %>
                        </form>
                    </div>
                </div>

                <!-- Reviews Section -->
                <div class="mt-16 border-t border-slate-200 dark:border-slate-800 pt-12" x-data="{ editMode: false }">
                    <h2 class="text-2xl font-bold text-base-content mb-8">Customer Ratings & Reviews</h2>
                    
                    <div class="flex flex-col lg:flex-row gap-10">
                        <!-- Reviews Stats Summary -->
                        <div class="w-full lg:w-1/3 space-y-6">
                            <div class="bg-base-200/50 border border-slate-200 dark:border-slate-800 rounded-2xl p-6 text-center">
                                <div class="text-5xl font-extrabold text-base-content mb-2">
                                    <%= data.averageRating || '0' %>
                                </div>
                                <div class="flex justify-center text-amber-400 text-2xl mb-2">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                        <%= i <= Math.round(data.averageRating) ? '★' : '☆' %>
                                    <% } %>
                                </div>
                                <div class="text-xs font-semibold text-base-content/60">
                                    Based on <%= data.reviews.length %> review<%= data.reviews.length === 1 ? '' : 's' %>
                                </div>
                            </div>
                            
                            <!-- Breakdown of stars -->
                            <div class="space-y-2">
                                <% for (let ratingVal = 5; ratingVal >= 1; ratingVal--) { %>
                                    <% 
                                        const ratingCount = data.reviews.filter(r => r.rating === ratingVal).length;
                                        const ratingPct = data.reviews.length > 0 ? Math.round((ratingCount / data.reviews.length) * 100) : 0;
                                    %>
                                    <div class="flex items-center gap-3 text-xs font-medium">
                                        <span class="w-10 text-right"><%= ratingVal %> star</span>
                                        <div class="flex-1 h-3 bg-base-200 rounded-full overflow-hidden">
                                            <div class="h-full bg-amber-400 rounded-full transition-all" :style="{ width: '<%= ratingPct %>' + '%' }"></div>
                                        </div>
                                        <span class="w-8 text-left text-base-content/50"><%= ratingPct %>%</span>
                                    </div>
                                <% } %>
                            </div>
                            
                            <% if (!data.user) { %>
                                <div class="border border-slate-200 dark:border-slate-800 rounded-2xl p-6 text-center bg-base-200/30">
                                    <p class="font-semibold text-sm mb-3 text-base-content">Purchased this item?</p>
                                    <a href="/login" class="btn btn-outline btn-primary btn-sm rounded-xl font-semibold w-full">
                                        Sign in to write a review
                                    </a>
                                </div>
                            <% } %>
                        </div>
                        
                        <!-- Reviews List or Write Review Form -->
                        <div class="w-full lg:w-2/3 space-y-6">
                            <% if (data.user) { %>
                                <% if (data.userReview) { %>
                                    <div x-show="!editMode" class="border border-slate-200 dark:border-slate-800 rounded-2xl p-6 bg-base-200/30">
                                        <h3 class="text-lg font-bold text-base-content mb-1">Your Review</h3>
                                        <p class="text-xs text-base-content/60 mb-4">You have already submitted a review for this card.</p>
                                        
                                        <div class="flex gap-3">
                                            <button @click="editMode = true" class="btn btn-primary btn-sm rounded-xl font-semibold">
                                                Edit Review
                                            </button>
                                            
                                            <form action="" method="POST" onsubmit="return confirm('Are you sure you want to delete your review?')">
                                                <input type="hidden" name="action" value="delete_review">
                                                <button type="submit" class="btn btn-ghost btn-sm text-error rounded-xl font-semibold">
                                                    Delete Review
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Form to submit/edit a review -->
                                <div x-show="!<%= !!data.userReview %> || editMode" id="review_form_container" class="border border-slate-200 dark:border-slate-800 rounded-2xl p-6 bg-base-200/40 space-y-4">
                                    <h3 class="text-lg font-bold text-base-content">
                                        <%= data.userReview ? 'Edit Your Review' : 'Write a Review' %>
                                    </h3>
                                    
                                    <% if (data.reviewError) { %>
                                        <div class="alert alert-error text-xs rounded-xl font-semibold">
                                            <%= data.reviewError %>
                                        </div>
                                    <% } %>
                                    <% if (data.reviewSuccess) { %>
                                        <div class="alert alert-success text-xs rounded-xl font-semibold">
                                            <%= data.reviewSuccess %>
                                        </div>
                                    <% } %>
                                    
                                    <form action="" method="POST" class="space-y-4">
                                        <input type="hidden" name="action" value="submit_review">
                                        
                                        <div class="space-y-1">
                                            <label class="text-xs font-bold uppercase tracking-wider text-base-content/70">Rating</label>
                                            <div class="flex gap-1 text-2xl" x-data="{ selectedRating: <%= data.userReview ? data.userReview.rating : 5 %> }">
                                                <input type="hidden" name="rating" :value="selectedRating">
                                                <template x-for="star in 5">
                                                    <button type="button" @click="selectedRating = star" class="focus:outline-none transition-colors" :class="star <= selectedRating ? 'text-amber-400' : 'text-base-content/20'">
                                                        ★
                                                    </button>
                                                </template>
                                            </div>
                                        </div>
                                        
                                        <div class="space-y-1">
                                            <label for="review_title" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Title / Headline</label>
                                            <input type="text" id="review_title" name="title" required value="<%= data.userReview ? data.userReview.title : '' %>" placeholder="Summary headline of your review" class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary">
                                        </div>
                                        
                                        <div class="space-y-1">
                                            <label for="review_body" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Review Description</label>
                                            <textarea id="review_body" name="body" required rows="3" placeholder="What did you like or dislike about this product?" class="textarea textarea-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"><%= data.userReview ? data.userReview.body : '' %></textarea>
                                        </div>
                                        
                                        <div class="flex gap-3 pt-2">
                                            <button type="submit" class="btn btn-primary btn-sm rounded-xl font-semibold px-6">
                                                <%= data.userReview ? 'Update Review' : 'Submit Review' %>
                                            </button>
                                            <% if (data.userReview) { %>
                                                <button type="button" @click="editMode = false" class="btn btn-ghost btn-sm rounded-xl font-semibold">
                                                    Cancel
                                                </button>
                                            <% } %>
                                        </div>
                                    </form>
                                </div>
                            <% } %>

                            <!-- Review list -->
                            <div class="space-y-4">
                                <% if (data.reviews && data.reviews.length > 0) { %>
                                    <% data.reviews.forEach(review => { %>
                                        <div class="border border-slate-200/80 dark:border-slate-800 rounded-2xl p-5 bg-base-100 shadow-sm space-y-2">
                                            <div class="flex items-center justify-between">
                                                <div class="flex items-center gap-2">
                                                    <div class="flex text-amber-400 text-sm">
                                                        <% for (let i = 1; i <= 5; i++) { %>
                                                            <%= i <= review.rating ? '★' : '☆' %>
                                                        <% } %>
                                                    </div>
                                                    <h4 class="font-bold text-sm text-base-content"><%= review.title %></h4>
                                                </div>
                                                <span class="text-[11px] text-base-content/50"><%= review.created %></span>
                                            </div>
                                            
                                            <p class="text-sm text-base-content/80 leading-relaxed">
                                                <%= review.body %>
                                            </p>
                                            
                                            <div class="flex items-center justify-between text-xs text-base-content/60 pt-2 border-t border-slate-100 dark:border-slate-800">
                                                <span class="font-medium">By <strong class="text-base-content"><%= review.userName %></strong></span>
                                                <% if (review.isVerified) { %>
                                                    <span class="bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded-full">Verified Purchase</span>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                <% } else { %>
                                    <div class="border border-slate-200 dark:border-slate-800 rounded-2xl p-8 text-center text-sm font-medium text-base-content/60">
                                        No reviews yet. Be the first to share your thoughts!
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="container mx-auto max-w-xl px-4 py-24 text-center">
            <div class="bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 shadow-sm">
                <h1 class="text-3xl font-bold text-base-content mb-3">Product Not Found</h1>
                <p class="text-sm text-base-content/60 mb-6">The product you requested doesn't exist or has been removed.</p>
                <a href="/shop" class="btn btn-primary rounded-xl font-semibold px-6">Return to Shop Catalog</a>
            </div>
        </div>
    <% } %>
</div>
