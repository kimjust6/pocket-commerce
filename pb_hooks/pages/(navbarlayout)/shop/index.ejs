<div class="min-h-screen bg-base-100">
    <!-- Header Hero Banner -->
    <div class="bg-slate-900 text-white py-12 md:py-16 relative overflow-hidden">
        <div class="container mx-auto max-w-7xl px-4 md:px-8 relative z-10">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                <div>
                    <!-- DaisyUI Breadcrumbs -->
                    <div class="breadcrumbs text-xs text-slate-400 font-medium mb-2">
                        <ul>
                            <li><a href="/" class="hover:text-white">Home</a></li>
                            <li class="font-bold text-slate-200">Shop Catalog</li>
                        </ul>
                    </div>
                    <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight">
                        Product Catalog
                    </h1>
                </div>
                <p class="text-sm text-slate-400 max-w-md">
                    Explore our complete collection of handcrafted greeting cards, funny gifts, and occasion stationery.
                </p>
            </div>
        </div>
    </div>

    <!-- Catalog Content -->
    <div class="container mx-auto max-w-7xl px-4 md:px-8 py-12">
        <div class="flex flex-col lg:flex-row gap-10">
            <!-- Sidebar Filters (DaisyUI Card) -->
            <div class="w-full lg:w-1/4 flex-shrink-0">
                <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 shadow-sm p-6 sticky top-24" x-data="{ open: window.innerWidth >= 1024 }">
                    <div class="flex justify-between items-center cursor-pointer lg:cursor-default pb-4 lg:pb-0" @click="if(window.innerWidth < 1024) open = !open">
                        <h2 class="card-title text-base font-bold text-base-content flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                            </svg>
                            Filter Products
                        </h2>
                        <svg x-show="window.innerWidth < 1024" :class="{'rotate-180': open}" class="w-5 h-5 transition-transform duration-200 text-base-content/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    </div>
                    
                    <% const filters = data.filters || {}; %>
                    <form action="/shop" method="GET" x-show="open" x-transition.opacity class="space-y-6 pt-4 border-t border-slate-100 dark:border-slate-800 lg:border-t-0 lg:pt-4">
                        <% if (data.selectedCategory) { %>
                            <input type="hidden" name="category" value="<%= data.selectedCategory %>">
                        <% } %>

                        <!-- Categories Section -->
                        <div>
                            <span class="badge badge-primary badge-outline text-[10px] font-bold uppercase tracking-wider mb-2">Categories</span>
                            <ul class="menu menu-sm p-0 space-y-1 font-medium">
                                <li>
                                    <a href="/shop" data-no-link-fix class="rounded-xl <%= !data.selectedCategory ? 'active font-bold' : '' %>">
                                        <span>All Categories</span>
                                    </a>
                                </li>
                                <% if (data.categories && data.categories.length > 0) { %>
                                    <% data.categories.forEach(category => { %>
                                        <li>
                                            <a href="/shop?category=<%= category.slug %>" class="rounded-xl <%= data.selectedCategory === category.slug ? 'active font-bold' : '' %>">
                                                <span><%= category.name %></span>
                                            </a>
                                        </li>
                                    <% }); %>
                                <% } %>
                            </ul>
                        </div>

                        <div class="divider my-1"></div>

                        <!-- Price Range Input Group -->
                        <div x-data="{ priceOpen: true }">
                            <span class="badge badge-secondary badge-outline text-[10px] font-bold uppercase tracking-wider mb-2">Price Range (CAD$)</span>
                            <div class="join w-full pt-1">
                                <input type="number" name="min_price" placeholder="Min" value="<%= filters.minPrice || '' %>" class="input input-sm input-bordered join-item w-full bg-base-100 text-xs font-medium">
                                <input type="number" name="max_price" placeholder="Max" value="<%= filters.maxPrice || '' %>" class="input input-sm input-bordered join-item w-full bg-base-100 text-xs font-medium">
                                <button type="submit" class="btn btn-primary btn-sm join-item text-xs font-bold">Go</button>
                            </div>
                        </div>

                        <div class="divider my-1"></div>

                        <!-- Availability Options -->
                        <div>
                            <span class="badge badge-accent badge-outline text-[10px] font-bold uppercase tracking-wider mb-2">Stock</span>
                            <div class="space-y-2 pt-1">
                                <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-base-content/80">
                                    <input type="checkbox" name="availability" value="in_stock" <%= filters.availability === 'in_stock' ? 'checked' : '' %> onchange="if(this.checked) { const other = this.form.querySelector('input[value=out_of_stock]'); if(other) other.checked = false; }; this.form.submit();" class="checkbox checkbox-xs checkbox-primary">
                                    <span>In Stock Only</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer text-xs font-semibold text-base-content/80">
                                    <input type="checkbox" name="availability" value="out_of_stock" <%= filters.availability === 'out_of_stock' ? 'checked' : '' %> onchange="if(this.checked) { const other = this.form.querySelector('input[value=in_stock]'); if(other) other.checked = false; }; this.form.submit();" class="checkbox checkbox-xs checkbox-primary">
                                    <span>Out of Stock</span>
                                </label>
                            </div>
                        </div>

                        <!-- Sale Deals Checkbox -->
                        <div class="pt-2">
                            <label class="flex items-center gap-2 cursor-pointer text-xs font-extrabold text-rose-500">
                                <input type="checkbox" name="on_sale" value="1" <%= filters.onSale == '1' ? 'checked' : '' %> onchange="this.form.submit()" class="checkbox checkbox-xs checkbox-error">
                                <span>On Sale Deals Only</span>
                            </label>
                        </div>

                        <!-- Reset Filters -->
                        <% if (filters.minPrice || filters.maxPrice || filters.availability || filters.onSale) { %>
                            <div class="pt-2">
                                <a href="/shop<%= data.selectedCategory ? '?category=' + data.selectedCategory : '' %>" data-no-link-fix class="btn btn-outline btn-error btn-xs w-full rounded-xl">
                                    Reset Filters
                                </a>
                            </div>
                        <% } %>
                    </form>
                </div>
            </div>

            <!-- Product Grid Column -->
            <div class="w-full lg:w-3/4">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% if (data.products && data.products.length > 0) { %>
                        <% data.products.forEach(product => { %>
                            <%- include('../../_private/product-card.ejs', { card: product }) %>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full card bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 text-center shadow-sm space-y-4">
                            <div class="w-16 h-16 rounded-full bg-base-200 text-base-content/40 flex items-center justify-center mx-auto">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                                </svg>
                            </div>
                            <h3 class="text-xl font-bold text-base-content">No Matching Products Found</h3>
                            <p class="text-xs text-base-content/60 max-w-sm mx-auto">Try broadening your search query or resetting active filter conditions.</p>
                            <div class="card-actions justify-center pt-2">
                                <a href="/shop" data-no-link-fix class="btn btn-primary rounded-xl font-semibold px-6">View All Products</a>
                            </div>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
