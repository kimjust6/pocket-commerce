<div class="min-h-screen border-b-8 border-neutral bg-base-200">
    <% if (data.product) { %>
        <div class="container mx-auto max-w-7xl px-4 py-12 lg:py-24">
            <div class="flex flex-col lg:flex-row gap-12 bg-base-100 border-4 border-neutral shadow-[8px_8px_0_0_rgba(0,0,0,1)] p-6 lg:p-12">
                <!-- Image Gallery -->
                <div class="w-full lg:w-1/2">
                    <div class="border-4 border-neutral bg-base-200 aspect-[4/5] relative overflow-hidden">
                        <img src="<%= data.product.images[0] %>" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                    </div>
                    <% if (data.product.images.length > 1) { %>
                        <div class="flex gap-4 mt-4 overflow-x-auto pb-4">
                            <% data.product.images.forEach(img => { %>
                                <div class="border-4 border-neutral w-24 h-24 flex-shrink-0 cursor-pointer hover:-translate-y-1 hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] transition-all">
                                    <img src="<%= img %>" alt="<%= data.product.name %>" class="w-full h-full object-cover">
                                </div>
                            <% }); %>
                        </div>
                    <% } %>
                </div>

                <!-- Product Info -->
                <div class="w-full lg:w-1/2 flex flex-col justify-center">
                    <% if (data.product.category) { %>
                        <a href="/shop?category=<%= data.product.category.slug %>" class="inline-block bg-secondary text-secondary-content border-2 border-neutral px-4 py-1 font-bold text-sm uppercase self-start mb-6 hover:-translate-y-1 transition-transform shadow-[4px_4px_0_0_rgba(0,0,0,1)]">
                            <%= data.product.category.name %>
                        </a>
                    <% } %>
                    
                    <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-base-content mb-6">
                        <%= data.product.name %>
                    </h1>

                    <% 
                        let displayPrice = "Sold Out";
                        if (data.variants && data.variants.length > 0) {
                            const minPrice = Math.min(...data.variants.map(v => v.price));
                            displayPrice = "$" + minPrice.toFixed(2);
                        }
                    %>
                    <div class="text-4xl font-black bg-primary text-primary-content border-4 border-neutral inline-block px-6 py-3 shadow-[6px_6px_0_0_rgba(0,0,0,1)] self-start mb-8 transform -rotate-2">
                        <%= displayPrice %>
                    </div>

                    <div class="prose prose-lg prose-neutral max-w-none text-base-content font-medium mb-12">
                        <%- data.product.description || "No description available." %>
                    </div>

                    <!-- Add to Cart / Actions Form -->
                    <form action="/cart" method="POST" class="mt-auto flex flex-col gap-6">
                        <input type="hidden" name="action" value="add">
                        
                        <% if (data.variants && data.variants.length > 0) { %>
                            <% if (data.variants.length === 1) { %>
                                <input type="hidden" name="variant_id" value="<%= data.variants[0].id %>">
                            <% } else { %>
                                <div class="flex flex-col gap-2">
                                    <label for="variant_id" class="text-lg font-black uppercase text-base-content">Select Style / Variant</label>
                                    <select name="variant_id" id="variant_id" class="select select-bordered border-4 border-neutral bg-base-100 text-lg font-bold py-2 px-4 shadow-[4px_4px_0_0_rgba(0,0,0,1)] focus:translate-y-[2px] focus:translate-x-[2px] focus:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all">
                                        <% data.variants.forEach(variant => { %>
                                            <%
                                                let attrLabel = variant.sku;
                                                if (variant.attributes && typeof variant.attributes === 'object') {
                                                    const keys = Object.keys(variant.attributes);
                                                    if (keys.length > 0) {
                                                        attrLabel = keys.map(k => `${k}: ${variant.attributes[k]}`).join(', ');
                                                    }
                                                }
                                            %>
                                            <option value="<%= variant.id %>" <%= variant.stock <= 0 ? 'disabled' : '' %>>
                                                <%= attrLabel %> (<%= variant.stock > 0 ? '$' + variant.price.toFixed(2) : 'Sold Out' %>)
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>
                            <% } %>

                            <div class="flex flex-col sm:flex-row gap-6 items-end mt-4">
                                <!-- Quantity Selector -->
                                <div class="flex flex-col gap-2 w-full sm:w-36">
                                    <label for="quantity" class="text-lg font-black uppercase text-base-content">Qty</label>
                                    <div class="flex items-center border-4 border-neutral bg-base-100 shadow-[4px_4px_0_0_rgba(0,0,0,1)]">
                                        <button type="button" onclick="const input = this.nextElementSibling; if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1" class="btn btn-ghost rounded-none border-0 text-xl font-bold px-3 py-2">-</button>
                                        <input type="number" name="quantity" id="quantity" value="1" min="1" class="w-full text-center font-bold text-lg border-0 bg-transparent focus:ring-0 focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none py-2">
                                        <button type="button" onclick="const input = this.previousElementSibling; input.value = parseInt(input.value) + 1" class="btn btn-ghost rounded-none border-0 text-xl font-bold px-3 py-2">+</button>
                                    </div>
                                </div>

                                <!-- Add to Cart Button -->
                                <button type="submit" class="bg-accent text-accent-content border-4 border-neutral font-black text-2xl uppercase px-8 py-4 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all flex-1 text-center w-full">
                                    Add to Cart
                                </button>
                            </div>
                        <% } else { %>
                            <p class="text-2xl font-black text-error uppercase">Currently Sold Out</p>
                        <% } %>
                    </form>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="container mx-auto max-w-4xl px-4 py-24 text-center">
            <div class="bg-base-100 border-4 border-neutral p-12 shadow-[8px_8px_0_0_rgba(0,0,0,1)]">
                <h1 class="text-6xl font-black uppercase text-base-content mb-6">Product Not Found</h1>
                <p class="text-xl font-medium mb-8">The product you're looking for doesn't exist or has been removed.</p>
                <a href="/shop" class="inline-block bg-primary text-primary-content border-4 border-neutral font-black text-xl uppercase px-8 py-4 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-[2px_2px_0_0_rgba(0,0,0,1)] transition-all">
                    Back to Shop
                </a>
            </div>
        </div>
    <% } %>
</div>
