<div class="min-h-screen border-b-8 border-neutral bg-base-200 py-12 lg:py-24">
    <div class="container mx-auto max-w-7xl px-4">
        <!-- Title and Back button -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-12">
            <div>
                <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-base-content">
                    Checkout
                </h1>
                <p class="text-xl font-bold text-base-content/70 mt-2">
                    Complete your purchase and get ready for laughs.
                </p>
            </div>
            <a href="/cart" class="bg-base-100 text-base-content border-4 border-neutral font-black text-lg uppercase px-6 py-3 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Return to Cart
            </a>
        </div>

        <% if (data.error) { %>
            <!-- Brutalist Error Banner -->
            <div class="bg-error text-error-content border-4 border-neutral p-6 font-black text-xl uppercase shadow-[6px_6px_0_0_rgba(0,0,0,1)] mb-12 transform -rotate-1">
                ⚠️ Error: <%= data.error %>
            </div>
        <% } %>

        <form action="/checkout" method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
            
            <!-- Left: Checkout Forms (2/3 width) -->
            <div class="lg:col-span-2 flex flex-col gap-8">
                
                <!-- 1. Shipping Details -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] flex flex-col gap-6"
                     x-data="{ selectedAddress: '<%= data.addresses.find(a => a.is_default)?.id || (data.addresses[0]?.id || 'new') %>' }">
                    
                    <h3 class="text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4 flex items-center gap-3">
                        <span class="bg-primary text-primary-content border-2 border-neutral rounded-full w-8 h-8 flex items-center justify-center text-sm font-black">1</span>
                        Shipping Information
                    </h3>

                    <!-- Saved Addresses selection (for logged in users) -->
                    <% if (data.addresses && data.addresses.length > 0) { %>
                        <div class="flex flex-col gap-4">
                            <span class="text-lg font-black uppercase text-base-content/70">Select a Saved Shipping Address:</span>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% data.addresses.forEach(addr => { %>
                                    <label class="border-4 border-neutral p-4 cursor-pointer select-none transition-all shadow-[4px_4px_0_0_rgba(0,0,0,1)] relative flex flex-col gap-2"
                                           :class="selectedAddress === '<%= addr.id %>' ? 'bg-primary/10 border-primary shadow-[2px_2px_0_0_rgba(0,0,0,1)] translate-y-[2px] translate-x-[2px]' : 'bg-base-100'">
                                        <div class="flex items-center gap-2">
                                            <input type="radio" name="address_id" value="<%= addr.id %>" x-model="selectedAddress" class="radio radio-primary border-4 border-neutral" />
                                            <span class="font-black uppercase text-md">
                                                <%= addr.is_default ? '⭐ Default Address' : 'Home Address' %>
                                            </span>
                                        </div>
                                        <p class="text-md font-bold text-base-content/80 pl-8 leading-tight">
                                            <%= addr.street %><br>
                                            <%= addr.city %>, <%= addr.state %> <%= addr.zip %><br>
                                            <%= addr.country %>
                                        </p>
                                    </label>
                                <% }); %>

                                <label class="border-4 border-neutral p-4 cursor-pointer select-none transition-all shadow-[4px_4px_0_0_rgba(0,0,0,1)] relative flex flex-col gap-2"
                                       :class="selectedAddress === 'new' ? 'bg-primary/10 border-primary shadow-[2px_2px_0_0_rgba(0,0,0,1)] translate-y-[2px] translate-x-[2px]' : 'bg-base-100'">
                                    <div class="flex items-center gap-2">
                                        <input type="radio" name="address_id" value="new" x-model="selectedAddress" class="radio radio-primary border-4 border-neutral" />
                                        <span class="font-black uppercase text-md">
                                            ➕ Deliver to a New Address
                                        </span>
                                    </div>
                                    <p class="text-sm font-bold text-base-content/50 pl-8 leading-tight">
                                        Fill out shipping details manually below.
                                    </p>
                                </label>
                            </div>
                        </div>
                    <% } else { %>
                        <input type="hidden" name="address_id" value="new" />
                    <% } %>

                    <!-- Manual Address Inputs (shown if new selected or guest) -->
                    <div x-show="selectedAddress === 'new'" class="flex flex-col gap-4 border-t-2 border-neutral/10 pt-4" x-transition>
                        <span class="text-lg font-black uppercase text-base-content/70">Shipping Address Details:</span>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <!-- Recipient Name -->
                            <div class="flex flex-col gap-2">
                                <label for="name" class="font-black uppercase text-sm text-base-content/70">Full Name</label>
                                <input type="text" id="name" name="name" placeholder="John Doe" value="<%= data.user?.name || '' %>"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"
                                       :required="selectedAddress === 'new'" />
                            </div>

                            <!-- Email -->
                            <div class="flex flex-col gap-2">
                                <label for="email" class="font-black uppercase text-sm text-base-content/70">Email Address</label>
                                <input type="email" id="email" name="email" placeholder="john@example.com" value="<%= data.user?.email || '' %>"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"
                                       :required="selectedAddress === 'new'" />
                            </div>
                        </div>

                        <!-- Street Address -->
                        <div class="flex flex-col gap-2">
                            <label for="street" class="font-black uppercase text-sm text-base-content/70">Street Address</label>
                            <input type="text" id="street" name="street" placeholder="123 Awesome Lane"
                                   class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"
                                   :required="selectedAddress === 'new'" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <!-- City -->
                            <div class="flex flex-col gap-2">
                                <label for="city" class="font-black uppercase text-sm text-base-content/70">City</label>
                                <input type="text" id="city" name="city" placeholder="Puntown"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"
                                       :required="selectedAddress === 'new'" />
                            </div>

                            <!-- State -->
                            <div class="flex flex-col gap-2">
                                <label for="state" class="font-black uppercase text-sm text-base-content/70">State / Province</label>
                                <input type="text" id="state" name="state" placeholder="Ontario"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]" />
                            </div>

                            <!-- ZIP -->
                            <div class="flex flex-col gap-2">
                                <label for="zip" class="font-black uppercase text-sm text-base-content/70">ZIP / Postal Code</label>
                                <input type="text" id="zip" name="zip" placeholder="K1A 0B1"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]" />
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="flex flex-col gap-2">
                            <label for="country" class="font-black uppercase text-sm text-base-content/70">Country</label>
                            <input type="text" id="country" name="country" placeholder="Canada"
                                   class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"
                                   :required="selectedAddress === 'new'" />
                        </div>

                        <!-- Save Address Checkbox (Only if logged in) -->
                        <% if (data.user) { %>
                            <div class="flex items-center gap-3 mt-2">
                                <input type="checkbox" id="save_address" name="save_address" value="true" class="checkbox checkbox-primary border-4 border-neutral shadow-[2px_2px_0_0_rgba(0,0,0,1)]" />
                                <label for="save_address" class="font-black uppercase text-sm text-base-content/80 cursor-pointer select-none">
                                    💾 Save this address to my profile
                                </label>
                            </div>
                        <% } %>
                    </div>

                    <!-- Recipient details if using SAVED address -->
                    <div x-show="selectedAddress !== 'new'" class="flex flex-col gap-4 border-t-2 border-neutral/10 pt-4" x-transition>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="flex flex-col gap-2">
                                <label for="saved_name" class="font-black uppercase text-sm text-base-content/70">Recipient Name</label>
                                <input type="text" id="saved_name" name="name" value="<%= data.user?.name || '' %>"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label for="saved_email" class="font-black uppercase text-sm text-base-content/70">Email Updates</label>
                                <input type="email" id="saved_email" name="email" value="<%= data.user?.email || '' %>"
                                       class="input input-bordered border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]" />
                            </div>
                        </div>
                    </div>

                </div>

                <!-- 2. Payment Method -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] flex flex-col gap-6"
                     x-data="{ paymentMethod: 'manual' }">
                    
                    <h3 class="text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4 flex items-center gap-3">
                        <span class="bg-primary text-primary-content border-2 border-neutral rounded-full w-8 h-8 flex items-center justify-center text-sm font-black">2</span>
                        Payment Method
                    </h3>

                    <div class="flex flex-col gap-4">
                        <!-- Manual Bank Payment -->
                        <label class="border-4 border-neutral p-5 cursor-pointer select-none transition-all shadow-[4px_4px_0_0_rgba(0,0,0,1)] flex items-center gap-4"
                               :class="paymentMethod === 'manual' ? 'bg-accent/15 border-accent shadow-[2px_2px_0_0_rgba(0,0,0,1)] translate-y-[2px] translate-x-[2px]' : 'bg-base-100'">
                            <input type="radio" name="payment_method" value="manual" x-model="paymentMethod" class="radio radio-primary border-4 border-neutral" checked />
                            <div class="flex flex-col">
                                <span class="font-black uppercase text-lg text-base-content">💵 Cash on Delivery / Bank Transfer</span>
                                <span class="text-xs font-bold text-base-content/70 mt-1">Pay with bank transfer or complete manual COD when delivery arrives.</span>
                            </div>
                        </label>

                        <!-- Stripe -->
                        <label class="border-4 border-neutral p-5 cursor-pointer select-none transition-all shadow-[4px_4px_0_0_rgba(0,0,0,1)] flex items-center gap-4"
                               :class="paymentMethod === 'stripe' ? 'bg-accent/15 border-accent shadow-[2px_2px_0_0_rgba(0,0,0,1)] translate-y-[2px] translate-x-[2px]' : 'bg-base-100'">
                            <input type="radio" name="payment_method" value="stripe" x-model="paymentMethod" class="radio radio-primary border-4 border-neutral" />
                            <div class="flex flex-col">
                                <span class="font-black uppercase text-lg text-base-content">💳 Credit Card (via Stripe)</span>
                                <span class="text-xs font-bold text-base-content/70 mt-1">Pay instantly and securely using credit or debit cards.</span>
                            </div>
                        </label>

                        <!-- PayPal -->
                        <label class="border-4 border-neutral p-5 cursor-pointer select-none transition-all shadow-[4px_4px_0_0_rgba(0,0,0,1)] flex items-center gap-4"
                               :class="paymentMethod === 'paypal' ? 'bg-accent/15 border-accent shadow-[2px_2px_0_0_rgba(0,0,0,1)] translate-y-[2px] translate-x-[2px]' : 'bg-base-100'">
                            <input type="radio" name="payment_method" value="paypal" x-model="paymentMethod" class="radio radio-primary border-4 border-neutral" />
                            <div class="flex flex-col">
                                <span class="font-black uppercase text-lg text-base-content">🌐 PayPal Express</span>
                                <span class="text-xs font-bold text-base-content/70 mt-1">Redirect to pay easily with your PayPal account balance or cards.</span>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- 3. Order Notes -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] flex flex-col gap-6">
                    <h3 class="text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4 flex items-center gap-3">
                        <span class="bg-primary text-primary-content border-2 border-neutral rounded-full w-8 h-8 flex items-center justify-center text-sm font-black">3</span>
                        Additional Notes (Optional)
                    </h3>
                    <div class="flex flex-col gap-2">
                        <label for="notes" class="font-black uppercase text-sm text-base-content/70">Delivery or packaging instructions</label>
                        <textarea id="notes" name="notes" placeholder="e.g. Leave package on the front porch or draw a smiley face on the envelope..." rows="3"
                                  class="textarea border-4 border-neutral focus:outline-none focus:border-primary font-bold text-md rounded-none shadow-[2px_2px_0_0_rgba(0,0,0,1)]"></textarea>
                    </div>
                </div>

            </div>

            <!-- Right: Checkout Order Summary Sidebar (1/3 width) -->
            <div class="bg-base-100 border-4 border-neutral p-6 lg:p-8 shadow-[8px_8px_0_0_rgba(0,0,0,1)] sticky top-24 flex flex-col gap-6">
                <h3 class="text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4">
                    Your Items
                </h3>

                <!-- Cart Items scroll list -->
                <div class="flex flex-col gap-4 max-h-72 overflow-y-auto pr-2 border-b-2 border-neutral/10 pb-4">
                    <% data.cartItems.forEach(item => { %>
                        <div class="flex items-center gap-4 bg-base-200 border-2 border-neutral p-3 shadow-[2px_2px_0_0_rgba(0,0,0,1)]">
                            <div class="w-12 h-14 border-2 border-neutral flex-shrink-0 bg-base-100 overflow-hidden">
                                <img src="<%= item.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-grow min-w-0">
                                <h4 class="font-black text-sm uppercase text-base-content truncate">
                                    <%= item.productName %>
                                </h4>
                                <%
                                    let variantLabel = item.sku;
                                    if (item.attributes && typeof item.attributes === 'object') {
                                        const keys = Object.keys(item.attributes);
                                        if (keys.length > 0) {
                                            variantLabel = keys.map(k => `${item.attributes[k]}`).join(', ');
                                        }
                                    }
                                %>
                                <div class="flex justify-between items-center mt-1">
                                    <span class="text-xs font-bold text-base-content/60">
                                        Qty: <%= item.quantity %> • <%= variantLabel %>
                                    </span>
                                    <span class="text-sm font-black text-base-content">
                                        $<%= item.total.toFixed(2) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Price breakdown -->
                <div class="flex flex-col gap-3 text-md font-bold text-base-content/80 border-b-2 border-neutral/10 pb-4">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span>$<%= data.totalPrice.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between">
                        <span>Shipping</span>
                        <span><%= data.shippingCost === 0 ? 'FREE' : '$' + data.shippingCost.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-base-content">
                        <span>Estimated Tax</span>
                        <span>$0.00</span>
                    </div>
                </div>

                <!-- Highlighted Total Card -->
                <div class="bg-primary text-primary-content border-4 border-neutral p-6 shadow-[6px_6px_0_0_rgba(0,0,0,1)] transform rotate-1 flex flex-col items-center">
                    <span class="text-sm font-black uppercase tracking-wider mb-1">Grand Total</span>
                    <span class="text-5xl font-black">
                        $<%= data.finalTotal.toFixed(2) %>
                    </span>
                </div>

                <!-- Complete Order Button -->
                <div class="flex flex-col gap-4 mt-2">
                    <button type="submit" class="w-full bg-accent text-accent-content border-4 border-neutral font-black text-2xl uppercase py-4 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all flex items-center justify-center gap-3">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                        </svg>
                        Complete Order
                    </button>
                    <p class="text-xs text-center font-bold text-base-content/60 leading-tight">
                        By placing your order, you agree to receive hilarious puns in your shipping boxes.
                    </p>
                </div>
            </div>

        </form>
    </div>
</div>
