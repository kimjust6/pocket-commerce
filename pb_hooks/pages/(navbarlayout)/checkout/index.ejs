<div class="min-h-screen bg-base-100 py-12">
    <div class="container mx-auto max-w-7xl px-4 md:px-8">
        
        <!-- DaisyUI Breadcrumbs -->
        <div class="breadcrumbs text-xs mb-4">
            <ul>
                <li><a href="/" class="hover:text-primary">Home</a></li>
                <li><a href="/cart" class="hover:text-primary">Cart</a></li>
                <li class="font-bold text-base-content">Checkout</li>
            </ul>
        </div>

        <!-- DaisyUI Steps Bar -->
        <div class="flex justify-center mb-8">
            <ul class="steps steps-horizontal w-full max-w-xl text-xs font-bold">
                <li class="step step-primary">Cart</li>
                <li class="step step-primary">Shipping</li>
                <li class="step step-primary">Payment</li>
                <li class="step">Confirmation</li>
            </ul>
        </div>

        <!-- Header -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8 pb-6 border-b border-slate-200 dark:border-slate-800">
            <div>
                <h1 class="text-3xl md:text-4xl font-extrabold text-base-content tracking-tight">
                    Checkout
                </h1>
                <p class="text-sm text-base-content/60 mt-1">
                    Complete your shipping address and select payment options.
                </p>
            </div>
            <a href="/cart" class="btn btn-outline btn-sm rounded-xl font-semibold border-slate-300 dark:border-slate-700">
                ← Return to Cart
            </a>
        </div>

        <% if (data.error) { %>
            <div class="alert alert-error text-sm font-semibold rounded-2xl mb-8 shadow-sm">
                <span>Error: <%= data.error %></span>
            </div>
        <% } %>

        <form action="/checkout" method="POST" class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            
            <!-- Left: Checkout Sections (2/3 width) -->
            <div class="lg:col-span-2 space-y-6">
                
                <!-- 1. Shipping Information (DaisyUI Card) -->
                <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-sm space-y-6"
                     x-data="{ selectedAddress: '<%= data.addresses.find(a => a.is_default)?.id || (data.addresses[0]?.id || 'new') %>' }">
                    
                    <h2 class="card-title text-xl font-bold text-base-content flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                        <span class="badge badge-primary font-bold">1</span>
                        Shipping Information
                    </h2>

                    <!-- Saved Addresses selection -->
                    <% if (data.addresses && data.addresses.length > 0) { %>
                        <div class="space-y-3">
                            <span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Choose a Saved Shipping Address:</span>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <% data.addresses.forEach(addr => { %>
                                    <label class="border rounded-2xl p-4 cursor-pointer transition-all flex flex-col gap-2"
                                           :class="selectedAddress === '<%= addr.id %>' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300'">
                                        <div class="flex items-center gap-2">
                                            <input type="radio" name="address_id" value="<%= addr.id %>" x-model="selectedAddress" class="radio radio-xs radio-primary" />
                                            <span class="font-bold text-xs text-base-content">
                                                <%= addr.is_default ? 'Default Address' : 'Saved Address' %>
                                            </span>
                                        </div>
                                        <p class="text-xs text-base-content/80 pl-6 leading-relaxed">
                                            <%= addr.street %><br>
                                            <%= addr.city %>, <%= addr.state %> <%= addr.zip %><br>
                                            <%= addr.country %>
                                        </p>
                                    </label>
                                <% }); %>

                                <label class="border rounded-2xl p-4 cursor-pointer transition-all flex flex-col gap-2"
                                       :class="selectedAddress === 'new' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300'">
                                    <div class="flex items-center gap-2">
                                        <input type="radio" name="address_id" value="new" x-model="selectedAddress" class="radio radio-xs radio-primary" />
                                        <span class="font-bold text-xs text-base-content">
                                            New Address
                                        </span>
                                    </div>
                                    <p class="text-xs text-base-content/50 pl-6">
                                        Enter a different shipping address manually.
                                    </p>
                                </label>
                            </div>
                        </div>
                    <% } else { %>
                        <input type="hidden" name="address_id" value="new" />
                    <% } %>

                    <!-- Manual Address Inputs -->
                    <div x-show="selectedAddress === 'new'" class="space-y-4 pt-2" x-transition>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-1">
                                <label for="name" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Full Name</label>
                                <input type="text" id="name" name="name" placeholder="John Doe" value="<%= data.user?.name || '' %>"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"
                                       :required="selectedAddress === 'new'" />
                            </div>

                            <div class="space-y-1">
                                <label for="email" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Email Address</label>
                                <input type="email" id="email" name="email" placeholder="john@example.com" value="<%= data.user?.email || '' %>"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"
                                       :required="selectedAddress === 'new'" />
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label for="street" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Street Address</label>
                            <input type="text" id="street" name="street" placeholder="123 Commerce Way, Suite 100"
                                   class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"
                                   :required="selectedAddress === 'new'" />
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <div class="space-y-1">
                                <label for="city" class="text-xs font-bold uppercase tracking-wider text-base-content/70">City</label>
                                <input type="text" id="city" name="city" placeholder="Toronto"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"
                                       :required="selectedAddress === 'new'" />
                            </div>

                            <div class="space-y-1">
                                <label for="state" class="text-xs font-bold uppercase tracking-wider text-base-content/70">State / Province</label>
                                <input type="text" id="state" name="state" placeholder="ON"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                            </div>

                            <div class="space-y-1">
                                <label for="zip" class="text-xs font-bold uppercase tracking-wider text-base-content/70">ZIP / Postal Code</label>
                                <input type="text" id="zip" name="zip" placeholder="M5V 2T6"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                            </div>
                        </div>

                        <div class="space-y-1">
                            <label for="country" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Country</label>
                            <input type="text" id="country" name="country" placeholder="Canada"
                                   class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"
                                   :required="selectedAddress === 'new'" />
                        </div>

                        <% if (data.user) { %>
                            <div class="flex items-center gap-2 pt-2">
                                <input type="checkbox" id="save_address" name="save_address" value="true" class="checkbox checkbox-xs checkbox-primary rounded" />
                                <label for="save_address" class="text-xs font-semibold text-base-content/80 cursor-pointer">
                                    Save this address for future purchases
                                </label>
                            </div>
                        <% } %>
                    </div>

                    <!-- Saved address recipient info -->
                    <div x-show="selectedAddress !== 'new'" class="space-y-4 pt-2" x-transition>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="space-y-1">
                                <label for="saved_name" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Recipient Name</label>
                                <input type="text" id="saved_name" name="name" value="<%= data.user?.name || '' %>"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                            </div>
                            <div class="space-y-1">
                                <label for="saved_email" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Order Confirmation Email</label>
                                <input type="email" id="saved_email" name="email" value="<%= data.user?.email || '' %>"
                                       class="input input-sm input-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Payment Options (DaisyUI Card) -->
                <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-sm space-y-6"
                     x-data="{ paymentMethod: 'manual' }">
                    
                    <h2 class="card-title text-xl font-bold text-base-content flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                        <span class="badge badge-primary font-bold">2</span>
                        Payment Options
                    </h2>

                    <div class="space-y-3">
                        <label class="border rounded-2xl p-4 cursor-pointer transition-all flex items-start gap-3"
                               :class="paymentMethod === 'manual' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300'">
                            <input type="radio" name="payment_method" value="manual" x-model="paymentMethod" class="radio radio-xs radio-primary mt-1" checked />
                            <div class="space-y-0.5">
                                <span class="font-bold text-sm text-base-content">Cash on Delivery / Bank Transfer</span>
                                <p class="text-xs text-base-content/60">Pay easily upon delivery or complete a direct bank transfer after checkout.</p>
                            </div>
                        </label>

                        <label class="border rounded-2xl p-4 cursor-pointer transition-all flex items-start gap-3"
                               :class="paymentMethod === 'stripe' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300'">
                            <input type="radio" name="payment_method" value="stripe" x-model="paymentMethod" class="radio radio-xs radio-primary mt-1" />
                            <div class="space-y-0.5">
                                <span class="font-bold text-sm text-base-content">Credit / Debit Card (Stripe)</span>
                                <p class="text-xs text-base-content/60">Pay instantly with Visa, MasterCard, or American Express.</p>
                            </div>
                        </label>

                        <label class="border rounded-2xl p-4 cursor-pointer transition-all flex items-start gap-3"
                               :class="paymentMethod === 'banano' ? 'border-primary bg-primary/5 ring-1 ring-primary/20' : 'border-slate-200 dark:border-slate-800 hover:border-slate-300'">
                            <input type="radio" name="payment_method" value="banano" x-model="paymentMethod" class="radio radio-xs radio-primary mt-1" />
                            <div class="space-y-0.5">
                                <span class="font-bold text-sm text-base-content">Banano Cryptocurrency</span>
                                <p class="text-xs text-base-content/60">Instant fee-less crypto checkout using Banano.</p>
                            </div>
                        </label>
                    </div>
                </div>

                <!-- 3. Notes -->
                <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 md:p-8 shadow-sm space-y-4">
                    <h2 class="card-title text-xl font-bold text-base-content flex items-center gap-3 pb-3 border-b border-slate-100 dark:border-slate-800">
                        <span class="badge badge-primary font-bold">3</span>
                        Order Notes (Optional)
                    </h2>
                    <div class="space-y-1">
                        <label for="notes" class="text-xs font-bold uppercase tracking-wider text-base-content/70">Delivery Instructions</label>
                        <textarea id="notes" name="notes" placeholder="Special delivery instructions or card note request..." rows="2"
                                  class="textarea textarea-bordered w-full rounded-xl bg-base-100 text-sm font-medium focus:ring-1 focus:ring-primary"></textarea>
                    </div>
                </div>

            </div>

            <!-- Right: Order Summary Sidebar (1/3 width) -->
            <div class="card bg-base-100 border border-slate-200/80 dark:border-slate-800 rounded-3xl p-6 shadow-sm sticky top-24 space-y-6">
                <h3 class="card-title text-xl font-bold text-base-content pb-3 border-b border-slate-100 dark:border-slate-800">
                    Order Items
                </h3>

                <!-- Cart Items scroll list -->
                <div class="space-y-3 max-h-72 overflow-y-auto pr-1">
                    <% data.cartItems.forEach(item => { %>
                        <div class="flex items-center gap-3 p-2 bg-base-200/40 rounded-xl">
                            <div class="w-12 h-12 rounded-lg border border-slate-200 dark:border-slate-800 bg-base-100 overflow-hidden flex-shrink-0">
                                <img src="<%= item.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                            </div>
                            <div class="flex-1 min-w-0">
                                <h4 class="font-semibold text-xs text-base-content truncate">
                                    <%= item.productName %>
                                </h4>
                                <div class="flex justify-between items-center text-xs text-base-content/60 mt-0.5">
                                    <span>Qty: <%= item.quantity %></span>
                                    <span class="font-bold text-base-content">$<%= item.total.toFixed(2) %></span>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

                <!-- Price breakdown -->
                <div class="space-y-2 text-sm font-medium pt-3 border-t border-slate-100 dark:border-slate-800">
                    <div class="flex justify-between text-base-content/80">
                        <span>Subtotal</span>
                        <span class="font-bold text-base-content">$<%= data.totalPrice.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-base-content/80">
                        <span>Shipping</span>
                        <span class="font-bold text-base-content"><%= data.shippingCost === 0 ? 'FREE' : '$' + data.shippingCost.toFixed(2) %></span>
                    </div>
                    <div class="divider my-1"></div>
                    <div class="flex justify-between text-base font-extrabold text-base-content">
                        <span>Total Due</span>
                        <span class="text-xl text-primary">$<%= data.finalTotal.toFixed(2) %></span>
                    </div>
                </div>

                <!-- Complete Order Button -->
                <div class="card-actions flex-col gap-2 pt-2">
                    <button type="submit" class="btn btn-primary btn-lg rounded-xl shadow-md w-full font-bold">
                        Place Order ($<%= data.finalTotal.toFixed(2) %>)
                    </button>
                    <p class="text-[11px] text-center font-medium text-base-content/50">
                        256-Bit SSL Encrypted Checkout
                    </p>
                </div>
            </div>

        </form>
    </div>
</div>
