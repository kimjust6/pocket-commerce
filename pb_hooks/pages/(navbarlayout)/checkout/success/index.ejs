<div class="min-h-screen border-b-8 border-neutral bg-base-200 py-12 lg:py-24">
    <div class="container mx-auto max-w-4xl px-4">
        
        <!-- Celebration Hero Banner -->
        <div class="bg-primary text-primary-content border-4 border-neutral p-8 md:p-12 shadow-[8px_8px_0_0_rgba(0,0,0,1)] text-center transform -rotate-1 mb-12 relative overflow-hidden">
            <!-- Confetti/Micro-decorations -->
            <div class="absolute -top-4 -left-4 w-12 h-12 bg-accent border-2 border-neutral rounded-full animate-bounce"></div>
            <div class="absolute -bottom-4 -right-4 w-16 h-16 bg-secondary border-2 border-neutral transform rotate-45"></div>
            
            <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter mb-4 animate-pulse">
                Order Confirmed!
            </h1>
            <p class="text-xl md:text-2xl font-black uppercase tracking-tight text-primary-content/95 max-w-xl mx-auto leading-tight">
                Your purchase was successful! Get ready for your high-quality card order and some hilarious jokes.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
            <!-- Left 2 columns: Order Summary and Info -->
            <div class="md:col-span-2 flex flex-col gap-8">
                
                <!-- 1. Order Summary Details -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[6px_6px_0_0_rgba(0,0,0,1)] flex flex-col gap-6">
                    <h3 class="text-2xl md:text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4 flex items-center gap-3">
                        Order Details
                    </h3>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-md font-bold text-base-content/85">
                        <div class="flex flex-col gap-1 border-b-2 sm:border-b-0 sm:border-r-2 border-neutral/10 pb-3 sm:pb-0 sm:pr-4">
                            <span class="text-xs uppercase font-black text-base-content/50">Order Reference</span>
                            <span class="font-black text-lg select-all text-primary">#<%= data.order.id %></span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-xs uppercase font-black text-base-content/50">Date Placed</span>
                            <span class="text-lg">
                                <% 
                                    let displayDate = "-";
                                    try {
                                        if (data.order.created) {
                                            displayDate = new Date(data.order.created.replace(' ', 'T')).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
                                        }
                                    } catch (_) {}
                                %>
                                <%= displayDate %>
                            </span>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-md font-bold text-base-content/85 mt-2">
                        <div class="flex flex-col gap-1 border-b-2 sm:border-b-0 sm:border-r-2 border-neutral/10 pb-3 sm:pb-0 sm:pr-4">
                            <span class="text-xs uppercase font-black text-base-content/50">Status</span>
                            <span class="badge badge-accent border-2 border-neutral font-black uppercase py-3 shadow-[1px_1px_0_0_rgba(0,0,0,1)] text-xs mt-1 w-max">
                                <%= data.order.status %>
                            </span>
                        </div>
                        <div class="flex flex-col gap-1">
                            <span class="text-xs uppercase font-black text-base-content/50">Updates Sent To</span>
                            <span class="text-lg truncate"><%= data.order.shippingAddress.email || 'N/A' %></span>
                        </div>
                    </div>
                </div>

                <!-- 2. Shipping & Delivery Address -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[6px_6px_0_0_rgba(0,0,0,1)] flex flex-col gap-4">
                    <h3 class="text-2xl md:text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4">
                        Shipping Info
                    </h3>
                    
                    <div class="text-lg font-bold text-base-content/90 leading-relaxed">
                        <p class="font-black text-xl uppercase mb-1 text-base-content">
                            <%= data.order.shippingAddress.name %>
                        </p>
                        <p><%= data.order.shippingAddress.street %></p>
                        <p><%= data.order.shippingAddress.city %>, <%= data.order.shippingAddress.state %> <%= data.order.shippingAddress.zip %></p>
                        <p class="uppercase font-black text-sm text-base-content/70 mt-1"><%= data.order.shippingAddress.country %></p>
                    </div>

                    <% if (data.order.notes) { %>
                        <div class="bg-accent/10 border-4 border-neutral p-4 shadow-[3px_3px_0_0_rgba(0,0,0,1)] mt-3">
                            <span class="text-xs font-black uppercase text-base-content/70">Special Instructions:</span>
                            <p class="font-bold text-md text-base-content/90 mt-1 italic">
                                "<%= data.order.notes %>"
                            </p>
                        </div>
                    <% } %>
                </div>

                <!-- 3. Line Items Recap -->
                <div class="bg-base-100 border-4 border-neutral p-6 md:p-8 shadow-[6px_6px_0_0_rgba(0,0,0,1)] flex flex-col gap-4">
                    <h3 class="text-2xl md:text-3xl font-black uppercase text-base-content border-b-4 border-neutral pb-4">
                        Items Purchased
                    </h3>

                    <div class="flex flex-col gap-4">
                        <% data.orderItems.forEach(item => { %>
                            <div class="flex items-center gap-4 bg-base-200 border-2 border-neutral p-4 shadow-[3px_3px_0_0_rgba(0,0,0,1)]">
                                <div class="w-14 h-16 border-2 border-neutral flex-shrink-0 bg-base-100 overflow-hidden">
                                    <img src="<%= item.image %>" alt="<%= item.productName %>" class="w-full h-full object-cover">
                                </div>
                                <div class="flex-grow min-w-0">
                                    <h4 class="font-black text-md uppercase text-base-content truncate">
                                        <%= item.productName %>
                                    </h4>
                                    <div class="flex justify-between items-center mt-1">
                                        <span class="text-xs font-bold text-base-content/70">
                                            Qty: <%= item.quantity %> • <%= item.variantLabel %>
                                        </span>
                                        <span class="text-md font-black text-base-content">
                                            $<%= item.totalPrice.toFixed(2) %>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                </div>

            </div>

            <!-- Right 1 column: Billing Summary and Actions -->
            <div class="flex flex-col gap-8">
                
                <!-- Billing Summary Box -->
                <div class="bg-base-100 border-4 border-neutral p-6 shadow-[6px_6px_0_0_rgba(0,0,0,1)] flex flex-col gap-4">
                    <h3 class="text-2xl font-black uppercase text-base-content border-b-4 border-neutral pb-4">
                        Receipt
                    </h3>

                    <div class="flex flex-col gap-3 text-sm font-bold text-base-content/80 border-b-2 border-neutral/10 pb-4">
                        <div class="flex justify-between">
                            <span>Subtotal</span>
                            <span>$<%= data.order.subtotal.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Shipping</span>
                            <span><%= data.order.shippingCost === 0 ? 'FREE' : '$' + data.order.shippingCost.toFixed(2) %></span>
                        </div>
                        <div class="flex justify-between">
                            <span>Tax</span>
                            <span>$0.00</span>
                        </div>
                    </div>

                    <div class="bg-secondary text-secondary-content border-4 border-neutral p-4 shadow-[4px_4px_0_0_rgba(0,0,0,1)] transform rotate-1 flex flex-col items-center">
                        <span class="text-xs font-black uppercase tracking-wider mb-1">Total Paid</span>
                        <span class="text-3xl font-black">
                            $<%= data.order.total.toFixed(2) %>
                        </span>
                    </div>
                </div>

                <!-- Navigation Action Buttons -->
                <div class="flex flex-col gap-4">
                    <a href="/shop" class="w-full bg-accent text-accent-content border-4 border-neutral font-black text-lg uppercase py-4 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all text-center flex items-center justify-center gap-2">
                        Continue Shopping
                    </a>

                    <a href="/account" class="w-full bg-base-100 text-base-content border-4 border-neutral font-black text-lg uppercase py-4 shadow-[4px_4px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[2px_2px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all text-center flex items-center justify-center gap-2">
                        View Your Account
                    </a>
                </div>

            </div>
        </div>

    </div>
</div>
