<%
    const footerColumns = [
        {
            title: "Catalog",
            links: [
                { href: "/shop", label: "All Products" },
                { href: "/shop?category=birthday", label: "Birthday Cards" },
                { href: "/shop?category=thank-you", label: "Thank You Notes" },
                { href: "/shop?category=anniversary", label: "Anniversary" },
                { href: "/shop?on_sale=1", label: "Special Deals", extraClass: "text-amber-400 font-medium" }
            ]
        },
        {
            title: "Customer Support",
            links: [
                { href: "/account", label: "Order History" },
                { href: "/account/addresses", label: "Saved Addresses" },
                { href: "/profile", label: "Account Settings" },
                { href: "/cart", label: "Shopping Cart" },
                { href: "/banano", label: "Banano Payments" }
            ]
        },
        {
            title: "Resources & Info",
            links: [
                { href: "/banano", label: "Banano Payments" },
                { href: "#", label: "Shipping & Returns" },
                { href: "#", label: "Privacy Policy" },
                { href: "#", label: "Terms of Service" }
            ]
        }
    ];

    const bottomLinks = [
        { href: "#", label: "Privacy Policy" },
        { href: "#", label: "Terms of Service" },
        { href: "#", label: "Shipping Info" }
    ];
%>

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800 pt-16 pb-12">
    <div class="container mx-auto px-4 md:px-8 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-slate-800">
            <!-- Brand Column -->
            <div class="lg:col-span-2 space-y-4">
                <div class="flex items-center gap-2.5">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 via-violet-600 to-pink-500 text-white flex items-center justify-center font-bold shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                    </div>
                    <span class="text-xl font-extrabold tracking-tight text-white">
                        Pocket <span class="bg-gradient-to-r from-indigo-400 via-violet-300 to-pink-400 bg-clip-text text-transparent">Commerce</span>
                    </span>
                </div>
                <p class="text-sm text-slate-400 max-w-sm leading-relaxed">
                    Premium quality greeting cards, gifts, and stationery delivered with speed and care for all your special occasions.
                </p>
                <!-- Newsletter Signup -->
                <div class="pt-2" x-data="{ subscribed: false, email: '' }">
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Subscribe to newsletter</p>
                    <template x-if="!subscribed">
                        <form @submit.prevent="if(email) subscribed = true" class="flex gap-2 max-w-sm">
                            <input type="email" x-model="email" placeholder="Enter your email address" required class="input input-sm bg-slate-800 border-slate-700 text-slate-100 placeholder-slate-500 rounded-lg flex-1 text-xs focus:ring-1 focus:ring-primary focus:border-primary">
                            <button type="submit" class="btn btn-primary btn-sm rounded-lg text-xs font-semibold px-4">Subscribe</button>
                        </form>
                    </template>
                    <template x-if="subscribed">
                        <div class="flex items-center gap-2 text-xs text-emerald-400 bg-emerald-950/40 border border-emerald-800/60 rounded-lg p-2.5 max-w-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Subscribed! Check your inbox for updates.</span>
                        </div>
                    </template>
                </div>
            </div>

            <!-- Dynamic Footer Columns -->
            <% footerColumns.forEach(column => { %>
                <div class="space-y-3">
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-white"><%= column.title %></h4>
                    <ul class="space-y-2 text-sm text-slate-400">
                        <% column.links.forEach(link => { %>
                            <li>
                                <a href="<%= link.href %>" class="hover:text-white transition-colors <%= link.extraClass || '' %>">
                                    <%= link.label %>
                                </a>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% }); %>
        </div>

        <!-- Bottom Row -->
        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
            <p>&copy; <span x-text="new Date().getFullYear()"></span> Pocket Commerce. All rights reserved.</p>
            <div class="flex items-center gap-6">
                <% bottomLinks.forEach(link => { %>
                    <a href="<%= link.href %>" class="hover:text-slate-300 transition-colors">
                        <%= link.label %>
                    </a>
                <% }); %>
            </div>
        </div>
    </div>
</footer>