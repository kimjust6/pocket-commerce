<!-- Amazon EWC-Style Persistent Sidebar Cart Rail -->
<aside x-cloak 
       x-show="!isCartPage && (cartCount > 0 || cartItems.length > 0) && sideCartOpen" 
       id="nav-flyout-ewc" 
       class="fixed top-0 right-0 h-screen w-56 sm:w-60 lg:w-64 xl:w-72 bg-base-100 border-l border-slate-200 dark:border-slate-800 shadow-lg flex flex-col z-30 transition-transform duration-200 ewc-compact sc-java-remote-feature"
       aria-label="Persistent Shopping Cart Sidebar">

    <!-- Top Subtotal & Actions Section (ewc-compact-head) -->
    <div class="p-4 border-b border-slate-200 dark:border-slate-800 bg-base-100 text-center space-y-2.5 flex-shrink-0 ewc-compact-head">
        <div class="flex items-center justify-between lg:hidden mb-1">
            <span class="text-xs font-bold uppercase tracking-wider text-base-content/60">Your Cart</span>
            <button type="button" @click="closeSideCart()" class="btn btn-ghost btn-xs btn-circle text-base-content/60 hover:text-base-content" aria-label="Close cart sidebar">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <div class="ewc-cart-header space-y-0.5">
            <div class="text-xs font-semibold text-base-content/70 uppercase tracking-wider ewc-subtotal-label">Subtotal</div>
            <div class="ewc-subtotal-amount">
                <span class="text-xl sm:text-2xl font-black text-rose-600 dark:text-rose-400">
                    $<span x-text="cartTotalPrice.toFixed(2)"></span>
                </span>
            </div>
        </div>

        <div id="ewc-compact-actions-container" class="space-y-2 pt-0.5">
            <a href="/cart" class="btn btn-outline btn-sm w-full rounded-xl font-bold text-xs h-9 min-h-0 bg-base-100 hover:bg-base-200 border-slate-300 dark:border-slate-700 shadow-2xs">
                Go to cart
            </a>
            <a href="/checkout" class="btn btn-primary btn-sm w-full rounded-xl font-extrabold text-xs h-9 min-h-0 uppercase tracking-wide shadow-2xs">
                Checkout
            </a>
        </div>
    </div>

    <!-- Scrollable Item List (ewc-compact-body) -->
    <div id="ewc-compact-body" class="flex-1 overflow-y-auto p-3.5 space-y-4">
        <div class="ewc-scroller">
            <ul class="space-y-4 a-unordered-list a-nostyle a-vertical" role="list">
                <template x-for="item in cartItems" :key="item.id || item.variantId">
                    <li class="flex flex-col items-center text-center space-y-2 pb-4 border-b border-slate-100 dark:border-slate-800 last:border-0 ewc-item">
                        <!-- Product Thumbnail (Larger & Crisp) -->
                        <a :href="'/shop/card/' + (item.productSlug || 'card') + '/' + (item.productId || '')" class="w-32 h-40 sm:w-36 sm:h-44 rounded-xl overflow-hidden bg-base-200/50 border border-slate-200/90 dark:border-slate-700 p-1 flex items-center justify-center relative group shadow-2xs ewc-item-image">
                            <img :src="item.image || '/card-birthday.webp'" :alt="item.productName" class="w-full h-full object-cover rounded-lg group-hover:scale-105 transition-transform duration-300">
                        </a>

                        <!-- Product Title (Bigger font & readable) -->
                        <a :href="'/shop/card/' + (item.productSlug || 'card') + '/' + (item.productId || '')" class="text-xs sm:text-sm font-extrabold text-base-content hover:text-primary transition-colors line-clamp-2 px-1 leading-snug" x-text="item.productName"></a>

                        <!-- Stock / Selling Fast Badge -->
                        <template x-if="item.stock && item.stock <= 5">
                            <span class="badge badge-error text-white font-bold text-[11px] h-5 min-h-0 px-2 rounded-sm uppercase tracking-wide">Selling fast</span>
                        </template>
                        <template x-if="!item.stock || item.stock > 5">
                            <span class="badge badge-neutral badge-outline font-semibold text-[11px] h-5 min-h-0 px-2 rounded-sm">In Cart</span>
                        </template>

                        <!-- Product Price (Bigger bold price) -->
                        <div class="text-sm sm:text-base font-black text-base-content ewc-unit-price">
                            $<span x-text="Number(item.price).toFixed(2)"></span>
                        </div>

                        <!-- Stepper Quantity Pill (Trash/Minus, Count, Plus) -->
                        <div class="flex items-center border border-slate-300 dark:border-slate-700 rounded-xl bg-base-100 shadow-2xs overflow-hidden h-9 sc-quantity-stepper">
                            <button type="button" 
                                    @click="updateCartItem(item, item.quantity - 1)" 
                                    :disabled="updatingItemId === item.id" 
                                    class="btn btn-ghost btn-xs px-3 h-full min-h-0 text-base-content/70 hover:text-error rounded-none" 
                                    :title="item.quantity <= 1 ? 'Delete item' : 'Decrease quantity'"
                                    aria-label="Decrease quantity">
                                <template x-if="item.quantity <= 1">
                                    <svg class="w-4 h-4 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </template>
                                <template x-if="item.quantity > 1">
                                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" />
                                    </svg>
                                </template>
                            </button>
                            <span class="flex items-center justify-center min-w-8 text-sm font-extrabold px-1.5 select-none" x-text="updatingItemId === item.id ? '...' : item.quantity"></span>
                            <button type="button" 
                                    @click="updateCartItem(item, item.quantity + 1)" 
                                    :disabled="updatingItemId === item.id || (item.stock && item.quantity >= item.stock)" 
                                    class="btn btn-ghost btn-xs px-3 h-full min-h-0 text-base-content/70 hover:text-primary rounded-none" 
                                    title="Increase quantity"
                                    aria-label="Increase quantity">
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                                </svg>
                            </button>
                        </div>
                    </li>
                </template>
            </ul>
        </div>
    </div>
</aside>
