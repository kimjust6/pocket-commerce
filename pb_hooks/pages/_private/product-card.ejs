<%
    const item = typeof card !== 'undefined' ? card : (typeof product !== 'undefined' ? product : {});
    const title = item.title || item.name || 'Greeting Card';
    const slug = (item.slug || title).toLowerCase().replace(/\s+/g, '-');
    const id = item.id || '';
    const variantId = item.variantId || item.defaultVariantId || '';
    const inStock = item.inStock !== false && item.price !== 'Sold Out' && item.price !== null;
    const productUrl = `/shop/card/${slug}/${id}`;
    const images = item.images && item.images.length > 0 ? item.images : (item.image ? [item.image] : []);
    const primaryImg = images[0] || '/hero-greeting-card.webp';
    const secondaryImg = images.length > 1 ? images[1] : null;
    const categoryName = item.category ? (typeof item.category === 'object' ? item.category.name : item.category) : null;
    const tag = item.tag || (item.onSale ? 'SALE' : null);
    const compareAt = item.compareAtPrice || null;
    const rating = item.rating || 5;
    const reviewsCount = item.reviewCount || null;
    
    let formattedPrice = 'Sold Out';
    if (item.price !== null && item.price !== undefined) {
        formattedPrice = typeof item.price === 'number' ? '$' + item.price.toFixed(2) : item.price;
    }
    const rawPrice = typeof item.price === 'number' ? item.price : (item.priceNum || 0);
%>

<div class="card card-compact bg-base-100 border border-base-200/90 dark:border-slate-800 shadow-xs hover:shadow-xl transition-all duration-300 hover:-translate-y-1.5 h-full group cursor-pointer flex flex-col justify-between rounded-3xl overflow-hidden" 
     x-data="{ 
         showSecond: false,
         loading: false,
         added: false,
         async addToCart(e) {
             e.preventDefault();
             e.stopPropagation();
             if (this.loading) return;
             this.loading = true;
             try {
                 const formData = new FormData();
                 formData.append('action', 'add');
                 <% if (variantId) { %>
                 formData.append('variant_id', '<%= variantId %>');
                 <% } %>
                 formData.append('product_id', '<%= id %>');
                 formData.append('quantity', '1');

                 const res = await fetch('/cart?json=1', {
                     method: 'POST',
                     headers: {
                         'Accept': 'application/json',
                         'X-Requested-With': 'XMLHttpRequest'
                     },
                     body: formData
                 });
                 let result = null;
                 try {
                     result = await res.json();
                 } catch (_) {}

                 if (result && result.success) {
                     this.added = true;
                     window.dispatchEvent(new CustomEvent('cart-updated', {
                         detail: {
                             totalItems: result.totalItems,
                             totalPrice: result.totalPrice,
                             items: result.items,
                             openSideCart: true,
                             item: {
                                 productId: '<%= id %>',
                                 productName: '<%= title.replace(/\'/g, "\\'") %>',
                                 image: '<%= primaryImg %>',
                                 price: <%= rawPrice %>,
                                 quantity: 1
                             }
                         }
                     }));
                     setTimeout(() => { this.added = false; }, 2000);
                 } else {
                     window.location.href = '<%= productUrl %>';
                 }
             } catch (err) {
                 window.location.href = '<%= productUrl %>';
             } finally {
                 this.loading = false;
             }
         }
     }" 
     @mouseenter="showSecond = true" 
     @mouseleave="showSecond = false" 
     @click="if (!$event.target.closest('a') && !$event.target.closest('button')) window.location.href = '<%= productUrl %>'">
    
    <div class="relative">
        <a href="<%= productUrl %>" class="aspect-[4/5] bg-base-200/50 relative overflow-hidden block">
            <% if (secondaryImg) { %>
                <img src="<%= primaryImg %>" alt="<%= title %>" 
                     class="w-full h-full object-cover transition-all duration-500 group-hover:scale-105 absolute inset-0"
                     :class="showSecond ? 'opacity-0 scale-95' : 'opacity-100 scale-100'">
                <img src="<%= secondaryImg %>" alt="<%= title %>" 
                     class="w-full h-full object-cover transition-all duration-500 group-hover:scale-105 absolute inset-0 opacity-0"
                     :class="showSecond ? 'opacity-100 scale-100' : 'opacity-0 scale-95'">
            <% } else { %>
                <img src="<%= primaryImg %>" alt="<%= title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
            <% } %>

            <!-- Top Left: Tag Badge (Cute Pastel Accent) -->
            <% if (tag) { %>
                <span class="absolute top-3 left-3 text-[9px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full shadow-xs z-10 <%= tag.includes('SALE') || tag.includes('OFFER') ? 'bg-accent text-white' : 'bg-primary text-white' %>">
                    <%= tag %>
                </span>
            <% } %>

            <!-- Top Right: Category Pill -->
            <% if (categoryName) { %>
                <span class="badge badge-sm bg-base-100/90 dark:bg-slate-900/90 backdrop-blur-xs text-[10px] font-bold text-base-content/80 absolute top-3 right-3 px-2.5 py-0.5 shadow-xs z-10 border border-base-200 dark:border-slate-700 rounded-full">
                    <%= categoryName %>
                </span>
            <% } %>
        </a>
    </div>

    <div class="card-body p-4 flex-1 flex flex-col justify-between space-y-2.5">
        <div class="space-y-1">
            <% if (reviewsCount) { %>
                <div class="flex items-center gap-1 text-[11px] font-bold text-amber-500">
                    <span>★ <%= rating.toFixed(1) %></span>
                    <span class="text-base-content/50 font-normal">(<%= reviewsCount %>)</span>
                </div>
            <% } %>

            <h3 class="card-title font-bold text-sm text-base-content group-hover:text-primary transition-colors line-clamp-2 leading-snug">
                <a href="<%= productUrl %>" class="hover:underline">
                    <%= title %>
                </a>
            </h3>
        </div>

        <div class="card-actions justify-between items-center pt-2.5 border-t border-base-200 dark:border-slate-800">
            <div class="flex items-baseline gap-1.5">
                <span class="text-base font-extrabold text-base-content tracking-tight"><%= formattedPrice %></span>
                <% if (compareAt) { %>
                    <span class="text-xs text-base-content/40 line-through"><%= compareAt %></span>
                <% } %>
            </div>
            <% if (inStock) { %>
                <button type="button" 
                        @click="addToCart($event)" 
                        :disabled="loading"
                        class="btn btn-xs rounded-full font-bold px-3.5 shadow-2xs transition-all duration-300 flex items-center justify-center gap-1.5 min-h-0 h-7 active:scale-95"
                        :class="added ? 'bg-emerald-500 hover:bg-emerald-600 text-white border-emerald-500 scale-105 shadow-sm' : 'btn-primary hover:scale-[1.03]'"
                        aria-label="Add <%= title %> to cart">
                    <template x-if="loading">
                        <span class="loading loading-spinner loading-xs"></span>
                    </template>
                    <template x-if="!loading && added">
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5 stroke-[2.5]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                            </svg>
                            <span>Added!</span>
                        </span>
                    </template>
                    <template x-if="!loading && !added">
                        <span class="flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            <span>Add to Cart</span>
                        </span>
                    </template>
                </button>
            <% } else { %>
                <a href="<%= productUrl %>" class="btn btn-ghost btn-xs rounded-full font-bold px-3 text-base-content/50 pointer-events-none min-h-0 h-7">
                    Sold Out
                </a>
            <% } %>
        </div>
    </div>
</div>
