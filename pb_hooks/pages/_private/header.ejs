<%- include('banner') %>

<header class="sticky top-0 z-40 border-b border-base-200/80 dark:border-slate-800 bg-base-100/90 backdrop-blur-md transition-colors">
    <div class="navbar container mx-auto px-4 md:px-8 min-h-16">
        <!-- Left: Logo & Brand -->
        <div class="navbar-start w-auto flex items-center gap-8">
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-10 h-10 rounded-2xl bg-primary text-primary-content flex items-center justify-center font-bold text-lg shadow-sm group-hover:scale-110 group-hover:rotate-6 transition-all duration-300">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                    </svg>
                </div>
                <span class="text-xl font-extrabold tracking-tight text-base-content group-hover:text-primary transition-colors">
                    Pocket <span class="text-primary font-bold">Commerce</span>
                </span>
            </a>

            <!-- Desktop Navigation Links -->
            <nav class="hidden md:flex items-center gap-4 lg:gap-5 text-sm">
                <a href="/shop" class="font-semibold text-base-content/85 hover:text-primary transition-colors">Shop All</a>
                <a href="/shop?category=birthday" class="font-medium text-base-content/75 hover:text-primary transition-colors">Birthday</a>
                <a href="/shop?category=thank-you" class="font-medium text-base-content/75 hover:text-primary transition-colors">Thank You</a>
                <a href="/shop?category=love" class="font-medium text-base-content/75 hover:text-primary transition-colors hidden xl:inline-block">Love</a>
                <a href="/shop?category=animals" class="font-medium text-base-content/75 hover:text-primary transition-colors hidden xl:inline-block">Animals</a>
                <a href="/shop?on_sale=1" class="font-bold text-accent flex items-center gap-1.5 hover:opacity-80 transition-opacity">
                    <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
                    Limited Offers
                </a>
            </nav>
        </div>

        <!-- Right: Controls & Actions -->
        <div class="navbar-end flex-1 justify-end flex items-center gap-3">
            <!-- Search Bar Input with Join & KBD -->
            <div class="hidden sm:flex items-center" x-data="{ open: false }">
                <form action="/shop" method="GET" class="join">
                    <input type="text" name="q"
                        class="input input-sm input-bordered join-item rounded-full pl-9 pr-4 w-48 lg:w-60 bg-base-200/50 focus:bg-base-100 focus:w-68 text-xs transition-all border-base-200 dark:border-slate-700"
                        placeholder="Search products...">
                    <button type="submit" class="btn btn-sm btn-ghost join-item rounded-r-full -ml-8 z-10" aria-label="Search">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Dark/Light Theme Toggle -->
            <%- include('theme-toggle') %>

            <!-- Cart Link with DaisyUI Indicator & Badge -->
            <div class="tooltip tooltip-bottom" data-tip="Cart">
                <a href="/cart" @click="if (cartCount > 0 || cartItems.length > 0) { $event.preventDefault(); toggleSideCart(); }" class="btn btn-ghost btn-circle border-0 flex items-center justify-center hover:scale-105 transition-transform" aria-label="Shopping Cart">
                    <div class="indicator">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                        </svg>
                        <span x-show="cartCount > 0" x-text="cartCount" class="badge badge-sm bg-accent text-white indicator-item font-extrabold text-[10px] rounded-full border-none shadow-xs" x-cloak>
                            <%= (locals.data && locals.data.totalItems > 0) ? locals.data.totalItems : '' %>
                        </span>
                    </div>
                </a>
            </div>

            <!-- User Auth Profile Dropdown -->
            <% if (locals.auth) { %>
                <div class="dropdown dropdown-end" x-data="{ open: false }" :class="{ 'dropdown-open': open }" @click.outside="open = false">
                    <div role="button" class="btn btn-ghost btn-circle avatar" @click="open = !open">
                        <div class="w-9 rounded-full ring ring-primary ring-offset-base-100 ring-offset-2 overflow-hidden">
                            <% if (auth.getString('avatar')) { %>
                                <img src="<%= '/api/files/' + auth.collection().id + '/' + auth.id + '/' + auth.getString('avatar') %>" alt="User Avatar" class="w-full h-full object-cover" />
                            <% } else { %>
                                <span class="text-sm font-bold flex h-full w-full items-center justify-center bg-primary text-primary-content">
                                    <%= auth.email().slice(0, 1).toUpperCase() %>
                                </span>
                            <% } %>
                        </div>
                    </div>
                    <ul tabindex="0" class="menu menu-sm dropdown-content z-[1] mt-3 w-56 p-2 shadow-xl bg-base-100 border border-base-200 dark:border-slate-800 rounded-3xl space-y-1">
                        <li class="menu-title px-3 py-1.5 text-[11px] text-base-content/60 font-semibold border-b border-base-200 dark:border-slate-800">
                            <%= auth.email() %>
                        </li>
                        <li><a href="/account" class="rounded-2xl py-2 font-semibold">Dashboard</a></li>
                        <li><a href="/profile" class="rounded-2xl py-2 font-semibold">My Profile</a></li>
                        <li><a href="/account/addresses" class="rounded-2xl py-2 font-semibold">Saved Addresses</a></li>
                        <div class="divider my-0.5"></div>
                        <li><a href="/auth/logout" class="text-error rounded-2xl py-2 font-semibold">Logout</a></li>
                    </ul>
                </div>
            <% } else { %>
                <a href="/login" class="hidden sm:inline-flex btn btn-primary btn-sm rounded-full font-bold px-5 shadow-xs hover:shadow-md transition-all">
                    Sign In
                </a>
            <% } %>

            <!-- Mobile Menu Button -->
            <button class="btn btn-ghost btn-circle md:hidden" @click="navOpen = !navOpen" aria-label="Toggle Menu">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </div>
</header>