<script server>
    const { state, code } = params
    let error = null
    try {
        const authData = signInWithOAuth2(state, code)
        redirect('/account')
    } catch (e) {
        error = e.message
        console.error('OAuth Redirect Error:', e)
    }
</script>

<% if (error) { %>
    <div class="min-h-screen border-b-8 border-neutral bg-base-200 flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden">
        <!-- Stark Linear Grid Background -->
        <div class="absolute inset-0 pointer-events-none opacity-10"
            style="background-image: linear-gradient(currentColor 1px, transparent 1px), linear-gradient(to right, currentColor 1px, transparent 1px); background-size: 40px 40px;">
        </div>

        <div class="relative z-10 bg-base-100 border-4 border-neutral p-12 text-center shadow-[8px_8px_0_0_rgba(0,0,0,1)] max-w-lg mx-auto">
            <h1 class="text-5xl font-black uppercase text-error mb-4">Auth Failed</h1>
            <p class="py-6 font-bold text-base-content/75 leading-relaxed">
                <%= error %>
            </p>
            <a href="/login" class="inline-block bg-primary text-primary-content border-4 border-neutral font-black text-xl uppercase px-8 py-4 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all">
                Try Again
            </a>
        </div>
    </div>
<% } %>