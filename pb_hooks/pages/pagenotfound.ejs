<!doctype html>
<html lang="en" data-theme="neobrutalism" x-data="shell()">

<head>
    <%- include('_private/head') %>
    <%- include('_private/theme-init') %>
    <%- include('_private/alpine-setup') %>
    <%- include('_private/shell-init') %>
    <%- include('_private/custom-styles') %>
</head>

<body class="bg-base-100 text-base-content min-h-screen">
    <div class="min-h-screen border-b-8 border-neutral bg-base-200 flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden">
        <!-- Stark Grid Background -->
        <div class="absolute inset-0 pointer-events-none opacity-10"
            style="background-image: radial-gradient(currentColor 2px, transparent 2px); background-size: 30px 30px;">
        </div>

        <div class="relative z-10 bg-base-100 border-4 border-neutral p-12 text-center shadow-[8px_8px_0_0_rgba(0,0,0,1)] max-w-lg mx-auto">
            <h1 class="text-8xl font-black uppercase text-error mb-4">404</h1>
            <h2 class="text-3xl font-black uppercase text-base-content mb-2">Page Not Found</h2>
            <p class="text-lg font-bold text-base-content/60 mb-8 leading-snug">
                Sorry, we couldn't find the page you're looking for. It might have been moved or eaten by puns.
            </p>
            <a href="/" class="inline-block bg-primary text-primary-content border-4 border-neutral font-black text-xl uppercase px-8 py-4 shadow-[6px_6px_0_0_rgba(0,0,0,1)] hover:translate-y-[2px] hover:translate-x-[2px] hover:shadow-[4px_4px_0_0_rgba(0,0,0,1)] active:translate-y-[4px] active:translate-x-[4px] active:shadow-none transition-all">
                Go Home
            </a>
        </div>
    </div>
    <%- include('_private/link-fixer') %>
</body>

</html>
