<!doctype html>
<html lang="en" data-theme="light" x-data="shell()">

<head>
    <%- include('_private/head') %>
    <%- include('_private/theme-init') %>
    <%- include('_private/alpine-setup') %>
    <%- include('_private/shell-init') %>
    <%- include('_private/custom-styles') %>
</head>

<body class="bg-base-100 text-base-content min-h-screen">
    <div class="min-h-screen bg-base-200/40 flex flex-col items-center justify-center px-6 py-24 relative overflow-hidden">
        <div class="relative z-10 bg-base-100 border border-slate-200 dark:border-slate-800 rounded-3xl p-10 md:p-14 text-center shadow-xl max-w-lg mx-auto">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-error/10 text-error mb-6">
                <span class="text-3xl font-extrabold">404</span>
            </div>
            <h1 class="text-3xl font-bold text-base-content mb-3 tracking-tight">Page Not Found</h1>
            <p class="text-base text-base-content/70 mb-8 leading-relaxed">
                Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
            </p>
            <a href="/" class="btn btn-primary btn-lg rounded-xl shadow-md hover:shadow-lg px-8 font-semibold transition-all">
                Return to Store
            </a>
        </div>
    </div>
    <%- include('_private/link-fixer') %>
</body>

</html>
