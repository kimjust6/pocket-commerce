{
    "name": "commerce",
    "private": true,
    "version": "0.1.0",
    "scripts": {
        "dev": "concurrently \"vite\" \"pocketbase serve --dir=pb_data --dev\"",
        "dev:ui": "vite",
        "dev:pb": "pocketbase serve --dir=pb_data --dev",
        "build": "vite build",
        "start": "pocketbase serve --dir=pb_data --dev",
        "push": "node scripts/patch-phio.mjs && npm run build && node ./node_modules/tsx/dist/cli.mjs ./node_modules/phio/src/cli.ts deploy",
        "postinstall": "node scripts/patch-phio.mjs",
        "login": "node ./node_modules/tsx/dist/cli.mjs ./node_modules/phio/src/cli.ts login",
        "update": "pocketbase update",
        "test": "vitest run",
        "typegen": "node scripts/typegen.mjs"
    },
    "pockethost": {
        "instanceName": "pocket-commerce"
    },
    "description": "Commerce web app.",
    "author": {
        "name": "Justin Kim",
        "github": "kimjust6"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kimjust6/pocket-commerce"
    },
    "keywords": [
        "pocketpages",
        "pocketbase",
        "commerce",
        "greeting cards",
        "cards",
        "daisyui",
        "tailwindcss"
    ],
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.16",
        "autoprefixer": "^10.6.2",
        "concurrently": "^9.2.1",
        "daisyui": "^4.12.23",
        "dotenv": "^17.2.3",
        "patch-package": "^8.0.1",
        "prettier": "^3.6.2",
        "prettier-plugin-ejs": "^1.0.3",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^3.4.17",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@bananocoin/bananojs": "^2.10.10",
        "@vitejs/plugin-vue": "^6.0.11",
        "baseline-browser-mapping": "^2.9.17",
        "caniuse-lite": "^1.0.30001765",
        "lucide-vue-next": "^1.0.0",
        "phio": "^0.4.0",
        "pinia": "^4.1.0",
        "pocketbase": "^0.26.5",
        "pocketpages": "^0.22.3",
        "pocketpages-plugin-datastar": "^0.2.0",
        "pocketpages-plugin-js-sdk": "^0.2.0",
        "vite": "^8.3.8",
        "vue": "^3.5.45",
        "vue-router": "^5.5.0"
    },
    "overrides": {
        "minimatch": "^10.0.1",
        "brace-expansion": "^5.0.8"
    },
    "files": [
        "pb_hooks",
        "*.md"
    ]
}
