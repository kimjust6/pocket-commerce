+/**
+ * SSE text parser
+ * @param {string} chunk - decoded SSE data chunk
+ * @param {Function} callback
+ * @param {Object} options
+ */
+function eventsourceParser(chunk, callback, options = {}) {
+  let message = {};
+  const {
+    instance = eventsourceParser,
+    parseJson = true
+  } = options;
+  const buffer = (instance.buffer || '') + chunk;
+  const lines = buffer.split('\n');
+  const onMessage = message => callback?.(message);
+
+  // SSE specification requires each event to be separated by a blank line (\n\n)
+  // Remove the last line: if the event is complete it is empty; if incomplete, keep for next chunk
+  instance.buffer = lines.pop();
+
+  // If no lines to process, return
+  if (lines.length === 0) {
+    return onMessage(message);
+  }
+
+  // Parse raw lines
+  lines.forEach(item => {
+    // Blank line indicates the end of a complete event
+    if (item.trim() === '') {
+      // Auto-parse JSON if configured
+      if (parseJson) {
+        try {
+          message.data = JSON.parse(message.data);
+        } catch (e) {}
+      }
+      onMessage(message); // Deliver message
+      message = {}; // Reset message state for next event
+    } else {
+      const fieldLength = item.indexOf(':');
+      const field = item.substring(0, fieldLength).trim();
+      const value = item.substring(fieldLength + 1).trim();
+
+      // Process event field
+      if (field) {
+        switch (field) {
+          case 'data':
+            message.data = value;
+            break;
+          default:
+            // id, event, retry
+            message[field] = /^\d+$/.test(value) ? parseInt(value, 10) : value;
+        }
+      }
+    }
+  });
+}
+
+class FetchEventSource {
+  constructor() {
+    this.controller = new AbortController();
+  }
+
+  /**
+   * Initiate request
+   * @param {string} url
+   * @param {Object} options
+   */
+  async fetch(url, options = {}) {
+    const {
+      headers,
+      signal = this.controller.signal,
+      parseJson = true
+    } = options;
+
+    // Default headers
+    options.headers = {
+      "Content-Type": "application/json",
+      "Accept": "text/event-stream",
+      ...headers
+    };
+    try {
+      const response = await fetch(url, {
+        signal,
+        ...options
+      });
+      await options.onopen?.(response);
+
+      // Handle HTTP error response
+      if (!response.ok) {
+        const contentType = response.headers.get('content-type');
+        const ACCEPT = options.headers['Accept'];
+        if (!String(contentType).startsWith(ACCEPT)) {
+          console.error(`Expected content-type to be ${ACCEPT}, Actual: ${contentType}`);
+        }
+        throw new Error(`HTTP ${response.status}`);
+      }
+
+      // Read response stream
+      const reader = response.body.getReader();
+      const decoder = new TextDecoder();
+      async function readStream() {
+        const {
+          done,
+          value
+        } = await reader.read();
+
+        // DONE
+        if (done) return options.done?.(response);
+        const chunk = decoder.decode(value); // Decode Uint8Array
+        eventsourceParser(chunk, options.onmessage, {
+          instance: this,
+          parseJson
+        }); // Parse SSE data format
+
+        await readStream();
+      }
+      await readStream();
+    } catch (error) {
+      this.abort();
+      delete this.buffer;
+      options.onerror?.(error);
+    }
+  }
+
+  // Abort active request
+  abort() {
+    this.controller.abort();
+  }
+}
+
+// Factory function
+async function fetchEventSource(...args) {
+  const eventSource = new FetchEventSource();
+  await eventSource.fetch(...args);
+  return eventSource;
+}
+
+export { eventsourceParser, fetchEventSource };
